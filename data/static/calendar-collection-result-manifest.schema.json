{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whr.badjoke-lab.com/schemas/calendar-collection-result-manifest.schema.json",
  "title": "Where Horses Run Calendar collection result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "job_id",
    "batch_id",
    "system_id",
    "runner_used",
    "requested_scope",
    "observed_scope",
    "coverage_claim",
    "records_discovered",
    "records_updated",
    "rank_counts",
    "unresolved_dates",
    "unresolved_meeting_ids",
    "source_errors",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": "calendar-collection-result-manifest-v1" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "batch_id": { "$ref": "#/$defs/id" },
    "system_id": { "$ref": "#/$defs/id" },
    "runner_used": { "enum": ["github_actions", "local", "reviewed_import"] },
    "requested_scope": { "$ref": "#/$defs/requestedScope" },
    "observed_scope": { "$ref": "#/$defs/observedScope" },
    "coverage_claim": { "enum": ["none", "partial", "source_window_complete", "audited_complete"] },
    "records_discovered": { "type": "integer", "minimum": 0 },
    "records_updated": { "type": "integer", "minimum": 0 },
    "rank_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "B", "B+", "A", "A+"],
      "properties": {
        "C": { "type": "integer", "minimum": 0 },
        "B": { "type": "integer", "minimum": 0 },
        "B+": { "type": "integer", "minimum": 0 },
        "A": { "type": "integer", "minimum": 0 },
        "A+": { "type": "integer", "minimum": 0 }
      }
    },
    "unresolved_dates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/date" }
    },
    "unresolved_meeting_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "source_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceError" }
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "coverage_observation_ref", "collection_report_ref"],
      "properties": {
        "candidate_ref": { "oneOf": [{ "$ref": "#/$defs/repoRef" }, { "type": "null" }] },
        "coverage_observation_ref": { "$ref": "#/$defs/repoRef" },
        "collection_report_ref": { "oneOf": [{ "$ref": "#/$defs/repoRef" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repoRef": {
      "type": "string",
      "pattern": "^(?:data|docs)/[A-Za-z0-9_./+-]+$"
    },
    "requestedScope": {
      "oneOf": [
        { "$ref": "#/$defs/requestedDateWindow" },
        { "$ref": "#/$defs/requestedSingleDate" },
        { "$ref": "#/$defs/requestedSelectedMeetings" }
      ]
    },
    "requestedDateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date_exclusive", "timezone"],
      "properties": {
        "start_date": { "$ref": "#/$defs/date" },
        "end_date_exclusive": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "requestedSingleDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "timezone"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "requestedSelectedMeetings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_ids"],
      "properties": {
        "meeting_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "observedScope": {
      "oneOf": [
        { "$ref": "#/$defs/observedDateWindow" },
        { "$ref": "#/$defs/observedSingleDate" },
        { "$ref": "#/$defs/observedSelectedMeetings" },
        { "$ref": "#/$defs/observedSourceVisibleHorizon" },
        { "$ref": "#/$defs/notObserved" }
      ]
    },
    "observedDateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_date", "end_date_exclusive", "timezone"],
      "properties": {
        "kind": { "const": "date_window" },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date_exclusive": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "observedSingleDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "date", "timezone"],
      "properties": {
        "kind": { "const": "single_date" },
        "date": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "observedSelectedMeetings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "meeting_ids", "timezone"],
      "properties": {
        "kind": { "const": "selected_meetings" },
        "meeting_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "observedSourceVisibleHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_date", "end_date_exclusive", "timezone"],
      "properties": {
        "kind": { "const": "source_visible_horizon" },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date_exclusive": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "notObserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timezone"],
      "properties": {
        "kind": { "const": "not_observed" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "sourceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope_ref", "message"],
      "properties": {
        "code": { "enum": ["source_unavailable", "parser_failure", "rate_limited", "unexpected_response", "other"] },
        "scope_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
