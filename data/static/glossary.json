[{"schema_version":"glossary-entry-v2","id":"thoroughbred-racing","slug":"thoroughbred-racing","term_en":"Thoroughbred flat racing","term_ja":"サラブレッド平地競馬","category":"race_type","summary_en":"Flat racing restricted to or principally contested by Thoroughbred horses. The racing type is separate from the Thoroughbred breed definition and from the turf, dirt, or all-weather surface used.","summary_ja":"サラブレッドを対象または中心として行う平地競馬。競馬種別としての呼称であり、サラブレッドという品種の定義や、芝・ダート・オールウェザーという馬場区分とは分けて扱う。","aliases_en":["Thoroughbred racing"],"aliases_ja":["サラブレッド競馬"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"flat-racing","slug":"flat-racing","term_en":"Flat racing","term_ja":"平地競馬","category":"race_type","summary_en":"Racing run without required jumps or obstacles. Flat racing may take place on turf, dirt, or all-weather surfaces, so the racing type must not be treated as a surface label.","summary_ja":"必須の障害物を越えずに行う競馬。芝・ダート・オールウェザーのいずれでも行われるため、競馬種別と馬場区分を同一視しない。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"jump-racing","slug":"jump-racing","term_en":"Jump racing","term_ja":"障害競馬","category":"race_type","summary_en":"Racing in which horses are required to clear obstacles. It is an umbrella racing type that can include steeplechases and hurdle races, and it is distinct from a jump-course surface or layout description.","summary_ja":"馬が障害物を越えることを必須とする競馬。スティープルチェイスやハードル競走などを含む上位区分であり、施設上の障害コースという説明とは分けて扱う。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"steeplechase","slug":"steeplechase","term_en":"Steeplechase","term_ja":"スティープルチェイス","category":"race_type","summary_en":"A form of jump racing run over fences or other substantial obstacles. It is a subtype of jump racing rather than a synonym for every race conducted over obstacles.","summary_ja":"柵などの比較的大きな障害物を越える障害競馬の一形式。障害競馬全体の同義語ではなく、その下位区分として扱う。","aliases_en":[],"aliases_ja":["障害競走（スティープルチェイス）"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"harness-racing","slug":"harness-racing","term_en":"Harness racing","term_ja":"繋駕競走","category":"race_type","summary_en":"Racing in which a horse pulls a light two-wheeled cart and is controlled by a driver. Trotting and pacing are the principal gait-based forms within harness racing.","summary_ja":"馬が軽量の二輪車を引き、ドライバーが操縦する競馬。トロットとペースを主要な歩様別形式として含む。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_n