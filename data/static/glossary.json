[{"schema_version":"glossary-entry-v2","id":"thoroughbred-racing","slug":"thoroughbred-racing","term_en":"Thoroughbred flat racing","term_ja":"サラブレッド平地競馬","category":"race_type","summary_en":"Flat racing restricted to or principally contested by Thoroughbred horses. The racing type is separate from the Thoroughbred breed definition and from the turf, dirt, or all-weather surface used.","summary_ja":"サラブレッドを対象または中心として行う平地競馬。競馬種別としての呼称であり、サラブレッドという品種の定義や、芝・ダート・オールウェザーという馬場区分とは分けて扱う。","aliases_en":["Thoroughbred racing"],"aliases_ja":["サラブレッド競馬"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["flat-racing","thoroughbred"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"flat-racing","slug":"flat-racing","term_en":"Flat racing","term_ja":"平地競馬","category":"race_type","summary_en":"Racing run without required jumps or obstacles. Flat racing may take place on turf, dirt, or all-weather surfaces, so the racing type must not be treated as a surface label.","summary_ja":"必須の障害物を越えずに行う競馬。芝・ダート・オールウェザーのいずれでも行われるため、競馬種別と馬場区分を同一視しない。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["thoroughbred-racing","jump-racing"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"jump-racing","slug":"jump-racing","term_en":"Jump racing","term_ja":"障害競馬","category":"race_type","summary_en":"Racing in which horses are required to clear obstacles. It is an umbrella racing type that can include steeplechases and hurdle races, and it is distinct from a jump-course surface or layout description.","summary_ja":"馬が障害物を越えることを必須とする競馬。スティープルチェイスやハードル競走などを含む上位区分であり、施設上の障害コースという説明とは分けて扱う。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["flat-racing","steeplechase","jump-course"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"steeplechase","slug":"steeplechase","term_en":"Steeplechase","term_ja":"スティープルチェイス","category":"race_type","summary_en":"A form of jump racing run over fences or other substantial obstacles. It is a subtype of jump racing rather than a synonym for every race conducted over obstacles.","summary_ja":"柵などの比較的大きな障害物を越える障害競馬の一形式。障害競馬全体の同義語ではなく、その下位区分として扱う。","aliases_en":[],"aliases_ja":["障害競走（スティープルチェイス）"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["jump-racing","jump-course"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"harness-racing","slug":"harness-racing","term_en":"Harness racing","term_ja":"繋駕競走","category":"race_type","summary_en":"Racing in which a horse pulls a light two-wheeled cart and is controlled by a driver. Trotting and pacing are the principal gait-based forms within harness racing.","summary_ja":"馬が軽量の二輪車を引き、ドライバーが操縦する競馬。トロットとペースを主要な歩様別形式として含む。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["trotting","pacing","standardbred"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"trotting","slug":"trotting","term_en":"Trotting","term_ja":"トロット競走","category":"race_type","summary_en":"A gait-based form of harness racing in which diagonal pairs of legs move together. It is classified under harness racing, not as a horse breed or racing surface.","summary_ja":"対角線上の脚が同時に動くトロット歩様で行う繋駕競走。繋駕競走の下位区分であり、馬の品種や馬場区分ではない。","aliases_en":[],"aliases_ja":["トロット"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["harness-racing","standardbred"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"pacing","slug":"pacing","term_en":"Pacing","term_ja":"ペース競走","category":"race_type","summary_en":"A gait-based form of harness racing in which the legs on the same side move together. It is classified under harness racing, not as a horse breed or racing surface.","summary_ja":"同じ側の脚が同時に動くペース歩様で行う繋駕競走。繋駕競走の下位区分であり、馬の品種や馬場区分ではない。","aliases_en":[],"aliases_ja":["ペース"],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["harness-racing","standardbred"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"arabian-racing","slug":"arabian-racing","term_en":"Arabian racing","term_ja":"アラブ競馬","category":"race_type","summary_en":"Racing restricted to or principally contested by Arabian horses. The racing type is separate from the Arabian horse breed definition.","summary_ja":"アラブ馬を対象または中心として行う競馬。競馬種別としての呼称であり、アラブ馬の品種定義とは分けて扱う。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["arabian-horse"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"quarter-horse-racing","slug":"quarter-horse-racing","term_en":"Quarter Horse racing","term_ja":"クォーターホース競馬","category":"race_type","summary_en":"Racing for American Quarter Horses, commonly associated with short-distance speed. The racing type is separate from the American Quarter Horse breed definition.","summary_ja":"アメリカン・クォーターホースによる競馬で、短距離のスピード競走と結び付くことが多い。競馬種別と品種定義は分けて扱う。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["american-quarter-horse"],"source_ids":[],"evidence_status":"reviewed_secondary","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"banei-racing","slug":"banei-racing","term_en":"Banei racing","term_ja":"ばんえい競馬","category":"race_type","summary_en":"A Japanese racing format in which draft horses pull weighted sleds over a straight sand course with two hill-shaped obstacles. Despite those obstacles, it is classified separately from jump racing.","summary_ja":"大型馬が重量のあるそりを引き、二つの山形障害がある直線の砂コースを進む日本独自の競馬。障害物を使用するが、障害競馬とは別の競馬種別として扱う。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":["draft-horse"],"source_ids":["japan-banei-home"],"evidence_status":"reviewed_official","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"thoroughbred","slug":"thoroughbred","term_en":"Thoroughbred","term_ja":"サラブレッド","category":"breed","summary_en":"A recognized horse breed maintained through stud-book registration and strongly associated with racing. The breed entry describes the horse and remains separate from Thoroughbred flat racing as a racing type.","summary_ja":"血統登録によって管理され、競馬との結び付きが強い馬の品種。馬そのものの品種を説明する項目であり、競馬種別であるサラブレッド平地競馬とは分けて扱う。","aliases_en":["Thoroughbred horse"],"aliases_ja":["サラブレッド種"],"reading_ja":"さらぶれっど","pronunciation_en":null,"beginner_explanation_en":"Thoroughbred is the breed of horse. Thoroughbred flat racing is the type of racing in which that breed competes.","beginner_explanation_ja":"サラブレッドは馬の品種です。サラブレッド平地競馬は、その品種の馬が出走する競馬の形式です。","related_term_ids":["thoroughbred-racing"],"source_ids":["united-states-jockey-club-registry"],"evidence_status":"reviewed_official","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"arabian-horse","slug":"arabian-horse","term_en":"Arabian horse","term_ja":"アラブ馬","category":"breed","summary_en":"A recognized horse breed represented by dedicated breed registries and used across racing, endurance, showing, and other equestrian activities. The breed remains separate from Arabian racing as a racing category.","summary_ja":"専用の品種登録団体によって扱われ、競馬、エンデュランス、ショーなど幅広い馬術活動で用いられる馬の品種。競馬種別であるアラブ競馬とは分けて扱う。","aliases_en":["Arabian"],"aliases_ja":["アラビアンホース"],"reading_ja":"あらぶうま","pronunciation_en":null,"beginner_explanation_en":"Arabian horse is the breed. Arabian racing is racing organized for horses of that breed.","beginner_explanation_ja":"アラブ馬は馬の品種です。アラブ競馬は、その品種の馬を対象にした競馬です。","related_term_ids":["arabian-racing"],"source_ids":["united-states-arabian-horse-association"],"evidence_status":"reviewed_official","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"american-quarter-horse","slug":"american-quarter-horse","term_en":"American Quarter Horse","term_ja":"アメリカン・クォーターホース","category":"breed","summary_en":"A recognized horse breed associated with rapid acceleration over short distances and also used in a wide range of working and sport disciplines. The breed remains separate from Quarter Horse racing as a racing category.","summary_ja":"短距離での加速力と結び付けられ、作業や多様な馬術競技にも用いられる馬の品種。競馬種別であるクォーターホース競馬とは分けて扱う。","aliases_en":["Quarter Horse"],"aliases_ja":["クォーターホース"],"reading_ja":"あめりかん・くぉーたーほーす","pronunciation_en":null,"beginner_explanation_en":"American Quarter Horse is the breed. Quarter Horse racing is the short-distance racing category associated with that breed.","beginner_explanation_ja":"アメリカン・クォーターホースは馬の品種です。クォーターホース競馬は、その品種と結び付く短距離競馬の形式です。","related_term_ids":["quarter-horse-racing"],"source_ids":["united-states-aqha"],"evidence_status":"reviewed_official","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"standardbred","slug":"standardbred","term_en":"Standardbred","term_ja":"スタンダードブレッド","category":"breed","summary_en":"A recognized horse breed closely associated with harness racing. Individual Standardbreds may compete in trotting or pacing, but the breed itself is not a gait or racing type.","summary_ja":"繋駕競走との結び付きが強い馬の品種。スタンダードブレッドの馬はトロット競走またはペース競走に出走するが、品種自体は歩様や競馬種別ではない。","aliases_en":["Standardbred horse"],"aliases_ja":["スタンダードブレッド種"],"reading_ja":"すたんだーどぶれっど","pronunciation_en":null,"beginner_explanation_en":"Standardbred is the breed. Harness racing is the racing code, while trotting and pacing describe the gait-based forms used in that code.","beginner_explanation_ja":"スタンダードブレッドは馬の品種です。繋駕競走は競馬の形式で、トロットとペースはその中の歩様別形式です。","related_term_ids":["harness-racing","trotting","pacing"],"source_ids":["united-states-usta"],"evidence_status":"reviewed_official","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"draft-horse","slug":"draft-horse","term_en":"Draft horse","term_ja":"輓馬","category":"horse_type","summary_en":"A broad horse type developed for pulling heavy loads. Draft horse includes multiple breeds and must not be represented as one breed or as a synonym for Banei racing.","summary_ja":"重い荷を引く用途に適した馬の広いタイプ。複数の品種を含むため単一品種として扱わず、ばんえい競馬そのものの同義語にもならない。","aliases_en":["Draught horse","Heavy horse"],"aliases_ja":["ばん馬","重種馬"],"reading_ja":"ばんば","pronunciation_en":null,"beginner_explanation_en":"Draft horse describes a group of powerful horse breeds. Banei racing is a racing format that uses draft horses.","beginner_explanation_ja":"輓馬は力の強い複数の馬品種をまとめたタイプです。ばんえい競馬は、そのような馬を使う競馬の形式です。","related_term_ids":["banei-racing"],"source_ids":["japan-banei-home"],"evidence_status":"mixed_reviewed","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"enriched_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"racecourse","slug":"racecourse","term_en":"Racecourse","term_ja":"競馬場","category":"track_term","summary_en":"A venue where horse races are held.","summary_ja":"競馬が開催される施設。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"meeting","slug":"meeting","term_en":"Meeting","term_ja":"開催日・開催","category":"data_term","summary_en":"A race-day or scheduled racing event at a racecourse.","summary_ja":"競馬場で行われる開催日または開催イベント。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"racecard","slug":"racecard","term_en":"Racecard","term_ja":"レースカード","category":"data_term","summary_en":"An official or published list of races for a meeting. v0 links to official sources rather than republishing full racecards.","summary_ja":"開催日のレース一覧。v0では全文再掲載せず、公式ソースへ案内する。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":["entries","participant_data","odds","results","payouts"],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"post-time","slug":"post-time","term_en":"Post time","term_ja":"発走時刻","category":"data_term","summary_en":"The scheduled start time of a race, usually shown in the racecourse local time.","summary_ja":"各レースの発走予定時刻。通常は競馬場の現地時刻で表示される。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"fixture","slug":"fixture","term_en":"Fixture","term_ja":"開催日程","category":"data_term","summary_en":"A scheduled racing date or calendar entry.","summary_ja":"競馬の開催予定日またはカレンダー項目。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":[],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"jockey","slug":"jockey","term_en":"Jockey","term_ja":"騎手","category":"role","summary_en":"A rider who rides a horse in a race.","summary_ja":"競走で馬に騎乗する人。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explanation_ja":null,"related_term_ids":[],"source_ids":[],"evidence_status":"baseline_definition","public_boundary":{"mode":"definition_and_navigation","prohibited_dataset_keys":["participant_data"],"republish_dataset":false},"content_status":"baseline_reviewed","last_reviewed":"2026-07-16"},{"schema_version":"glossary-entry-v2","id":"driver","slug":"driver","term_en":"Driver","term_ja":"ドライバー","category":"role","summary_en":"A person who drives the cart in harness racing.","summary_ja":"繋駕競走で馬車を操縦する人。","aliases_en":[],"aliases_ja":[],"reading_ja":null,"pronunciation_en":null,"beginner_explanation_en":null,"beginner_explana