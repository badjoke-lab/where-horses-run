{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whr.badjoke-lab.com/schemas/calendar-review-queue.schema.json",
  "title": "Where Horses Run Calendar Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "calendar-review-queue-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repoRef": {
      "type": "string",
      "pattern": "^(?:data|docs)/[A-Za-z0-9_./+-]+$"
    },
    "requestedScope": {
      "oneOf": [
        { "$ref": "#/$defs/dateWindowScope" },
        { "$ref": "#/$defs/singleDateScope" },
        { "$ref": "#/$defs/selectedMeetingsScope" }
      ]
    },
    "dateWindowScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date_exclusive", "timezone"],
      "properties": {
        "start_date": { "$ref": "#/$defs/date" },
        "end_date_exclusive": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "singleDateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "timezone"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "selectedMeetingsScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_ids"],
      "properties": {
        "meeting_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "rankCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "B", "B+", "A", "A+"],
      "properties": {
        "C": { "type": "integer", "minimum": 0 },
        "B": { "type": "integer", "minimum": 0 },
        "B+": { "type": "integer", "minimum": 0 },
        "A": { "type": "integer", "minimum": 0 },
        "A+": { "type": "integer", "minimum": 0 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "job_id",
        "batch_id",
        "system_id",
        "runner_used",
        "requested_scope",
        "coverage_claim",
        "rank_counts",
        "unresolved_dates_count",
        "unresolved_meeting_ids_count",
        "source_error_count",
        "review_state",
        "promotion_state",
        "manifest_ref"
      ],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "batch_id": { "$ref": "#/$defs/id" },
        "system_id": { "$ref": "#/$defs/id" },
        "runner_used": { "enum": ["github_actions", "local", "reviewed_import"] },
        "requested_scope": { "$ref": "#/$defs/requestedScope" },
        "coverage_claim": { "enum": ["none", "partial", "source_window_complete", "audited_complete"] },
        "rank_counts": { "$ref": "#/$defs/rankCounts" },
        "unresolved_dates_count": { "type": "integer", "minimum": 0 },
        "unresolved_meeting_ids_count": { "type": "integer", "minimum": 0 },
        "source_error_count": { "type": "integer", "minimum": 0 },
        "review_state": { "enum": ["review_ready", "reviewing", "approved", "rejected"] },
        "promotion_state": { "enum": ["not_ready", "promotion_ready", "promoted", "published"] },
        "manifest_ref": { "$ref": "#/$defs/repoRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "review_state": { "enum": ["review_ready", "reviewing", "rejected"] } },
            "required": ["review_state"]
          },
          "then": {
            "properties": { "promotion_state": { "const": "not_ready" } }
          }
        },
        {
          "if": {
            "properties": { "promotion_state": { "enum": ["promotion_ready", "promoted", "published"] } },
            "required": ["promotion_state"]
          },
          "then": {
            "properties": { "review_state": { "const": "approved" } }
          }
        }
      ]
    }
  }
}
