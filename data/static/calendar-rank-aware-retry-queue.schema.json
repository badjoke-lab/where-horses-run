{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whr.badjoke-lab.com/schemas/calendar-rank-aware-retry-queue.schema.json",
  "title": "Where Horses Run Calendar Rank-aware Retry Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "calendar-rank-aware-retry-queue-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateTimeOrNull": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "rank": {
      "enum": ["C", "B", "B+", "A", "A+"]
    },
    "targetRank": {
      "enum": ["C", "B", "B+", "A", "A+", "best_available"]
    },
    "missingField": {
      "enum": [
        "first_race_time_local",
        "last_race_time_local",
        "timetable_rows",
        "race_name",
        "distance_m",
        "surface",
        "course_label"
      ]
    },
    "selectedMeetingsScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "meeting_ids"],
      "properties": {
        "mode": { "const": "selected_meetings" },
        "meeting_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "dateWindowScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "start_date", "end_date_exclusive", "timezone"],
      "properties": {
        "mode": { "enum": ["date_window", "source_visible_horizon"] },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date_exclusive": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "singleDateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "date", "timezone"],
      "properties": {
        "mode": { "const": "single_date" },
        "date": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "retryScope": {
      "oneOf": [
        { "$ref": "#/$defs/selectedMeetingsScope" },
        { "$ref": "#/$defs/dateWindowScope" },
        { "$ref": "#/$defs/singleDateScope" }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_id",
        "system_id",
        "current_reviewed_rank",
        "latest_observed_rank",
        "collection_target_rank",
        "missing_fields",
        "retry_reason",
        "retry_scope",
        "primary_runner",
        "fallback_runner",
        "adapter_id",
        "next_eligible_retry_at",
        "attempt_count",
        "last_attempt_at"
      ],
      "properties": {
        "meeting_id": { "$ref": "#/$defs/id" },
        "system_id": { "$ref": "#/$defs/id" },
        "current_reviewed_rank": { "$ref": "#/$defs/rank" },
        "latest_observed_rank": {
          "oneOf": [
            { "$ref": "#/$defs/rank" },
            { "type": "null" }
          ]
        },
        "collection_target_rank": { "$ref": "#/$defs/targetRank" },
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/missingField" }
        },
        "retry_reason": {
          "enum": [
            "scheduled_pending_details",
            "detail_retry_required",
            "coverage_gap",
            "rank_upgrade_retry",
            "source_revalidation",
            "manual_recovery",
            "completion_audit_support"
          ]
        },
        "retry_scope": { "$ref": "#/$defs/retryScope" },
        "primary_runner": { "enum": ["github_actions", "local", "reviewed_import"] },
        "fallback_runner": {
          "oneOf": [
            { "enum": ["github_actions", "local", "reviewed_import"] },
            { "type": "null" }
          ]
        },
        "adapter_id": { "$ref": "#/$defs/id" },
        "next_eligible_retry_at": { "$ref": "#/$defs/dateTimeOrNull" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "last_attempt_at": { "$ref": "#/$defs/dateTimeOrNull" }
      }
    }
  }
}
