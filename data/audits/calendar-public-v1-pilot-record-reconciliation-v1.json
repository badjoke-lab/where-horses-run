    "operator_notes",
    "source_snapshot_path",
    "normalized_from_path",
    "raw_html",
    "raw_pdf",
    "raw_text"
  ],
  "boundaries": {
    "canonical_write": false,
    "public_projection_write": false,
    "automatic_acquisition": false,
    "automatic_approval": false,
    "automatic_promotion": false,
    "unattended_publication": false,
    "internal_queue_publication": false,
    "participant_data_publication": false,
    "betting_data_publication": false,
    "result_or_payout_publication": false
  },
  "next_unit": "Validate current, stale, empty, source-failure, and retry-ownership presentation across bilingual public routes."
