---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import TodayFilters from '../components/TodayFilters.astro';
import TodayMeetingMap from '../components/TodayMeetingMap.astro';
import '../styles/today-practical.css';
import {
  getGroupedTimetableMeetingRows,
  getTimetableDateContext,
  getTimetableMeetingRowsForWindow,
} from '../data/timetableMeetingRows';
import { addCalendarDays } from '../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const candidateStart = addCalendarDays(context.today, -2);
const candidateEndExclusive = addCalendarDays(context.today, 10);
const meetingCandidates = getTimetableMeetingRowsForWindow(candidateStart, candidateEndExclusive);
const meetingGroups = getGroupedTimetableMeetingRows(meetingCandidates);
---

<BaseLayout
  title="Where Horses Run | Global horse racing today, tomorrow & next 7 days"
  description="Find horse racing today, tomorrow, or across the next seven days by map and timetable, with official sources and published race times."
  canonicalPath="/"
  alternatePath="/ja/"
>
  <main class="today-page" data-today-page data-home-meeting-window>
    <section class="hero today-page__hero" aria-labelledby="page-title">
      <p class="hero__eyebrow">Global horse racing</p>
      <h1 id="page-title">Find horse racing meetings</h1>
      <p class="today-page__context">
        <span>Today / Tomorrow / 7 days</span> · <span data-timezone-label>{context.timeZone}</span>
      </p>
      <p class="hero__summary">
        Find meetings today, tomorrow, or over the next seven days on one map and list. Filter by timezone, country, authority, or public rank.
      </p>
    </section>

    <TodayFilters records={meetingCandidates} />
    <TodayMeetingMap records={meetingCandidates} date={context.today} />

    <section class="today-page__list" aria-labelledby="home-list-title" data-today-practical-list>
      <div class="today-page__list-heading">
        <div>
          <p class="today-page__eyebrow">Meeting list</p>
          <h2 id="home-list-title" data-window-list-title>Today’s meetings</h2>
        </div>
        <p>The list follows the selected period and active filters.</p>
      </div>
      <TimetableMeetingList
        groups={meetingGroups}
        scope="all"
        emptyLabel="No meetings are currently listed for the selected period and display timezone. Check official sources for the latest information."
      />
    </section>
  </main>
</BaseLayout>
