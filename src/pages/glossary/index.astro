---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGlossaryCategoryLabel, getGlossaryEntries } from '../../lib/glossary-data';

const entries = getGlossaryEntries();
---

<BaseLayout
  title="Glossary | Where Horses Run"
  description="Browse racing terms used in calendars, timetables, source pages, and track profiles."
>
  <section
    class="hero"
    aria-labelledby="page-title"
    data-glossary-release="WHR-GLOSSARY-V1"
    data-glossary-concepts="48"
    data-glossary-relationships="57"
  >
    <p class="hero__eyebrow">Glossary · Public v1</p>
    <h1 id="page-title">Glossary</h1>
    <p class="hero__summary">
      Browse 48 reviewed racing concepts in English and Japanese.
    </p>
    <p>Public v1 includes 57 reviewed relationships with no isolated concepts.</p>
    <p><a href="/glossary/relationships/">Explore the relationship graph</a></p>
  </section>

  <section class="section-grid" aria-label="Glossary list">
    {entries.map((entry) => (
      <article class="card" data-glossary-category={entry.category}>
        <h2><a href={`/glossary/${entry.slug}/`}>{entry.term_en}</a></h2>
        <p>{entry.summary_en}</p>
        <p><strong>Category:</strong> {getGlossaryCategoryLabel(entry.category, 'en')}</p>
      </article>
    ))}
  </section>
</BaseLayout>
