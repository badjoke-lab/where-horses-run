---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getRacecoursesByRacingTypeId, getRacingTypes } from '../../../lib/racingTypes';

const racingTypes = getRacingTypes();
---

<BaseLayout
  lang="ja"
  title="競馬種別 | 競馬どこ？"
  description="平地競走、障害競走、ばんえい競馬など、競馬の種類と関連する競馬場を紹介します。"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">競馬の種類</p>
    <h1 id="page-title">競馬種別</h1>
    <p class="hero__summary">
      競馬の種類ごとに特徴を確認し、その競馬が行われる競馬場を探せます。
    </p>
  </section>

  <section class="section-grid" aria-label="競馬種別一覧">
    {racingTypes.map((type) => {
      const tracks = getRacecoursesByRacingTypeId(type.id);
      return (
        <article class="card">
          <h2><a href={`/ja/types/${type.slug}/`}>{type.name_ja}</a></h2>
          <p>{type.summary_ja}</p>
          <p><strong>関連する競馬場:</strong> {tracks.length}</p>
        </article>
      );
    })}
  </section>
</BaseLayout>
