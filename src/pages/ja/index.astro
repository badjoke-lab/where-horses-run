---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MeetingStatePolicy from '../../components/MeetingStatePolicy.astro';
import TimetableMeetingList from '../../components/TimetableMeetingList.astro';
import TodayFilters from '../../components/TodayFilters.astro';
import TodayMeetingMap from '../../components/TodayMeetingMap.astro';
import '../../styles/today-practical.css';
import {
  getGroupedTimetableMeetingRows,
  getTimetableDateContext,
  getTimetableMeetingRowsForWindow,
} from '../../data/timetableMeetingRows';
import { addCalendarDays } from '../../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const candidateStart = addCalendarDays(context.today, -2);
const candidateEndExclusive = addCalendarDays(context.today, 10);
const meetingCandidates = getTimetableMeetingRowsForWindow(candidateStart, candidateEndExclusive);
const meetingGroups = getGroupedTimetableMeetingRows(meetingCandidates);
---

<BaseLayout
  lang="ja"
  title="競馬どこ？ | 今日・明日・7日間の世界競馬開催"
  description="今日、明日、今後7日間の競馬開催を地図と時刻表で確認できます。公開レース時刻と公式情報源も掲載します。"
  canonicalPath="/ja/"
  alternatePath="/"
>
  <main class="today-page" data-today-page data-home-meeting-window>
    <MeetingStatePolicy />

    <section class="hero today-page__hero" aria-labelledby="page-title">
      <p class="hero__eyebrow" data-window-eyebrow>今日</p>
      <h1 id="page-title" data-window-title>今日の開催</h1>
      <p class="today-page__context">
        <span>今日 / 明日 / 7日間</span> · <span data-timezone-label>{context.timeZone}</span>
      </p>
      <p class="hero__summary">
        今日・明日・今後7日間を、同じ地図と同じ開催一覧で切り替えます。開催一覧はカレンダーと同じ公開meeting rowと状態判定を使います。
      </p>
    </section>

    <TodayFilters records={meetingCandidates} lang="ja" />

    <TodayMeetingMap records={meetingCandidates} date={context.today} lang="ja" />

    <section class="today-page__list" aria-labelledby="home-list-title" data-today-practical-list>
      <div class="today-page__list-heading">
        <div>
          <p class="today-page__eyebrow">開催一覧</p>
          <h2 id="home-list-title" data-window-list-title>今日の開催一覧</h2>
        </div>
        <p>地図・トップ・カレンダーは同じ公開meeting rowとランク別状態ルールを使います。</p>
      </div>
      <TimetableMeetingList
        groups={meetingGroups}
        scope="all"
        lang="ja"
        emptyLabel="選択した期間と表示タイムゾーンに該当する開催情報は掲載されていません。最新情報は公式情報源で確認してください。"
      />
    </section>
  </main>
</BaseLayout>
