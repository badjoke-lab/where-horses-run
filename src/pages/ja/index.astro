---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeRacingMap from '../../components/HomeRacingMap.astro';
import HomeMeetingPreview from '../../components/HomeMeetingPreview.astro';
import '../../styles/home-map-first.css';
import {
  getTimetableDateContext,
  getTimetableMeetingRowsForDate,
  getTimetableMeetingRowsForWindow,
} from '../../data/timetableMeetingRows';
import { addCalendarDays } from '../../lib/timetable/calendarDateContext.mjs';

const calendarContext = getTimetableDateContext();
const todayPreview = getTimetableMeetingRowsForDate(calendarContext.today).slice(0, 6);
const tomorrow = addCalendarDays(calendarContext.today, 1);
const upNextEndExclusive = addCalendarDays(calendarContext.today, 8);
const upNext = getTimetableMeetingRowsForWindow(tomorrow, upNextEndExclusive).slice(0, 6);
const mapCandidateStart = addCalendarDays(calendarContext.today, -2);
const mapCandidateEndExclusive = addCalendarDays(calendarContext.today, 9);
const mapCandidates = getTimetableMeetingRowsForWindow(mapCandidateStart, mapCandidateEndExclusive);
---

<BaseLayout
  lang="ja"
  title="競馬どこ？ | 世界の競馬開催カレンダー・レース時刻表"
  description="世界の競馬開催日、レース時刻、競馬場、競馬種別、公式情報源を探せます。"
>
  <section class="hero home-hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">世界の競馬開催カレンダー</p>
    <h1 id="page-title">今日、どこで競馬がある？</h1>
    <p class="hero__summary">世界の競馬開催を場所と時刻から探せます。</p>
  </section>

  <HomeRacingMap records={mapCandidates} lang="ja" />

  <div class="home-primary-flow">
    <section class="home-meeting-summary" aria-labelledby="home-today-title">
      <div class="home-section-heading">
        <div>
          <p class="home-section-heading__eyebrow">今日</p>
          <h2 id="home-today-title">今日の開催</h2>
        </div>
        <a href="/ja/today/">今日の開催をすべて見る</a>
      </div>
      {todayPreview.length > 0 ? (
        <HomeMeetingPreview records={todayPreview} lang="ja" />
      ) : (
        <p>今日のレビュー済み公開開催は掲載されていません。</p>
      )}
    </section>

    <section class="home-meeting-summary" aria-labelledby="home-up-next-title">
      <div class="home-section-heading">
        <div>
          <p class="home-section-heading__eyebrow">次の開催</p>
          <h2 id="home-up-next-title">このあと</h2>
        </div>
        <a href="/ja/calendar/">カレンダーを開く</a>
      </div>
      {upNext.length > 0 ? (
        <HomeMeetingPreview records={upNext} lang="ja" showDate={true} />
      ) : (
        <p>今後7日間にレビュー済み公開開催は掲載されていません。</p>
      )}
    </section>
  </div>
</BaseLayout>