---
import RacecourseDetailPage from '../../../components/RacecourseDetailPage.astro';
import RacecourseHubPage from '../../../components/RacecourseHubPage.astro';
import { getRacecourseBySlug, getRacecourses } from '../../../lib/data';

export function getStaticPaths() {
  return getRacecourses().map((track) => ({ params: { slug: track.slug } }));
}

const { slug } = Astro.params;
const track = getRacecourseBySlug(slug ?? '');

if (!track) {
  return Astro.redirect('/ja/tracks/');
}

const useReferenceHub = track.id === 'tokyo-racecourse';
---

{useReferenceHub
  ? <RacecourseHubPage track={track} locale="ja" />
  : <RacecourseDetailPage track={track} locale="ja" />}
