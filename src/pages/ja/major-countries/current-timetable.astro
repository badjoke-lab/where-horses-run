---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimetableMeetingList from '../../../components/TimetableMeetingList.astro';
import {
  getTimetableDateContext,
  getTimetableProjectionCandidateGroups,
} from '../../../data/timetableMeetingRows';

const dateContext = getTimetableDateContext();
const groupedTimetableRecords = getTimetableProjectionCandidateGroups(
  dateContext.windowStart,
  dateContext.windowEndExclusive,
);
---

<BaseLayout
  title="現在のタイムテーブル | 競馬どこ？"
  description="選択した表示タイムゾーンを基準にした現在30日間の開催一覧です。"
  lang="ja"
  canonicalPath="/ja/major-countries/current-timetable/"
  alternatePath="/major-countries/current-timetable/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">現在のタイムテーブル</p>
    <h1 id="page-title">現在の30日間タイムテーブル</h1>
    <p class="hero__summary">
      下の表示タイムゾーンを選択すると、30日間の範囲、開催日、表示時刻をそのタイムゾーンへ変換します。
    </p>
  </section>

  <section aria-label="選択したタイムゾーンでの現在のタイムテーブル">
    <TimetableMeetingList
      groups={groupedTimetableRecords}
      lang="ja"
      viewMode="window30"
      emptyLabel="選択したタイムゾーンの現在30日間に公開済みの開催情報はありません。最終確認には公式ソースを使用してください。"
    />
  </section>
</BaseLayout>
