---
const target = '/ja/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="今日の開催はトップページの初期表示へ統合しました。" />
    <meta property="og:title" content="今日の開催はトップへ移動しました | 競馬どこ？" />
    <meta property="og:description" content="今日の開催はトップページの初期表示へ統合しました。" />
    <meta name="twitter:title" content="今日の開催はトップへ移動しました | 競馬どこ？" />
    <meta name="twitter:description" content="今日の開催はトップページの初期表示へ統合しました。" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://whr.badjoke-lab.com/ja/" />
    <title>今日の開催はトップへ移動しました | 競馬どこ？</title>
  </head>
  <body>
    <p>今日の開催はトップページの初期表示になりました。<a href={target}>トップを開く</a></p>
    <script is:inline>
      const url = new URL('/ja/', window.location.origin);
      const current = new URL(window.location.href);
      current.searchParams.forEach((value, key) => url.searchParams.set(key, value));
      url.searchParams.delete('range');
      window.location.replace(`${url.pathname}${url.search}`);
    </script>
  </body>
</html>
