---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendarDateStatus from '../../components/CalendarDateStatus.astro';
import CalendarOperationsNotice from '../../components/CalendarOperationsNotice.astro';
import TimetableMeetingList from '../../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForDate,
  getTimetableProjectionCandidateRows,
} from '../../data/timetableMeetingRows';
import { addCalendarDays } from '../../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const tomorrowRecords = getTimetableMeetingRowsForDate(context.tomorrow);
const projectionCandidates = getTimetableProjectionCandidateRows(
  context.tomorrow,
  addCalendarDays(context.tomorrow, 1),
);
---

<BaseLayout
  title={`明日の開催時刻表 — ${context.tomorrow} | 競馬どこ？`}
  description="選択した表示タイムゾーンで明日に該当する確認済み公開開催情報です。最終確認は公式ソースで行ってください。"
  lang="ja"
  canonicalPath="/ja/tomorrow/"
  alternatePath="/tomorrow/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Tomorrow</p>
    <h1 id="page-title">明日の開催時刻表</h1>
    <p class="hero__summary">
      下の表示タイムゾーンを選択すると、開催日の所属と表示日時をそのタイムゾーンへ変換します。
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} lang="ja" />
  <CalendarOperationsNotice records={tomorrowRecords} dataState={dataState} lang="ja" />

  <section aria-label="明日の開催一覧">
    <TimetableMeetingList
      records={projectionCandidates}
      date={context.tomorrow}
      lang="ja"
      viewMode="tomorrow"
      emptyLabel="選択したタイムゾーンで明日に該当する確認済み公開開催はありません。最新情報は公式ソースで確認してください。"
    />
  </section>
</BaseLayout>
