---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CalendarCoverageDashboard from '../../../components/CalendarCoverageDashboard.astro';
import CalendarDateFocus from '../../../components/CalendarDateFocus.astro';
import CalendarDateStatus from '../../../components/CalendarDateStatus.astro';
import CalendarFilters from '../../../components/CalendarFilters.astro';
import CalendarLivePlayers from '../../../components/CalendarLivePlayers.astro';
import TimetableMeetingList from '../../../components/TimetableMeetingList.astro';
import { getCurrentCalendarWindowGroups, getTimetableDataState, getTimetableDateContext } from '../../../data/timetableMeetingRows';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const groupedCalendarRecords = getCurrentCalendarWindowGroups(context);
const windowRecords = groupedCalendarRecords.flatMap((group) => group.records);
---

<BaseLayout
  title="30日間の開催カレンダー | 競馬どこ？"
  description={`${context.windowStart}から${context.windowEndInclusive}までの競馬開催情報を日付別に確認できます。`}
  lang="ja"
  canonicalPath="/ja/calendar/"
  alternatePath="/calendar/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">開催カレンダー</p>
    <h1 id="page-title">30日間の開催カレンダー</h1>
    <p class="hero__summary">
      {context.windowStart}から{context.windowEndInclusive}までの開催を日付別に確認できます。時刻は{context.timeZone}を基準に表示します。
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} lang="ja" />
  <CalendarCoverageDashboard lang="ja" />
  <CalendarDateFocus lang="ja" />
  <CalendarFilters records={windowRecords} lang="ja" />
  <CalendarLivePlayers />

  <section aria-label="30日間の開催一覧">
    <TimetableMeetingList
      groups={groupedCalendarRecords}
      lang="ja"
      emptyLabel="この30日間の開催情報は掲載されていません。最新情報は公式情報源で確認してください。"
    />
  </section>
</BaseLayout>
