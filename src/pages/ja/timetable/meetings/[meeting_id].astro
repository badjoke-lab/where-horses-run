---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CalendarRuntimeBootstrap from '../../../../components/CalendarRuntimeBootstrap.astro';
import MeetingTimezoneProjection from '../../../../components/MeetingTimezoneProjection.astro';
import {
  getPublicTimetableMeetingDetail,
  getPublicTimetableMeetingRows,
  type PublicTimetableMeetingDetail,
  type PublicTimetableMeetingRow,
} from '../../../../lib/timetable/publicTimetableViewModel';
import { getCountries, getRacecourses } from '../../../../lib/data';

export function getStaticPaths() {
  const meetings = getPublicTimetableMeetingRows().filter((meeting) => meeting.detail_path !== null);

  return meetings.map((meeting) => ({
    params: { meeting_id: meeting.meeting_id },
    props: {
      meeting,
      detail: getPublicTimetableMeetingDetail(meeting.meeting_id),
    },
  }));
}

interface Props {
  meeting: PublicTimetableMeetingRow;
  detail: PublicTimetableMeetingDetail | undefined;
}

const { meeting, detail } = Astro.props;

if (!detail) {
  throw new Error(`Missing public meeting detail for ${meeting.meeting_id}`);
}

const displayValue = (value: string | number | null | undefined) => value ?? '非表示';
const titleCaseId = (value: string) =>
  value
    .replace(/-racecourse$/, '')
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');

const countries = getCountries();
const racecourses = getRacecourses();
const country = countries.find((entry) => entry.id === meeting.country_id);
const track = racecourses.find((entry) => entry.id === meeting.racecourse_id);

const racecourseName = track?.name_ja ?? track?.name_en ?? `${titleCaseId(meeting.racecourse_id)}競馬場`;
const authorityNameById: Record<string, string> = {
  jra: '日本中央競馬会',
  hkjc: '香港ジョッキークラブ',
  'nar-local-government-racing': '地方競馬全国協会',
  'banei-tokachi': 'ばんえい十勝',
  'emirates-racing-authority': 'エミレーツ競馬協会',
};
const countryName = country?.name_ja ?? country?.name_en ?? titleCaseId(meeting.country_id);
const countryPath = country ? `/ja/countries/${country.slug}/` : '/ja/countries/';
const trackPath = track ? `/ja/tracks/${track.slug}/` : '/ja/tracks/';
const authorityName = authorityNameById[meeting.authority_id] ?? titleCaseId(meeting.authority_id);

const hasRaceRows = detail.timetable_rows.length > 0;
const hasRaceName = detail.show_race_name && detail.timetable_rows.some((row) => row.race_name);
const hasDistance = detail.show_distance && detail.timetable_rows.some((row) => row.distance_m !== undefined);
const hasSurface = detail.show_surface && detail.timetable_rows.some((row) => row.surface);
const hasCourse = detail.show_course && detail.timetable_rows.some((row) => row.course_label);
const firstRaceTime = detail.timetable_rows[0]?.post_time_local ?? null;
const lastRaceTime = detail.timetable_rows.at(-1)?.post_time_local ?? null;
const raceCount = detail.timetable_rows.length;
const surfaceValues = [...new Set(detail.timetable_rows.map((row) => row.surface).filter((value): value is string => Boolean(value)))];
const courseValues = [...new Set(detail.timetable_rows.map((row) => row.course_label).filter((value): value is string => Boolean(value)))];
const summarySurface = surfaceValues.length === 1 ? surfaceValues[0] : null;
const summaryCourse = courseValues.length === 1 ? courseValues[0] : null;
const summaryCourseText = summaryCourse ?? summarySurface;

---

<BaseLayout
  title={`${racecourseName} 開催情報 | 競馬どこ？`}
  description="公式ソースへのリンクと公開ポリシーで制御されたタイムテーブル情報を表示する開催詳細ページです。"
  lang="ja"
  canonicalPath={`/ja/timetable/meetings/${meeting.meeting_id}/`}
  alternatePath={`/timetable/meetings/${meeting.meeting_id}/`}
>
  <CalendarRuntimeBootstrap mode="meeting-detail" />
  <div data-calendar-runtime-sensitive>
    <nav class="detail-nav" aria-label="開催詳細ナビゲーション">
      <a href="/ja/calendar/">← カレンダー</a>
      <a href="/ja/today/">← 今日の開催</a>
      <a href="/ja/major-countries/current-timetable/">← 現在のタイムテーブル</a>
    </nav>

    <section class="meeting-hero" aria-labelledby="page-title">
      <div class="meeting-hero__header">
        <div>
          <h1 id="page-title"><a href={trackPath}>{racecourseName}</a></h1>
          <p class="meeting-date"><span data-meeting-projected-date>{meeting.date}</span></p>
          <p class="meeting-context">{authorityName} · <a href={countryPath}>{countryName}</a></p>
        </div>
        <MeetingTimezoneProjection sourceDate={detail.date} sourceTimeZone={detail.timezone} lang="ja" />
      </div>

      <dl class="meeting-summary" aria-label="開催概要">
        {raceCount > 0 && (
          <div>
            <dt>レース数</dt>
            <dd>{raceCount}R</dd>
          </div>
        )}
        {(firstRaceTime || lastRaceTime) && (
          <div>
            <dt>開催地時刻</dt>
            <dd>{firstRaceTime ?? "—"}{lastRaceTime ? `–${lastRaceTime}` : ""}</dd>
          </div>
        )}
        {summaryCourseText && (
          <div>
            <dt>馬場・コース</dt>
            <dd>{summaryCourseText}</dd>
          </div>
        )}
      </dl>
    </section>

    {hasRaceRows && (
      <section aria-labelledby="race-timetable-title">
        <h2 id="race-timetable-title">本日のレース一覧</h2>
        <div class="table-scroll" role="region" aria-label="公開可能なレース時刻表" tabindex="0">
          <table>
            <thead>
              <tr>
                <th>レース</th>
                <th>発走日時</th>
                {hasRaceName && <th>レース名</th>}
                {hasDistance && <th>距離</th>}
                {hasSurface && <th>馬場</th>}
                {hasCourse && <th>コース</th>}
              </tr>
            </thead>
            <tbody>
              {detail.timetable_rows.map((row) => (
                <tr>
                  <td class="race-cell--label">{row.label}</td>
                  <td class="race-cell--time"><time data-meeting-source-time={row.post_time_local} data-meeting-time-display="compact">{meeting.date} {row.post_time_local}</time></td>
                  {hasRaceName && <td class="race-cell--name">{displayValue(row.race_name)}</td>}
                  {hasDistance && <td class="race-cell--distance">{row.distance_m ? `${row.distance_m}m` : '非表示'}</td>}
                  {hasSurface && <td class="race-cell--surface">{displayValue(row.surface)}</td>}
                  {hasCourse && <td class="race-cell--course">{displayValue(row.course_label)}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="source-strip" aria-label="公式ソース">
      <span>公式ソース</span>
      <a href={detail.official_source_url}>公式ソースを開く</a>
      <span class="source-strip__checked">最終確認 {displayValue(detail.last_checked_date)}</span>
    </section>

    <details class="data-notes">
      <summary>データについて</summary>
      <div class="data-notes__body">
        <p>開催地タイムゾーン: {detail.timezone}</p>
        <p>このページには、取得・確認できた公開対象の開催時刻と番組概要だけを表示しています。完全な公式情報は公式ソースで確認してください。</p>
      </div>
    </details>

  </div>
</BaseLayout>

<style>
  .detail-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-end: 1.5rem;
    font-size: 0.9rem;
  }

  .meeting-hero {
    margin-block-start: 0;
  }

  .meeting-hero__header {
    align-items: end;
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  h1,
  h2,
  p {
    margin-block: 0 0.65rem;
  }

  h1 {
    line-height: 1.15;
  }

  .meeting-date {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .meeting-context {
    color: var(--whr-color-muted);
    font-size: 0.9rem;
  }

  :global(.meeting-timezone-control) {
    margin-block: 0;
  }

  :global(.meeting-timezone-control output) {
    display: none;
  }

  .meeting-summary {
    border: 1px solid var(--whr-color-border);
    border-radius: 0.7rem;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin: 1rem 0 0;
    overflow: hidden;
  }

  .meeting-summary div {
    padding: 0.85rem 1rem;
    text-align: center;
  }

  .meeting-summary div + div {
    border-inline-start: 1px solid var(--whr-color-border);
  }

  .meeting-summary dt {
    color: var(--whr-color-muted);
    font-size: 0.78rem;
    font-weight: 700;
    margin-block-end: 0.2rem;
  }

  .meeting-summary dd {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0;
  }

  section[aria-labelledby="race-timetable-title"] {
    margin-block-start: 1.5rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid var(--whr-color-border);
    padding: 0.55rem 0.4rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--whr-color-muted);
    font-size: 0.82rem;
  }

  .race-cell--label,
  .race-cell--time {
    white-space: nowrap;
  }

  .race-cell--label {
    font-weight: 800;
  }

  .source-strip {
    align-items: center;
    border: 1px solid var(--whr-color-border);
    border-radius: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block-start: 1rem;
    padding: 0.75rem 0.9rem;
    font-size: 0.9rem;
  }

  .source-strip__checked {
    color: var(--whr-color-muted);
    margin-inline-start: auto;
  }

  .data-notes {
    border: 1px solid var(--whr-color-border);
    border-radius: 0.65rem;
    margin-block-start: 1rem;
    padding: 0.8rem 0.9rem;
  }

  .data-notes summary {
    cursor: pointer;
    font-weight: 800;
  }

  .data-notes__body {
    color: var(--whr-color-muted);
    font-size: 0.9rem;
    padding-block-start: 0.8rem;
  }

  .data-notes__body p:last-child {
    margin-block-end: 0;
  }

  @media (max-width: 720px) {
    .detail-nav {
      gap: 0.5rem 0.8rem;
      margin-block-end: 1.15rem;
    }

    .meeting-hero__header {
      align-items: stretch;
      grid-template-columns: 1fr;
    }

    :global(.meeting-timezone-control),
    :global(.meeting-timezone-control label),
    :global(.meeting-timezone-control select) {
      width: 100%;
    }

    :global(.meeting-timezone-control select) {
      max-width: none;
    }

    .meeting-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meeting-summary div {
      padding: 0.7rem 0.6rem;
      text-align: left;
    }

    .meeting-summary div + div {
      border-inline-start: 0;
    }

    .meeting-summary div:nth-child(even) {
      border-inline-start: 1px solid var(--whr-color-border);
    }

    .meeting-summary div:nth-child(n + 3) {
      border-block-start: 1px solid var(--whr-color-border);
    }

    .meeting-summary dd {
      font-size: 1.05rem;
    }

    .table-scroll {
      overflow: visible;
    }

    table,
    tbody {
      display: block;
      width: 100%;
    }

    thead {
      display: none;
    }

    tbody tr {
      border-bottom: 1px solid var(--whr-color-border);
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr) auto auto auto;
      gap: 0.15rem 0.55rem;
      padding: 0.7rem 0.15rem;
    }

    tbody td {
      border: 0;
      min-width: 0;
      padding: 0;
    }

    .race-cell--label {
      grid-column: 1;
      grid-row: 1 / span 3;
      font-size: 1rem;
    }

    .race-cell--time {
      font-weight: 800;
      grid-column: 2 / -1;
      grid-row: 1;
    }

    .race-cell--name {
      grid-column: 2 / -1;
      grid-row: 2;
      overflow-wrap: anywhere;
    }

    .race-cell--distance {
      grid-column: 2;
      grid-row: 3;
    }

    .race-cell--surface {
      grid-column: 3;
      grid-row: 3;
    }

    .race-cell--course {
      grid-column: 4 / -1;
      grid-row: 3;
    }

    .race-cell--surface::before,
    .race-cell--course::before {
      content: "·";
      margin-inline-end: 0.55rem;
      opacity: 0.55;
    }

    .source-strip {
      align-items: flex-start;
      display: grid;
      grid-template-columns: 1fr;
    }

    .source-strip__checked {
      margin-inline-start: 0;
    }
  }
</style>
