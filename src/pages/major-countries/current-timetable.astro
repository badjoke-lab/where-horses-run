---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimetableMeetingList from '../../components/TimetableMeetingList.astro';
import {
  getTimetableProjectionCandidateGroups,
  getTimetableDateContext,
} from '../../data/timetableMeetingRows';

const dateContext = getTimetableDateContext();
const groupedTimetableRecords = getTimetableProjectionCandidateGroups(
  dateContext.windowStart,
  dateContext.windowEndExclusive,
);
const windowLabel = `${dateContext.windowStart}–${dateContext.windowEndInclusive}`;
---

<BaseLayout
  title="Current Timetable | Where Horses Run"
  description={`A 30-day racing timetable with dates and available race times projected into the visitor-selected timezone.`}
  canonicalPath="/major-countries/current-timetable/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Current timetable</p>
    <h1 id="page-title">Current 30-day timetable</h1>
    <p class="hero__summary">
      The server window starts from {windowLabel}. Choose a display timezone below; meeting dates, available race times and 30-day membership follow that selection.
    </p>
  </section>

  <section aria-label={`Current timetable by date for ${windowLabel}`}>
    <TimetableMeetingList
      groups={groupedTimetableRecords}
      viewMode="window30"
      emptyLabel="No timetable meetings are listed in the selected timezone's current 30-day window. Use official source links for final confirmation."
    />
  </section>
</BaseLayout>
