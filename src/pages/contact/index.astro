---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Where Horses Run"
  description="Contact Where Horses Run through the support form."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Contact</p>
    <h1 id="page-title">Contact</h1>
    <p class="hero__summary">Questions about the site, data, privacy, or future payments can be sent through the contact form.</p>
  </section>

  <section class="section-grid" aria-label="Contact information">
    <article class="card">
      <h2>Contact form</h2>
      <p>The Google Form link will be added here before optional payments are enabled.</p>
      <p><strong>Payment processing is not currently enabled.</strong></p>
    </article>
    <article class="card">
      <h2>What to include</h2>
      <p>For payment questions, include the payment date, amount, currency, and a short description of the issue. Do not submit full card numbers or sensitive authentication information.</p>
    </article>
  </section>
</BaseLayout>
