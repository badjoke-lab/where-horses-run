---
import RacecourseDetailPageV3 from '../../components/RacecourseDetailPageV3.astro';
import { getRacecourseBySlug, getRacecourses } from '../../lib/data';

export function getStaticPaths() {
  return getRacecourses().map((track) => ({ params: { slug: track.slug } }));
}

const { slug } = Astro.params;
const track = getRacecourseBySlug(slug ?? '');

if (!track) {
  return Astro.redirect('/tracks/');
}
---

<RacecourseDetailPageV3 track={track} locale="en" />
