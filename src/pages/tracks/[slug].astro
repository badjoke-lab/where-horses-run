---
import RacecourseHubPage from '../../components/RacecourseHubPage.astro';
import { getRacecourseBySlug, getRacecourses } from '../../lib/data';
import { isPublicActiveRacecourse } from '../../lib/racecoursePublicSupport';

export function getStaticPaths() {
  return getRacecourses()
    .filter((track) => isPublicActiveRacecourse(track))
    .map((track) => ({ params: { slug: track.slug } }));
}

const { slug } = Astro.params;
const track = getRacecourseBySlug(slug ?? '');

if (!track || !isPublicActiveRacecourse(track)) {
  return Astro.redirect('/tracks/');
}
---

<RacecourseHubPage track={track} locale="en" />
