---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForWindow,
} from '../data/timetableMeetingRows';
import { addCalendarDays } from '../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const candidateStart = addCalendarDays(context.today, -2);
const candidateEndExclusive = addCalendarDays(context.today, 4);
const tomorrowCandidates = getTimetableMeetingRowsForWindow(candidateStart, candidateEndExclusive);
---

<BaseLayout
  title={`Tomorrow's racing — ${context.tomorrow} | Where Horses Run`}
  description={`See racing listed for ${context.tomorrow}, including available race times and links to official sources.`}
  canonicalPath="/tomorrow/"
  alternatePath="/ja/tomorrow/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Tomorrow’s racing</p>
    <h1 id="page-title">Tomorrow’s racing</h1>
    <p class="hero__summary">
      Meetings listed for <span data-timezone-target-date>{context.tomorrow}</span> in <span data-timezone-label>{context.timeZone}</span>. Available race times are converted to the selected display timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} displayDate={context.tomorrow} />

  <section aria-label="Tomorrow meeting list">
    <TimetableMeetingList
      records={tomorrowCandidates}
      date={context.tomorrow}
      scope="tomorrow"
      emptyLabel="No meetings are currently listed for tomorrow in the selected display timezone. Check official sources for the latest information."
    />
  </section>
</BaseLayout>
