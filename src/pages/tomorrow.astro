---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableProjectionCandidateRows,
} from '../data/timetableMeetingRows';
import { addCalendarDays } from '../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const projectionCandidates = getTimetableProjectionCandidateRows(
  context.tomorrow,
  addCalendarDays(context.tomorrow, 1),
);
---

<BaseLayout
  title={`Tomorrow's racing — ${context.tomorrow} | Where Horses Run`}
  description="Tomorrow's racing in the visitor-selected display timezone, including available race times and official links."
  canonicalPath="/tomorrow/"
  alternatePath="/ja/tomorrow/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Tomorrow’s racing</p>
    <h1 id="page-title">Tomorrow’s racing</h1>
    <p class="hero__summary">
      Select a display timezone below. Meeting membership, dates and available race times follow that timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} displayDate={context.tomorrow} />

  <section aria-label="Tomorrow meeting list">
    <TimetableMeetingList
      records={projectionCandidates}
      date={context.tomorrow}
      viewMode="tomorrow"
      emptyLabel="No meetings are currently listed for tomorrow in the selected timezone. Check official sources for the latest information."
    />
  </section>
</BaseLayout>
