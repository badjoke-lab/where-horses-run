---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import CalendarOperationsNotice from '../components/CalendarOperationsNotice.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForDate,
  getTimetableProjectionCandidateRows,
} from '../data/timetableMeetingRows';
import { addCalendarDays } from '../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const tomorrowRecords = getTimetableMeetingRowsForDate(context.tomorrow);
const projectionCandidates = getTimetableProjectionCandidateRows(
  context.tomorrow,
  addCalendarDays(context.tomorrow, 1),
);
---

<BaseLayout
  title={`Tomorrow's timetable — ${context.tomorrow} | Where Horses Run`}
  description="Reviewed public meeting information for tomorrow in the visitor-selected display timezone."
  canonicalPath="/tomorrow/"
  alternatePath="/ja/tomorrow/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Tomorrow</p>
    <h1 id="page-title">Tomorrow's timetable</h1>
    <p class="hero__summary">
      Select a display timezone below. Meeting membership, dates and available race times are projected into that timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} />
  <CalendarOperationsNotice records={tomorrowRecords} dataState={dataState} />

  <section aria-label="Tomorrow meeting list">
    <TimetableMeetingList
      records={projectionCandidates}
      date={context.tomorrow}
      viewMode="tomorrow"
      emptyLabel="No reviewed public meetings are listed for tomorrow in the selected timezone. Check official sources for current information."
    />
  </section>
</BaseLayout>
