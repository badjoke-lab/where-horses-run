---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About | Where Horses Run"
  description="About Where Horses Run and the racing information you can find here."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">About</p>
    <h1 id="page-title">About Where Horses Run</h1>
    <p class="hero__summary">
      Find horse-racing dates, race times, racecourses, racing types, and official information from around the world.
    </p>
  </section>

  <section class="section-grid" aria-label="About Where Horses Run">
    <article class="card">
      <h2>What you can find</h2>
      <p>Browse racing by date, country or region, racecourse, racing type, glossary term, and official source.</p>
    </article>
    <article class="card">
      <h2>Official information</h2>
      <p>Official organizers, regulators, racecourses, and other official providers are the main reference for current schedules and late changes.</p>
    </article>
    <article class="card">
      <h2>What this site is not</h2>
      <p>Where Horses Run is not a racecard, results, payout, or betting service. Those details remain with official services.</p>
    </article>
    <article class="card">
      <h2>More information</h2>
      <p><a href="/methods/">Information Policy</a> · <a href="/about/data-coverage/">Data Coverage</a> · <a href="/faq/">FAQ</a> · <a href="/disclaimer/">Disclaimer</a></p>
    </article>
  </section>
</BaseLayout>
