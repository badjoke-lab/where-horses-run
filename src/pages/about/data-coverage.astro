---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountryCoverageMatrix from '../../components/CountryCoverageMatrix.astro';
---

<BaseLayout
  title="Data Coverage | Where Horses Run"
  description="See the racing information currently listed for Japan, Hong Kong, the United Arab Emirates, South Korea, Türkiye, and Morocco."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Data coverage</p>
    <h1 id="page-title">Listed racing data by country</h1>
    <p class="hero__summary">
      Compare the meetings, dates, racecourses, race times, and race details currently listed for selected countries and regions.
    </p>
  </section>

  <section aria-labelledby="matrix-title">
    <h2 id="matrix-title">Current listed data</h2>
    <p>The table currently covers Japan, Hong Kong, the United Arab Emirates, South Korea, Türkiye, and Morocco.</p>
    <CountryCoverageMatrix />
  </section>

  <section class="section-grid" aria-label="How to read the data coverage page">
    <article class="card">
      <h2>Different countries have different detail</h2>
      <p>Some countries have meeting dates only, while others also have race times or race-level information.</p>
    </article>
    <article class="card">
      <h2>An empty count does not mean no racing</h2>
      <p>It means this site does not currently list that type of information for the country. Check the official source for the latest schedule.</p>
    </article>
    <article class="card">
      <h2>Official sources remain the latest reference</h2>
      <p>Meeting dates and times can change. Use the linked official sources when you need the latest information.</p>
    </article>
  </section>

  <p><a href="/calendar/">Calendar</a> · <a href="/sources/">Official Sources</a> · <a href="/methods/">Information Policy</a></p>
</BaseLayout>
