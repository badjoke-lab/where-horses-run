---
import CountryDetailPage from '../../components/CountryDetailPage.astro';
import { getCountries, getCountryBySlug } from '../../lib/data';
import { isCalendarSupportedCountry } from '../../lib/calendarPublicCountrySupport';

export function getStaticPaths() {
  return getCountries()
    .filter((country) => isCalendarSupportedCountry(country.id))
    .map((country) => ({ params: { slug: country.slug } }));
}

const { slug } = Astro.params;
const country = getCountryBySlug(slug ?? '');

if (!country || !isCalendarSupportedCountry(country.id)) {
  return Astro.redirect('/countries/');
}
---

<CountryDetailPage country={country} locale="en" />
