---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendarCoverageDashboard from '../../components/CalendarCoverageDashboard.astro';
import CalendarDateFocus from '../../components/CalendarDateFocus.astro';
import CalendarDateStatus from '../../components/CalendarDateStatus.astro';
import CalendarFilters from '../../components/CalendarFilters.astro';
import CalendarLivePlayers from '../../components/CalendarLivePlayers.astro';
import TimetableMeetingList from '../../components/TimetableMeetingList.astro';
import {
  getCurrentCalendarWindowGroups,
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableProjectionCandidateGroups,
} from '../../data/timetableMeetingRows';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
// Retain the canonical source-window helper while display membership is projected client-side.
void getCurrentCalendarWindowGroups;
const groups = getTimetableProjectionCandidateGroups(context.windowStart, context.windowEndExclusive);
const windowRecords = groups.flatMap((group) => group.records);
const serverReferenceTimeZone = context.timeZone;
---

<BaseLayout
  title={`30-day racing calendar | Where Horses Run`}
  description={`See racing listed from ${context.windowStart} through ${context.windowEndInclusive}.`}
  canonicalPath="/calendar/"
  alternatePath="/ja/calendar/"
>
  <section class="hero" aria-labelledby="page-title" data-server-reference-timezone={serverReferenceTimeZone}>
    <p class="hero__eyebrow">Racing calendar</p>
    <h1 id="page-title">30-day racing calendar</h1>
    <p class="hero__summary">
      Choose a display timezone below. Meeting dates and available race times are converted to that timezone, and the rolling 30-day membership follows it.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} />
  <CalendarCoverageDashboard />
  <CalendarDateFocus />
  <CalendarFilters records={windowRecords} />
  <CalendarLivePlayers />

  <section aria-label="Rolling 30-day meeting list">
    <TimetableMeetingList
      groups={groups}
      viewMode="window30"
      emptyLabel={`No meetings are currently listed between ${context.windowStart} and ${context.windowEndInclusive}. Check official sources for the latest information.`}
    />
  </section>
</BaseLayout>
