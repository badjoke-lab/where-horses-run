---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendarCoverageDashboard from '../../components/CalendarCoverageDashboard.astro';
import CalendarDateNavigation from '../../components/CalendarDateNavigation.astro';
import CalendarDateStatus from '../../components/CalendarDateStatus.astro';
import CalendarFilters from '../../components/CalendarFilters.astro';
import CalendarLivePlayers from '../../components/CalendarLivePlayers.astro';
import CalendarMeetingMap from '../../components/CalendarMeetingMap.astro';
import CalendarSelectedCardEnhancer from '../../components/CalendarSelectedCardEnhancer.astro';
import CalendarViewControls from '../../components/CalendarViewControls.astro';
import MeetingStatePolicy from '../../components/MeetingStatePolicy.astro';
import TimetableMeetingList from '../../components/TimetableMeetingList.astro';
import {
  getGroupedTimetableMeetingRows,
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForWindow,
} from '../../data/timetableMeetingRows';
import { addCalendarDays } from '../../lib/timetable/calendarDateContext.mjs';
import '../../styles/calendar-presentation.css';
import '../../styles/calendar-mock-v1.css';
import '../../styles/racecourse-detail-mock-v1.css';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const candidateStart = addCalendarDays(context.windowStart, -2);
const candidateEndExclusive = addCalendarDays(context.windowEndExclusive, 2);
const candidateRecords = getTimetableMeetingRowsForWindow(candidateStart, candidateEndExclusive);
const groups = getGroupedTimetableMeetingRows(candidateRecords);
---

<BaseLayout
  title="30-day racing calendar | Where Horses Run"
  description={`Browse racing listed from ${context.windowStart} through ${context.windowEndInclusive} by list, month, or map.`}
  canonicalPath="/calendar/"
  alternatePath="/ja/calendar/"
>
  <div class="calendar-page">
    <MeetingStatePolicy />

    <section class="hero" aria-labelledby="page-title">
      <p class="hero__eyebrow">Racing calendar</p>
      <h1 id="page-title">Calendar</h1>
      <p class="hero__summary">
        Explore race meetings by date. Switch between List, Month, and Map views; times and date grouping use <span data-timezone-label>{context.timeZone}</span>.
      </p>
      <p class="calendar-page__window">
        <span data-timezone-window-start>{context.windowStart}</span> – <span data-timezone-window-end>{context.windowEndInclusive}</span>
      </p>
    </section>

    <CalendarViewControls
      startDate={context.windowStart}
      endDateInclusive={context.windowEndInclusive}
      today={context.today}
      records={candidateRecords}
    />

    <CalendarDateNavigation
      startDate={context.windowStart}
      endDateInclusive={context.windowEndInclusive}
      today={context.today}
    />

    <CalendarFilters records={candidateRecords} />
    <CalendarLivePlayers />

    <section aria-label="Rolling 30-day meeting list" data-calendar-list-view>
      <TimetableMeetingList
        groups={groups}
        scope="rolling-30"
        emptyLabel="No meetings are currently listed in the selected 30-day display window or active filters. Check official sources for the latest information."
      />
    </section>

    <CalendarMeetingMap records={candidateRecords} />
    <CalendarSelectedCardEnhancer />

    <section class="calendar-page__secondary" aria-labelledby="calendar-data-title">
      <h2 id="calendar-data-title">Calendar data coverage</h2>
      <CalendarDateStatus context={context} dataState={dataState} />
      <CalendarCoverageDashboard />
    </section>
  </div>
</BaseLayout>
