---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableProjectionCandidateRows,
} from '../data/timetableMeetingRows';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const projectionCandidates = getTimetableProjectionCandidateRows(context.today, context.tomorrow);
---

<BaseLayout
  title={`Today's racing — ${context.today} | Where Horses Run`}
  description="Today's racing in the visitor-selected display timezone, including available race times and official links."
  canonicalPath="/today/"
  alternatePath="/ja/today/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Today’s racing</p>
    <h1 id="page-title">Today’s racing</h1>
    <p class="hero__summary">
      Select a display timezone below. Meeting membership, dates and available race times follow that timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} displayDate={context.today} />

  <section aria-label="Today meeting list">
    <TimetableMeetingList
      records={projectionCandidates}
      date={context.today}
      viewMode="today"
      emptyLabel="No meetings are currently listed for today in the selected timezone. Check official sources for the latest information."
    />
  </section>
</BaseLayout>
