---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import CalendarOperationsNotice from '../components/CalendarOperationsNotice.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForDate,
  getTimetableProjectionCandidateRows,
} from '../data/timetableMeetingRows';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const todayRecords = getTimetableMeetingRowsForDate(context.today);
const projectionCandidates = getTimetableProjectionCandidateRows(context.today, context.tomorrow);
---

<BaseLayout
  title={`Today's timetable — ${context.today} | Where Horses Run`}
  description={`Reviewed public meeting information for today. Display dates and times follow the visitor-selected timezone; official sources remain the final confirmation point.`}
  canonicalPath="/today/"
  alternatePath="/ja/today/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Today</p>
    <h1 id="page-title">Today's timetable</h1>
    <p class="hero__summary">
      Select a display timezone below. Meeting membership, dates and available race times are projected into that timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} />
  <CalendarOperationsNotice records={todayRecords} dataState={dataState} />

  <section aria-label="Today meeting list">
    <TimetableMeetingList
      records={projectionCandidates}
      date={context.today}
      viewMode="today"
      emptyLabel="No reviewed public meetings are listed for today in the selected timezone. Check official sources for current information."
    />
  </section>
</BaseLayout>
