---
const target = '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Today is now the default Home racing view." />
    <meta property="og:title" content="Today moved | Where Horses Run" />
    <meta property="og:description" content="Today is now the default Home racing view." />
    <meta name="twitter:title" content="Today moved | Where Horses Run" />
    <meta name="twitter:description" content="Today is now the default Home racing view." />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://whr.badjoke-lab.com/" />
    <title>Today moved | Where Horses Run</title>
  </head>
  <body>
    <p>Today is now the default Home view. <a href={target}>Open Home</a>.</p>
    <script is:inline>
      const url = new URL('/', window.location.origin);
      const current = new URL(window.location.href);
      current.searchParams.forEach((value, key) => url.searchParams.set(key, value));
      url.searchParams.delete('range');
      window.location.replace(`${url.pathname}${url.search}`);
    </script>
  </body>
</html>
