---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarDateStatus from '../components/CalendarDateStatus.astro';
import TimetableMeetingList from '../components/TimetableMeetingList.astro';
import {
  getTimetableDataState,
  getTimetableDateContext,
  getTimetableMeetingRowsForWindow,
} from '../data/timetableMeetingRows';
import { addCalendarDays } from '../lib/timetable/calendarDateContext.mjs';

const context = getTimetableDateContext();
const dataState = getTimetableDataState(context);
const candidateStart = addCalendarDays(context.today, -2);
const candidateEndExclusive = addCalendarDays(context.today, 4);
const todayCandidates = getTimetableMeetingRowsForWindow(candidateStart, candidateEndExclusive);
---

<BaseLayout
  title={`Today's racing — ${context.today} | Where Horses Run`}
  description={`See racing listed for ${context.today}, including available race times and links to official sources.`}
  canonicalPath="/today/"
  alternatePath="/ja/today/"
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Today’s racing</p>
    <h1 id="page-title">Today’s racing</h1>
    <p class="hero__summary">
      Meetings listed for <span data-timezone-target-date>{context.today}</span> in <span data-timezone-label>{context.timeZone}</span>. Available race times are converted to the selected display timezone.
    </p>
  </section>

  <CalendarDateStatus context={context} dataState={dataState} displayDate={context.today} />

  <section aria-label="Today meeting list">
    <TimetableMeetingList
      records={todayCandidates}
      date={context.today}
      scope="today"
      emptyLabel="No meetings are currently listed for today in the selected display timezone. Check official sources for the latest information."
    />
  </section>
</BaseLayout>
