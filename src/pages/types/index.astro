---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRacecoursesByRacingTypeId, getRacingTypes } from '../../lib/racingTypes';

const racingTypes = getRacingTypes();
---

<BaseLayout
  title="Racing Types | Where Horses Run"
  description="Explore flat racing, jump racing, harness racing, and other horse racing formats, with links to related racecourses."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">Racing formats</p>
    <h1 id="page-title">Racing Types</h1>
    <p class="hero__summary">
      Learn how major racing formats differ and find racecourses where each type is held.
    </p>
  </section>

  <section class="section-grid" aria-label="Racing type list">
    {racingTypes.map((type) => {
      const tracks = getRacecoursesByRacingTypeId(type.id);
      return (
        <article class="card">
          <h2><a href={`/types/${type.slug}/`}>{type.name_en}</a></h2>
          <p>{type.summary_en}</p>
          <p><strong>Related racecourses:</strong> {tracks.length}</p>
        </article>
      );
    })}
  </section>
</BaseLayout>
