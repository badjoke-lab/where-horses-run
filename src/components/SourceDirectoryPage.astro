---
import BaseLayout from '../layouts/BaseLayout.astro';
import type {
  SourceDirectoryLocale,
  SourceFilterOptions,
  SourceFilterRecord,
} from '../lib/source-filter-data';

interface Props {
  locale: SourceDirectoryLocale;
  records: SourceFilterRecord[];
  options: SourceFilterOptions;
}

const { locale, records, options } = Astro.props;
const isJapanese = locale === 'ja';
---

<BaseLayout
  title={isJapanese ? '公式情報源 | 競馬どこ？' : 'Official Sources | Where Horses Run'}
  description={isJapanese
    ? '競馬の日程、競馬場、開催情報を確認できる公式サイトを、名称や国・地域から探せます。'
    : 'Find official websites for checking racing schedules, racecourses, and meeting information by name or country.'}
  lang={locale}
  canonicalPath={isJapanese ? '/ja/sources/' : '/sources/'}
  alternatePath={isJapanese ? '/sources/' : '/ja/sources/'}
>
  <div
    data-source-directory
    data-source-records={records.length}
    data-source-country-options={options.countries.length}
    data-source-filter-controls="2"
    data-source-url-parameters="2"
  >
    <section class="hero" aria-labelledby="page-title">
      <p class="hero__eyebrow">{isJapanese ? '公式サイト' : 'Official websites'}</p>
      <h1 id="page-title">{isJapanese ? '公式情報源' : 'Official Sources'}</h1>
      <p class="hero__summary">
        {isJapanese
          ? '競馬の日程や競馬場、開催内容を確認できる公式サイトをまとめています。'
          : 'Official websites where you can check racing schedules, racecourses, and meeting details.'}
      </p>
    </section>

    <section class="card" aria-labelledby="source-filter-heading">
      <h2 id="source-filter-heading">{isJapanese ? '公式サイトを探す' : 'Find an official source'}</h2>
      <form data-source-filter-form role="search">
        <p>
          <label for="source-filter-query"><strong>{isJapanese ? '名称・キーワード' : 'Name or keyword'}</strong></label><br />
          <input
            id="source-filter-query"
            name="q"
            type="search"
            autocomplete="off"
            placeholder={isJapanese ? '例：JRA、開催日程、競馬場' : 'Example: JRA, calendar, racecourse'}
            data-source-filter-query
          />
        </p>
        <p>
          <label for="source-filter-country"><strong>{isJapanese ? '国・地域' : 'Country or region'}</strong></label><br />
          <select id="source-filter-country" name="country" data-source-filter-country>
            <option value="all">{isJapanese ? 'すべての国・地域' : 'All countries and regions'}</option>
            {options.countries.map((country) => <option value={country.id}>{country.label}</option>)}
          </select>
        </p>
        <p>
          <button type="submit">{isJapanese ? '適用' : 'Apply filters'}</button>{' '}
          <button type="button" data-source-filter-reset>{isJapanese ? '条件を解除' : 'Clear filters'}</button>
        </p>
      </form>
      <p aria-live="polite" data-source-filter-count>
        {isJapanese ? `${records.length}件を表示中` : `Showing ${records.length} records`}
      </p>
      <noscript>
        <p>{isJapanese
          ? 'JavaScriptが無効な場合も、下の一覧から公式サイトを選べます。'
          : 'With JavaScript disabled, the complete list of official sources remains available below.'}</p>
      </noscript>
    </section>

    <section class="section-grid" aria-label={isJapanese ? '公式情報源一覧' : 'Official source list'} data-source-filter-results>
      {records.map((record) => (
        <article
          class="card"
          data-source-record
          data-source-id={record.id}
          data-source-country={record.countryId}
          data-source-search-text={record.searchText}
        >
          <h2><a href={record.url}>{record.id}</a></h2>
          <p>
            <strong>{isJapanese ? '国・地域' : 'Country or region'}:</strong>{' '}
            {record.countryHref ? <a href={record.countryHref}>{record.countryName}</a> : record.countryName}
          </p>
          <p>{record.notes}</p>
        </article>
      ))}
    </section>

    <section class="card" data-source-filter-empty hidden>
      <h2>{isJapanese ? '該当する公式サイトがありません' : 'No matching official sources'}</h2>
      <p>{isJapanese
        ? 'キーワードを短くするか、国・地域を「すべて」に戻してください。'
        : 'Try a shorter keyword or reset the country filter to All.'}</p>
    </section>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-source-directory]');
      if (!root) return;

      const form = root.querySelector('[data-source-filter-form]');
      const queryInput = root.querySelector('[data-source-filter-query]');
      const countrySelect = root.querySelector('[data-source-filter-country]');
      const resetButton = root.querySelector('[data-source-filter-reset]');
      const count = root.querySelector('[data-source-filter-count]');
      const empty = root.querySelector('[data-source-filter-empty]');
      const records = [...root.querySelectorAll('[data-source-record]')];
      const isJapanese = document.documentElement.lang === 'ja';

      if (!form || !queryInput || !countrySelect || !resetButton || !count || !empty) return;

      const normalize = (value) => value
        .normalize('NFKC')
        .toLocaleLowerCase()
        .replace(/\s+/g, ' ')
        .trim();

      const params = new URLSearchParams(window.location.search);
      queryInput.value = params.get('q') ?? '';
      const requestedCountry = params.get('country') ?? 'all';
      if ([...countrySelect.options].some((option) => option.value === requestedCountry)) {
        countrySelect.value = requestedCountry;
      }

      const apply = () => {
        const query = normalize(queryInput.value);
        const country = countrySelect.value;
        let visible = 0;

        for (const record of records) {
          const show =
            (!query || (record.dataset.sourceSearchText ?? '').includes(query)) &&
            (country === 'all' || record.dataset.sourceCountry === country);
          record.hidden = !show;
          if (show) visible += 1;
        }

        count.textContent = isJapanese ? `${visible}件を表示中` : `Showing ${visible} records`;
        empty.hidden = visible !== 0;

        const next = new URLSearchParams();
        if (queryInput.value.trim()) next.set('q', queryInput.value.trim());
        if (country !== 'all') next.set('country', country);
        const nextUrl = `${window.location.pathname}${next.size ? `?${next}` : ''}`;
        window.history.replaceState(null, '', nextUrl);
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        apply();
      });
      queryInput.addEventListener('input', apply);
      countrySelect.addEventListener('change', apply);
      resetButton.addEventListener('click', () => {
        queryInput.value = '';
        countrySelect.value = 'all';
        apply();
        queryInput.focus();
      });
      apply();
    })();
  </script>
</BaseLayout>
