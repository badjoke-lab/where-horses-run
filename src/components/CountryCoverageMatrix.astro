---
import { getCoverageDashboardCountries } from '../lib/timetable/coverageDashboard';

type Props = { lang?: 'en' | 'ja' };
const { lang = 'en' } = Astro.props as Props;
const countries = getCoverageDashboardCountries();
const isJa = lang === 'ja';
const copy = isJa
  ? {
      country: '国・地域',
      meetings: '掲載開催',
      dates: '掲載日付',
      racecourses: '競馬場',
      times: '時刻あり開催',
      races: '掲載レース',
      caption: '国・地域別の掲載データ',
    }
  : {
      country: 'Country or region',
      meetings: 'Listed meetings',
      dates: 'Listed dates',
      racecourses: 'Racecourses',
      times: 'Meetings with times',
      races: 'Listed races',
      caption: 'Listed data by country or region',
    };
---

<div class="country-table-wrap" data-country-coverage-matrix>
  <table class="country-table">
    <caption>{copy.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{copy.country}</th>
        <th scope="col">{copy.meetings}</th>
        <th scope="col">{copy.dates}</th>
        <th scope="col">{copy.racecourses}</th>
        <th scope="col">{copy.times}</th>
        <th scope="col">{copy.races}</th>
      </tr>
    </thead>
    <tbody>
      {countries.map((country) => (
        <tr data-coverage-country={country.country_id}>
          <th scope="row" data-label={copy.country}>{isJa ? country.country_label_ja : country.country_label}</th>
          <td data-label={copy.meetings}>{country.public.meetings}</td>
          <td data-label={copy.dates}>{country.public.dates}</td>
          <td data-label={copy.racecourses}>{country.public.racecourses}</td>
          <td data-label={copy.times}>{country.public.meetings_with_times}</td>
          <td data-label={copy.races}>{country.public.event_rows}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
