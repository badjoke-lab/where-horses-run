<script is:inline>
  (() => {
    const TIMED_RANKS = new Set(['A+', 'A', 'B+']);

    const isTimeZoneSupported = (timeZone) => {
      if (!timeZone) return false;
      try { new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0)); return true; } catch { return false; }
    };

    const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
      timeZone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));

    const formatDate = (instant, timeZone) => {
      const parts = dateParts(instant, timeZone);
      return `${parts.year}-${parts.month}-${parts.day}`;
    };

    const localDateTimeToInstant = (dateText, timeText, timeZone) => {
      const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
      const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
      if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
      const targetUtc = Date.UTC(
        Number(dateMatch[1]),
        Number(dateMatch[2]) - 1,
        Number(dateMatch[3]),
        Number(timeMatch[1]),
        Number(timeMatch[2]),
        Number(timeMatch[3] ?? '0'),
      );
      let guess = targetUtc;
      for (let pass = 0; pass < 4; pass += 1) {
        const parts = dateParts(new Date(guess), timeZone);
        const representedUtc = Date.UTC(
          Number(parts.year),
          Number(parts.month) - 1,
          Number(parts.day),
          Number(parts.hour),
          Number(parts.minute),
          Number(parts.second),
        );
        const correction = targetUtc - representedUtc;
        guess += correction;
        if (correction === 0) break;
      }
      return new Date(guess);
    };

    const displayTimeZoneForRow = (row) => {
      const root = row.closest('[data-display-timezone-root]');
      const select = root?.querySelector('[data-display-timezone-select]');
      if (select instanceof HTMLSelectElement && isTimeZoneSupported(select.value)) return select.value;
      return isTimeZoneSupported(row.dataset.sourceTimezone) ? row.dataset.sourceTimezone : 'Asia/Tokyo';
    };

    const setBadges = (row, state, policy) => {
      const root = row.closest('[data-display-timezone-root]');
      const isJa = root?.dataset.lang === 'ja';
      const upcoming = row.querySelector('[data-meeting-upcoming-badge]');
      const running = row.querySelector('[data-meeting-running-badge]');
      const ended = row.querySelector('[data-meeting-ended-badge]');
      if (upcoming instanceof HTMLElement) {
        upcoming.textContent = policy === 'day'
          ? (isJa ? '本日開催' : 'Racing today')
          : (isJa ? '開催前' : 'Upcoming');
        upcoming.hidden = state !== 'upcoming';
      }
      if (running instanceof HTMLElement) running.hidden = state !== 'running';
      if (ended instanceof HTMLElement) ended.hidden = state !== 'ended';
    };

    const applyToRow = (row, now = Date.now()) => {
      if (!(row instanceof HTMLElement)) return;
      const sourceDate = row.dataset.sourceDate || '';
      const sourceTimeZone = row.dataset.sourceTimezone || '';
      const rank = row.dataset.rank || '';
      const firstTime = row.dataset.firstRaceTime || '';
      const lastTime = row.dataset.lastRaceTime || '';
      if (!sourceDate || !isTimeZoneSupported(sourceTimeZone)) return;

      const displayTimeZone = displayTimeZoneForRow(row);
      const displayedDate = row.dataset.date || sourceDate;
      const currentDisplayDate = formatDate(new Date(now), displayTimeZone);
      const calendarDayState = displayedDate < currentDisplayDate ? 'past' : displayedDate > currentDisplayDate ? 'future' : 'today';
      row.dataset.meetingCalendarDayState = calendarDayState;

      const timed = TIMED_RANKS.has(rank) && Boolean(firstTime && lastTime);
      const policy = timed ? 'timed' : 'day';
      let state = 'future';

      if (calendarDayState === 'past') {
        state = 'ended';
      } else if (calendarDayState === 'future') {
        state = 'future';
      } else if (timed) {
        const start = localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone);
        const rawEnd = localDateTimeToInstant(sourceDate, lastTime, sourceTimeZone);
        if (start && rawEnd) {
          let endMs = rawEnd.getTime();
          if (endMs < start.getTime()) endMs += 86_400_000;
          row.dataset.sortStart = String(start.getTime());
          state = now < start.getTime() ? 'upcoming' : now <= endMs ? 'running' : 'ended';
        } else {
          state = 'upcoming';
        }
      } else {
        state = 'upcoming';
      }

      row.dataset.meetingState = state;
      row.dataset.meetingStatePolicy = policy;
      row.dataset.meetingDayState = calendarDayState;
      setBadges(row, state, policy);
    };

    const patchLegendCopy = () => {
      document.querySelectorAll('.racecourse-map__legend-label--ja').forEach((node) => {
        if (node.textContent?.trim() === '今日これから') node.textContent = '開催前 / 本日開催';
      });
      document.querySelectorAll('.racecourse-map__legend-label--en').forEach((node) => {
        if (node.textContent?.trim() === 'Later today') node.textContent = 'Upcoming / racing today';
      });
    };

    const syncSelectedMapStatus = () => {
      const selected = document.querySelector('.meeting-row--map-selected:not([hidden])');
      const target = document.querySelector('[data-today-map-selected-status]');
      if (!(selected instanceof HTMLElement) || !(target instanceof HTMLElement)) return;
      const isJa = document.documentElement.lang === 'ja';
      const state = selected.dataset.meetingState || 'future';
      const policy = selected.dataset.meetingStatePolicy || 'day';
      target.dataset.status = state === 'upcoming' ? 'upcoming' : state;
      target.textContent = state === 'running'
        ? (isJa ? '開催中' : 'Racing now')
        : state === 'ended'
          ? (isJa ? '終了' : 'Finished')
          : state === 'upcoming'
            ? (policy === 'day' ? (isJa ? '本日開催' : 'Racing today') : (isJa ? '開催前' : 'Upcoming'))
            : (isJa ? '開催予定' : 'Scheduled');
    };

    const applyAll = () => {
      document.querySelectorAll('[data-calendar-meeting-row]').forEach((row) => applyToRow(row));
      patchLegendCopy();
      syncSelectedMapStatus();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applyAll, { once: true });
    else applyAll();

    window.addEventListener('whr:meetingstatechange', applyAll);
    window.addEventListener('whr:timezonechange', applyAll);
    window.addEventListener('whr:todayfilterchange', applyAll);
    document.addEventListener('racecourse-map:select', () => requestAnimationFrame(syncSelectedMapStatus));
    window.setInterval(applyAll, 60_000);
  })();
</script>

<style is:global>
  .meeting-row[data-meeting-state='upcoming'] {
    background: #fff3c4;
    box-shadow: inset .25rem 0 0 #d18a00;
    opacity: 1;
  }

  .meeting-row[data-meeting-state='running'] {
    background: #fff0ef;
    box-shadow: inset .25rem 0 0 #c40000;
    opacity: 1;
  }

  .meeting-row[data-meeting-state='ended'] {
    background: #f3f3f3;
    box-shadow: none;
    opacity: .58;
  }

  .meeting-row[data-meeting-state='future'] {
    background: #fff;
    box-shadow: none;
    opacity: 1;
  }
</style>
