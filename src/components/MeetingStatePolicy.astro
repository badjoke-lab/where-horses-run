<script>
  import {
    deriveMeetingLifecycleState,
    isTimeZoneSupported,
  } from '../lib/timetable/meetingLifecycleState.mjs';
  import { deriveMeetingPresentationState } from '../lib/timetable/meetingPresentationState.mjs';

  const displayTimeZoneForRow = (row) => {
    const root = row.closest('[data-display-timezone-root]');
    const select = root?.querySelector('[data-display-timezone-select]');
    if (select instanceof HTMLSelectElement && isTimeZoneSupported(select.value)) return select.value;
    return isTimeZoneSupported(row.dataset.sourceTimezone) ? row.dataset.sourceTimezone : 'Asia/Tokyo';
  };

  const ensureFutureBadge = (row) => {
    const existing = row.querySelector('[data-meeting-future-badge]');
    if (existing instanceof HTMLElement) return existing;
    const links = row.querySelector('.meeting-row__links');
    if (!(links instanceof HTMLElement)) return null;
    const badge = document.createElement('span');
    badge.className = 'meeting-row__meeting-badge meeting-row__meeting-badge--future';
    badge.dataset.meetingFutureBadge = 'true';
    badge.textContent = document.documentElement.lang === 'ja' ? '開催予定' : 'Scheduled';
    badge.hidden = true;
    links.prepend(badge);
    return badge;
  };

  const setBadges = (row, presentationState) => {
    const today = row.querySelector('[data-meeting-today-badge]');
    const upcoming = row.querySelector('[data-meeting-upcoming-badge]');
    const running = row.querySelector('[data-meeting-running-badge]');
    const ended = row.querySelector('[data-meeting-ended-badge]');
    const future = ensureFutureBadge(row);
    if (today instanceof HTMLElement) today.hidden = presentationState !== 'today';
    if (upcoming instanceof HTMLElement) upcoming.hidden = presentationState !== 'upcoming';
    if (running instanceof HTMLElement) running.hidden = presentationState !== 'running';
    if (ended instanceof HTMLElement) ended.hidden = presentationState !== 'ended';
    if (future instanceof HTMLElement) future.hidden = presentationState !== 'future';
  };

  const applyToRow = (row, now = Date.now()) => {
    if (!(row instanceof HTMLElement)) return;
    const sourceDate = row.dataset.sourceDate || '';
    const sourceTimeZone = row.dataset.sourceTimezone || '';
    if (!sourceDate || !isTimeZoneSupported(sourceTimeZone)) {
      row.dataset.meetingCalendarDayState = 'unknown';
      row.dataset.meetingDayState = 'unknown';
      row.dataset.meetingState = 'unknown';
      row.dataset.meetingPresentationState = 'unknown';
      row.dataset.meetingStatePolicy = 'invalid';
      delete row.dataset.sortStart;
      setBadges(row, 'unknown');
      return;
    }

    const displayTimeZone = displayTimeZoneForRow(row);
    const displayedDate = row.dataset.date || sourceDate;
    const result = deriveMeetingLifecycleState({
      displayedDate,
      displayTimeZone,
      sourceDate,
      sourceTimeZone,
      firstTime: row.dataset.firstRaceTime || '',
      lastTime: row.dataset.lastRaceTime || '',
      nowMs: now,
    });

    // Day relation follows the selected presentation timezone. Lifecycle truth
    // follows the reviewed source/venue-local instants inside the shared helper.
    row.dataset.meetingCalendarDayState = result.calendarDayState;
    row.dataset.meetingDayState = result.calendarDayState;
    row.dataset.meetingState = result.state;
    row.dataset.meetingStatePolicy = result.policy;
    row.dataset.meetingPresentationState = deriveMeetingPresentationState({
      rank: row.dataset.rank || '',
      calendarDayState: result.calendarDayState,
      lifecycleState: result.state,
    });
    if (result.sortStartMs === null) delete row.dataset.sortStart;
    else row.dataset.sortStart = String(result.sortStartMs);
    setBadges(row, row.dataset.meetingPresentationState);
  };

  const presentationLabel = (state, isJa) => state === 'running'
    ? (isJa ? '開催中' : 'Racing now')
    : state === 'today'
      ? (isJa ? '本日開催' : 'Today meeting')
      : state === 'upcoming'
        ? (isJa ? '開催前' : 'Upcoming')
        : state === 'ended'
          ? (isJa ? '終了' : 'Finished')
          : state === 'future'
            ? (isJa ? '開催予定' : 'Scheduled')
            : (isJa ? '時刻未確認' : 'Time not confirmed');

  const syncSelectedMapStatus = () => {
    const selected = document.querySelector('.meeting-row--map-selected:not([hidden])');
    const target = document.querySelector('[data-today-map-selected-status]');
    if (!(selected instanceof HTMLElement) || !(target instanceof HTMLElement)) return;
    const isJa = document.documentElement.lang === 'ja';
    const state = selected.dataset.meetingPresentationState || 'unknown';
    target.dataset.status = state;
    target.textContent = presentationLabel(state, isJa);
  };

  const LEGEND_COPY = {
    running: { en: 'Racing now', ja: '開催中' },
    upcoming: { en: 'Upcoming', ja: '開催前' },
    today: { en: 'Today meeting', ja: '本日開催' },
    future: { en: 'Scheduled', ja: '開催予定' },
    ended: { en: 'Finished', ja: '終了' },
  };
  const CURRENT_DAY_LEGEND = ['running', 'upcoming', 'today', 'ended'];
  const ALL_CONTEXT_LEGEND = ['running', 'upcoming', 'today', 'future', 'ended'];
  const observedMapRoots = new WeakSet();

  const visibleRows = () => [...document.querySelectorAll('[data-calendar-meeting-row]')]
    .filter((row) => row instanceof HTMLElement)
    .filter((row) => !row.hidden && row.dataset.timezoneScopeHidden !== 'true' && getComputedStyle(row).display !== 'none');

  const normalizeLegendCopy = (legend) => {
    Object.entries(LEGEND_COPY).forEach(([state, copy]) => {
      const item = legend.querySelector(`[data-map-legend-state="${state}"]`);
      if (!(item instanceof HTMLElement)) return;
      const en = item.querySelector('.racecourse-map__legend-label--en');
      const ja = item.querySelector('.racecourse-map__legend-label--ja');
      if (en && en.textContent !== copy.en) en.textContent = copy.en;
      if (ja && ja.textContent !== copy.ja) ja.textContent = copy.ja;
    });
  };

  const allowedLegendStates = (mapRoot) => {
    const todayContext = mapRoot.closest('[data-today-map-sync]');
    if (todayContext instanceof HTMLElement) {
      const rows = visibleRows();
      if (rows.length === 0) return [];
      const selected = document.querySelector('[data-today-controls] [data-meeting-range][aria-pressed="true"]');
      const range = selected instanceof HTMLElement ? selected.dataset.meetingRange || 'today' : 'today';
      if (range === 'tomorrow') return ['future'];
      if (range === 'next7') return ALL_CONTEXT_LEGEND;
      return CURRENT_DAY_LEGEND;
    }

    const calendarContext = mapRoot.closest('[data-calendar-map-switch]');
    if (calendarContext instanceof HTMLElement) {
      const select = document.querySelector('[data-filter-date]');
      const selectedDate = select instanceof HTMLSelectElement ? select.value : '';
      const rows = visibleRows().filter((row) => row.dataset.date === selectedDate);
      if (rows.length === 0) return [];
      return rows.every((row) => row.dataset.meetingPresentationState === 'future')
        ? ['future']
        : CURRENT_DAY_LEGEND;
    }

    return [];
  };

  const syncLegendForRoot = (mapRoot) => {
    if (!(mapRoot instanceof HTMLElement) || mapRoot.dataset.mapState !== 'ready') return;
    const legend = mapRoot.querySelector('[data-map-legend]');
    if (!(legend instanceof HTMLElement)) return;
    normalizeLegendCopy(legend);
    const allowed = new Set(allowedLegendStates(mapRoot));
    legend.querySelectorAll('[data-map-legend-state]').forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const shouldHide = !allowed.has(item.dataset.mapLegendState || '');
      if (item.hidden !== shouldHide) item.hidden = shouldHide;
    });
    const shouldHideLegend = allowed.size === 0;
    if (legend.hidden !== shouldHideLegend) legend.hidden = shouldHideLegend;
  };

  const syncTodayMapUnmappedCount = () => {
    const root = document.querySelector('[data-today-map-sync]');
    if (!(root instanceof HTMLElement)) return;
    const meta = root.querySelector('.racecourse-map__meta');
    const dataNode = root.querySelector('[data-today-map-meeting-map]');
    if (!(meta instanceof HTMLElement) || !(dataNode instanceof HTMLScriptElement)) return;
    let entries = [];
    try { entries = JSON.parse(dataNode.textContent || '[]'); } catch { entries = []; }
    const byMeeting = new Map(Array.isArray(entries) ? entries.map((entry) => [entry.meetingId, entry]) : []);
    const missing = visibleRows().filter((row) => {
      const entry = byMeeting.get(row.dataset.meetingId || '');
      return entry && !entry.hasReviewedLocation;
    }).length;
    meta.hidden = missing === 0;
    if (missing > 0) {
      const isJa = document.documentElement.lang === 'ja';
      meta.textContent = isJa
        ? `位置未確認の開催 ${missing}件は、開催一覧には残し、地図には推測表示しません。`
        : `${missing} meeting(s) without a reviewed venue location remain in the list and are not guessed onto the map.`;
    }
  };

  const syncMapPresentation = () => {
    document.querySelectorAll('[data-racecourse-map]').forEach((mapRoot) => {
      syncLegendForRoot(mapRoot);
      if (!(mapRoot instanceof HTMLElement) || observedMapRoots.has(mapRoot)) return;
      observedMapRoots.add(mapRoot);
      const legend = mapRoot.querySelector('[data-map-legend]');
      if (legend instanceof HTMLElement) {
        const legendObserver = new MutationObserver(() => queueMicrotask(() => syncLegendForRoot(mapRoot)));
        legendObserver.observe(legend, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['hidden'] });
      }
      const rootObserver = new MutationObserver(() => queueMicrotask(() => syncLegendForRoot(mapRoot)));
      rootObserver.observe(mapRoot, { attributes: true, attributeFilter: ['data-map-state'] });
    });
    syncTodayMapUnmappedCount();
  };

  const applyAll = () => {
    document.querySelectorAll('[data-calendar-meeting-row]').forEach((row) => applyToRow(row));
    syncSelectedMapStatus();
    requestAnimationFrame(syncMapPresentation);
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applyAll, { once: true });
  else applyAll();

  window.addEventListener('whr:meetingstatechange', applyAll);
  window.addEventListener('whr:timezonechange', applyAll);
  window.addEventListener('whr:todayfilterchange', applyAll);
  window.addEventListener('whr:calendarfilterchange', () => requestAnimationFrame(syncMapPresentation));
  window.addEventListener('whr:calendardatechange', () => requestAnimationFrame(syncMapPresentation));
  document.addEventListener('racecourse-map:select', () => requestAnimationFrame(syncSelectedMapStatus));
  window.setInterval(applyAll, 60_000);
</script>

<style is:global>
  .meeting-row[data-meeting-presentation-state='running'][data-meeting-day-state='today'] {
    background: #fff7f6 !important;
    box-shadow: none !important;
    opacity: 1 !important;
  }

  .meeting-row[data-meeting-presentation-state='upcoming'][data-meeting-day-state='today'] {
    background: #fff9e9 !important;
    box-shadow: none !important;
    opacity: 1 !important;
  }

  .meeting-row[data-meeting-presentation-state='today'][data-meeting-day-state='today'] {
    background: #fffcf4 !important;
    box-shadow: none !important;
    opacity: 1 !important;
  }

  .meeting-row[data-meeting-presentation-state='ended'] {
    background: #f6f7f8 !important;
    box-shadow: none !important;
    opacity: .68 !important;
  }

  .meeting-row[data-meeting-presentation-state='future'],
  .meeting-row[data-meeting-presentation-state='unknown'] {
    background: #fff !important;
    box-shadow: none !important;
    opacity: 1 !important;
  }

  .map-selected-card__status[data-status='today']::before {
    background: #fffcf4 !important;
    border-color: #7a5a00 !important;
    box-shadow: none !important;
  }

  .meeting-row[data-stream-state='unknown'] [data-live-link],
  .meeting-row[data-stream-state='known'] [data-live-link] {
    background: transparent !important;
    border-radius: 0 !important;
    color: inherit !important;
    padding: 0 !important;
  }
</style>
