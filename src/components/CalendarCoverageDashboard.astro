---
import { getTimetableMeetingRows } from '../data/timetableMeetingRows';
import {
  getCoverageDashboardCountries,
} from '../lib/timetable/coverageDashboard';

type Props = { lang?: 'en' | 'ja' };
const { lang = 'en' } = Astro.props as Props;
const countries = getCoverageDashboardCountries();
const timetableRows = getTimetableMeetingRows();
const mediaSummaryFor = (countryId: string) => {
  const media = timetableRows
    .filter((record) => record.country_id === countryId && record.live_media)
    .map((record) => record.live_media!);
  return {
    hasLive: media.length > 0,
    hasYouTube: media.some((record) => record.platform === 'youtube'),
  };
};
const copy = lang === 'ja'
  ? {
      title: '国・地域別の掲載状況',
      intro: '現在掲載している開催情報を国・地域別にまとめています。',
      meetings: '開催',
      publicDates: '開催日',
      publicRacecourses: '競馬場',
      eventRows: 'レース',
      timeMeetings: '時刻掲載あり',
      structuredRows: '詳細掲載あり',
      liveAvailable: '公式ライブを見る',
      note: '掲載件数はサイト上に現在登録されている開催情報の集計です。最新の変更は各開催の公式情報源でも確認してください。',
    }
  : {
      title: 'Listings by country and region',
      intro: 'A country-by-country summary of the meeting information currently listed on Where Horses Run.',
      meetings: 'Meetings',
      publicDates: 'Dates',
      publicRacecourses: 'Racecourses',
      eventRows: 'Races',
      timeMeetings: 'With race times',
      structuredRows: 'With race details',
      liveAvailable: 'Official live coverage',
      note: 'Counts summarize meeting information currently listed on this site. Check each meeting’s official source for the latest changes.',
    };
---

<section class="coverage-dashboard" aria-labelledby="coverage-dashboard-title" data-calendar-coverage-dashboard>
  <header class="coverage-dashboard__header">
    <div>
      <p class="coverage-dashboard__eyebrow">{lang === 'ja' ? '開催情報' : 'Meeting listings'}</p>
      <h2 id="coverage-dashboard-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
  </header>
  <div class="coverage-dashboard__grid section-grid">
    {countries.map((country) => {
      const media = mediaSummaryFor(country.country_id);
      return (
        <article
          class="coverage-card card"
          data-coverage-country={country.country_id}
          data-public-meetings={country.public.meetings}
          data-public-dates={country.public.dates}
          data-public-racecourses={country.public.racecourses}
          data-public-event-rows={country.public.event_rows}
        >
          <h3>{lang === 'ja' ? country.country_label_ja : country.country_label}</h3>
          {media.hasLive && (
            <p>
              <button
                type="button"
                data-coverage-filter-country={country.country_label}
                data-coverage-filter-live={media.hasYouTube ? 'youtube' : 'available'}
              >
                ▶ {media.hasYouTube ? 'YouTube' : copy.liveAvailable}
              </button>
            </p>
          )}
          <dl class="coverage-public-metrics">
            <div><dt>{copy.meetings}</dt><dd>{country.public.meetings}</dd></div>
            <div><dt>{copy.publicDates}</dt><dd>{country.public.dates}</dd></div>
            <div><dt>{copy.publicRacecourses}</dt><dd>{country.public.racecourses}</dd></div>
            <div><dt>{copy.eventRows}</dt><dd>{country.public.event_rows}</dd></div>
            <div><dt>{copy.timeMeetings}</dt><dd>{country.public.meetings_with_times}</dd></div>
            <div><dt>{copy.structuredRows}</dt><dd>{country.public.structured_event_rows}</dd></div>
          </dl>
        </article>
      );
    })}
  </div>
  <p class="coverage-dashboard__note">{copy.note}</p>
</section>
