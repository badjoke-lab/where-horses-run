---
import BaseLayout from '../layouts/BaseLayout.astro';
import type {
  GlossaryCategoryOption,
  GlossarySearchRecord,
} from '../lib/glossary-search-data';
import type { GlossaryLocale } from '../lib/glossary-data';

interface Props {
  locale: GlossaryLocale;
  records: GlossarySearchRecord[];
  categories: GlossaryCategoryOption[];
}

const { locale, records, categories } = Astro.props;
const isJapanese = locale === 'ja';
const basePath = isJapanese ? '/ja/glossary/' : '/glossary/';
---

<BaseLayout
  title={isJapanese ? '用語集 | 競馬どこ？' : 'Glossary | Where Horses Run'}
  description={isJapanese
    ? '競馬の開催情報や競馬場ページで使われる用語を、わかりやすく説明します。'
    : 'Plain-language explanations of terms used in racing calendars, meeting pages, racecourse profiles, and official sources.'}
  lang={locale}
  canonicalPath={basePath}
  alternatePath={isJapanese ? '/glossary/' : '/ja/glossary/'}
>
  <div
    data-glossary-directory
    data-glossary-records={records.length}
    data-glossary-categories={categories.length}
  >
    <section
      class="hero"
      aria-labelledby="page-title"
      data-glossary-release="WHR-GLOSSARY-V1"
      data-glossary-concepts="48"
      data-glossary-relationships="57"
    >
      <p class="hero__eyebrow">{isJapanese ? '競馬の用語' : 'Racing terms'}</p>
      <h1 id="page-title">{isJapanese ? '用語集' : 'Glossary'}</h1>
      <p class="hero__summary">
        {isJapanese
          ? '競馬の開催情報や競馬場ページで使われる用語を、短くわかりやすく説明します。'
          : 'Short, plain-language explanations of terms used across racing calendars, meeting pages, racecourse profiles, and official sources.'}
      </p>
      <p>{isJapanese
        ? '用語名、読み方、別名、説明文から探せます。'
        : 'Search by term, reading, alias, or explanation.'}</p>
    </section>

    <section class="card" aria-labelledby="glossary-filter-heading">
      <h2 id="glossary-filter-heading">{isJapanese ? '用語を探す' : 'Find a term'}</h2>
      <form data-glossary-filter-form role="search">
        <p>
          <label for="glossary-filter-query"><strong>{isJapanese ? '用語・読み・別名・説明' : 'Term, reading, alias, or explanation'}</strong></label><br />
          <input
            id="glossary-filter-query"
            name="q"
            type="search"
            autocomplete="off"
            placeholder={isJapanese ? '例：発走時刻、競走馬、騎手' : 'Example: post time, racecard, jockey'}
            data-glossary-filter-query
          />
        </p>
        <p>
          <label for="glossary-filter-category"><strong>{isJapanese ? '分類' : 'Category'}</strong></label><br />
          <select id="glossary-filter-category" name="category" data-glossary-filter-category>
            <option value="all">{isJapanese ? 'すべての分類' : 'All categories'}</option>
            {categories.map((category) => (
              <option value={category.id}>{category.label} ({category.count})</option>
            ))}
          </select>
        </p>
        <p>
          <button type="submit">{isJapanese ? '絞り込む' : 'Apply filters'}</button>{' '}
          <button type="button" data-glossary-filter-reset>{isJapanese ? '条件を解除' : 'Clear filters'}</button>
        </p>
      </form>
      <p aria-live="polite" data-glossary-filter-count>
        {isJapanese ? `${records.length}件を表示中` : `Showing ${records.length} terms`}
      </p>
      <noscript>
        <p>{isJapanese
          ? '検索機能を使わない場合も、下の一覧からすべての用語を確認できます。'
          : 'The complete glossary remains available below even without the search controls.'}</p>
      </noscript>
    </section>

    <section class="card" aria-labelledby="glossary-category-heading" data-glossary-category-navigation>
      <h2 id="glossary-category-heading">{isJapanese ? '分類から探す' : 'Browse by category'}</h2>
      <div class="section-grid">
        {categories.map((category) => (
          <article
            class="card"
            data-glossary-category-card
            data-glossary-category-id={category.id}
            data-glossary-category-count={category.count}
          >
            <h3><a href={category.href} data-glossary-category-link>{category.label}</a></h3>
            <p>{isJapanese ? `${category.count}件` : `${category.count} terms`}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-grid" aria-label={isJapanese ? '用語一覧' : 'Glossary list'} data-glossary-filter-results>
      {records.map((record) => (
        <article
          class="card"
          data-glossary-record
          data-glossary-id={record.id}
          data-glossary-category={record.category}
          data-glossary-search-text={record.searchText}
        >
          <h2><a href={record.href}>{record.term}</a></h2>
          <p><small>{record.secondaryTerm}</small></p>
          {isJapanese && record.reading && <p><strong>読み:</strong> {record.reading}</p>}
          <p>{record.summary}</p>
          {record.aliases.length > 0 && (
            <p><strong>{isJapanese ? '別名' : 'Aliases'}:</strong> {record.aliases.join(', ')}</p>
          )}
          <p><strong>{isJapanese ? '分類' : 'Category'}:</strong> {record.categoryLabel}</p>
          <p><strong>{isJapanese ? '関連用語' : 'Related terms'}:</strong> {record.relatedCount}</p>
        </article>
      ))}
    </section>

    <section class="card" data-glossary-filter-empty hidden>
      <h2>{isJapanese ? '該当する用語がありません' : 'No matching terms'}</h2>
      <p>{isJapanese
        ? 'キーワードを短くするか、分類を「すべて」に戻してください。'
        : 'Try a shorter keyword or reset the category to All.'}</p>
    </section>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-glossary-directory]');
      if (!root) return;
      const form = root.querySelector('[data-glossary-filter-form]');
      const queryInput = root.querySelector('[data-glossary-filter-query]');
      const categorySelect = root.querySelector('[data-glossary-filter-category]');
      const resetButton = root.querySelector('[data-glossary-filter-reset]');
      const count = root.querySelector('[data-glossary-filter-count]');
      const empty = root.querySelector('[data-glossary-filter-empty]');
      const records = [...root.querySelectorAll('[data-glossary-record]')];
      const categoryLinks = [...root.querySelectorAll('[data-glossary-category-link]')];
      const isJapanese = document.documentElement.lang === 'ja';
      if (!form || !queryInput || !categorySelect || !resetButton || !count || !empty) return;

      const normalize = (value) => value
        .normalize('NFKC')
        .toLocaleLowerCase()
        .replace(/\s+/g, ' ')
        .trim();
      const params = new URLSearchParams(window.location.search);
      queryInput.value = params.get('q') ?? '';
      const requestedCategory = params.get('category') ?? 'all';
      if ([...categorySelect.options].some((option) => option.value === requestedCategory)) {
        categorySelect.value = requestedCategory;
      }

      const apply = () => {
        const query = normalize(queryInput.value);
        const category = categorySelect.value;
        let visible = 0;
        for (const record of records) {
          const show =
            (!query || (record.dataset.glossarySearchText ?? '').includes(query)) &&
            (category === 'all' || record.dataset.glossaryCategory === category);
          record.hidden = !show;
          if (show) visible += 1;
        }
        count.textContent = isJapanese ? `${visible}件を表示中` : `Showing ${visible} terms`;
        empty.hidden = visible !== 0;
        for (const link of categoryLinks) {
          const selected = new URL(link.href).searchParams.get('category') === category;
          if (selected) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
        const next = new URLSearchParams();
        if (queryInput.value.trim()) next.set('q', queryInput.value.trim());
        if (category !== 'all') next.set('category', category);
        window.history.replaceState(null, '', `${window.location.pathname}${next.size ? `?${next}` : ''}`);
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        apply();
      });
      queryInput.addEventListener('input', apply);
      categorySelect.addEventListener('change', apply);
      resetButton.addEventListener('click', () => {
        queryInput.value = '';
        categorySelect.value = 'all';
        apply();
        queryInput.focus();
      });
      apply();
    })();
  </script>
</BaseLayout>
