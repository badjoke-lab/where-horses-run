<script is:inline>
  (() => {
    let timer = null;

    const rows = () => [...document.querySelectorAll('[data-calendar-meeting-row]')]
      .filter((row) => row instanceof HTMLElement && row.dataset.liveAvailable === 'true');
    const streamNodes = (row) => [...row.querySelectorAll('[data-stream-media]')]
      .filter((node) => node instanceof HTMLElement);

    const resetLink = (stream) => {
      if (!(stream instanceof HTMLElement)) return;
      stream.dataset.streamState = 'known';
      const link = stream.querySelector('[data-live-link]');
      if (!(link instanceof HTMLAnchorElement)) return;
      const defaultHref = link.dataset.liveDefaultHref;
      const defaultLabel = link.dataset.liveDefaultLabel;
      if (defaultHref) link.href = defaultHref;
      if (defaultLabel) link.textContent = defaultLabel;
    };

    const resetRows = () => {
      rows().forEach((row) => {
        row.dataset.streamState = row.dataset.liveAvailable === 'true' ? 'known' : 'unknown';
        streamNodes(row).forEach(resetLink);
      });
      window.dispatchEvent(new CustomEvent('whr:streamstatechange'));
    };

    const stateFor = (stream, byDetectorId, sourceDate) => {
      const detectorId = stream.dataset.streamDetectorId || '';
      if (!detectorId) return 'known';
      const entry = byDetectorId.get(detectorId);
      const rawState = ['live', 'upcoming', 'ended', 'offline'].includes(entry?.status) ? entry.status : 'unknown';
      const eventSpecific = rawState === 'live' || rawState === 'upcoming' || rawState === 'ended';
      const dateMatches = typeof entry?.event_date === 'string' && entry.event_date === sourceDate;
      if (rawState === 'live' && dateMatches) return 'live';
      if (eventSpecific && !dateMatches) return 'known';
      return rawState === 'unknown' ? 'known' : 'known';
    };

    const applyPayload = (payload) => {
      const statuses = Array.isArray(payload?.statuses) ? payload.statuses : [];
      const byDetectorId = new Map(
        statuses
          .filter((entry) => entry && typeof entry.detector_id === 'string')
          .map((entry) => [entry.detector_id, entry]),
      );

      rows().forEach((row) => {
        const sourceDate = row.dataset.sourceDate || row.dataset.date || '';
        let rowLive = false;

        streamNodes(row).forEach((stream) => {
          const state = stateFor(stream, byDetectorId, sourceDate);
          stream.dataset.streamState = state;
          if (state === 'live') rowLive = true;

          const link = stream.querySelector('[data-live-link]');
          if (link instanceof HTMLAnchorElement) {
            const defaultHref = link.dataset.liveDefaultHref || link.href;
            const defaultLabel = link.dataset.liveDefaultLabel || link.textContent || '';
            const activeLabel = link.dataset.liveActiveLabel || defaultLabel;
            link.href = defaultHref;
            link.textContent = state === 'live' ? activeLabel : defaultLabel;
          }
        });

        row.dataset.streamState = rowLive
          ? 'live'
          : (row.dataset.liveAvailable === 'true' ? 'known' : 'unknown');
      });
      window.dispatchEvent(new CustomEvent('whr:streamstatechange'));
    };

    const schedule = (seconds) => {
      if (timer !== null) window.clearTimeout(timer);
      timer = window.setTimeout(refresh, Math.max(60, Math.min(3600, seconds || 300)) * 1000);
    };

    const hasRuntimeDetector = () => rows().some((row) =>
      streamNodes(row).some((stream) => Boolean(stream.dataset.streamDetectorId)));

    const refresh = async () => {
      if (!hasRuntimeDetector()) {
        resetRows();
        return;
      }
      try {
        const response = await fetch(new URL('/api/live-status', location.origin), {
          headers: { accept: 'application/json' },
          cache: 'no-store',
        });
        if (!response.ok) throw new Error(`live status ${response.status}`);
        const payload = await response.json();
        if (payload?.configured !== true) throw new Error('live status not configured');
        applyPayload(payload);
        schedule(Number(payload?.refresh_after_seconds) || 900);
      } catch {
        resetRows();
        schedule(300);
      }
    };

    const install = () => {
      resetRows();
      refresh();
      window.addEventListener('whr:timezonechange', refresh);
      window.addEventListener('whr:todayfilterchange', () => window.dispatchEvent(new CustomEvent('whr:streamstatechange')));
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true });
    else install();
  })();
</script>
