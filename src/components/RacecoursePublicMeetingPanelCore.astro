---
import type { PublicRacecourseMeetingState } from '../lib/racecourses/publicRacecourseMeetingState';
import type { PublicTimetableMeetingRow } from '../lib/timetable/publicTimetableViewModel';

interface Props {
  state: PublicRacecourseMeetingState;
  lang?: 'en' | 'ja';
  officialScheduleUrl?: string;
}

const { state, lang = 'en', officialScheduleUrl } = Astro.props;
const isJapanese = lang === 'ja';
const calendarHref = isJapanese ? '/ja/calendar/' : '/calendar/';
const calendarDateHref = (date: string) => `${calendarHref}?date=${date}`;
const localizedDetailPath = (meeting: PublicTimetableMeetingRow) => {
  if (!meeting.detail_path) return null;
  return isJapanese ? `/ja${meeting.detail_path}` : meeting.detail_path;
};
const formatTimeRange = (meeting: PublicTimetableMeetingRow) => {
  if (!meeting.first_race_time_local && !meeting.last_race_time_local) return null;
  if (meeting.first_race_time_local && meeting.last_race_time_local) {
    return `${meeting.first_race_time_local}–${meeting.last_race_time_local}`;
  }
  return meeting.first_race_time_local ?? meeting.last_race_time_local;
};
const sourceStatusLabel = (status: string) => {
  const en: Record<string, string> = {
    verified: 'Checked',
    partial: 'Partly checked',
    secondary: 'Secondary source',
    stale: 'Needs recheck',
    failed: 'Unavailable',
    'official-link-only': 'Official link only',
    link_first: 'Link-first',
  };
  const ja: Record<string, string> = {
    verified: '確認済み',
    partial: '一部確認',
    secondary: '二次ソース',
    stale: '再確認が必要',
    failed: '取得不可',
    'official-link-only': '公式リンクのみ',
    link_first: 'リンク優先',
  };
  return (isJapanese ? ja : en)[status] ?? status;
};
const upcomingPreview = state.upcoming_meetings.slice(0, 8);
const generatedDate = state.generated_at.slice(0, 10);
const candidateJson = JSON.stringify(state.timezone_candidate_meetings).replace(/</g, '\\u003c');
---

<section
  class="racecourse-meeting-panel"
  aria-labelledby="reviewed-meeting-state-title"
  data-racecourse-public-meeting-state
  data-racecourse-id={state.racecourse_id}
  data-reference-date={state.reference_date}
  data-total-public-meetings={state.total_public_meeting_count}
  data-today-count={state.today_meetings.length}
  data-next-date={state.next_meeting_date ?? ''}
  data-lang={lang}
>
  <div class="racecourse-meeting-panel__heading">
    <div>
      <p class="racecourse-meeting-panel__eyebrow">{isJapanese ? '公開カレンダー接続' : 'Public Calendar connection'}</p>
      <h2 id="reviewed-meeting-state-title">{isJapanese ? '確認済み開催情報' : 'Reviewed meeting state'}</h2>
    </div>
    <p class="racecourse-meeting-panel__meta">
      {isJapanese ? '基準日 ' : 'Reference '}<span data-racecourse-projected-reference>{state.reference_date}</span>{` / ${isJapanese ? '生成日' : 'generated'} ${generatedDate}`}
    </p>
  </div>

  <div class="racecourse-timezone-control">
    <label>
      <span>{isJapanese ? '表示タイムゾーン' : 'Display timezone'}</span>
      <select data-racecourse-timezone-select aria-label={isJapanese ? '表示タイムゾーン' : 'Display timezone'}>
        <option value="Asia/Tokyo">Asia/Tokyo</option>
        <option value="UTC">UTC</option>
      </select>
    </label>
    <output data-racecourse-timezone-status>{state.timezone}</output>
  </div>

  <div class="racecourse-meeting-panel__grid">
    <article class="card" data-meeting-state="today">
      <h3>{isJapanese ? '本日' : 'Today'}</h3>
      <div data-racecourse-today-body>
        {state.today_meetings.length ? (
          <ul>
            {state.today_meetings.map((meeting) => {
              const detailPath = localizedDetailPath(meeting);
              const timeRange = formatTimeRange(meeting);
              return (
                <li>
                  <strong><a href={calendarDateHref(meeting.date)}>{meeting.date}</a></strong>
                  {' · '}{isJapanese ? `公開ランク ${meeting.effective_public_rank}` : `Public rank ${meeting.effective_public_rank}`}
                  {timeRange ? ` · ${timeRange}` : ''}
                  {` · ${meeting.timezone}`}
                  {detailPath ? <><span>{' · '}</span><a href={detailPath}>{isJapanese ? '開催詳細' : 'Meeting detail'}</a></> : null}
                  {' · '}<a href={meeting.official_source_url}>{isJapanese ? '公式ソース' : 'Official source'}</a>
                  <span class="meeting-meta">
                    {isJapanese
                      ? `ソース状態: ${sourceStatusLabel(meeting.source_status)} / 最終確認: ${meeting.last_checked_date}`
                      : `Source status: ${sourceStatusLabel(meeting.source_status)} / last checked: ${meeting.last_checked_date}`}
                  </span>
                </li>
              );
            })}
          </ul>
        ) : (
          <p>{isJapanese ? '本日の確認済み公開開催はありません。' : 'No reviewed public meeting is listed for today.'}</p>
        )}
      </div>
    </article>

    <article class="card" data-meeting-state="next">
      <h3>{isJapanese ? '次回' : 'Next'}</h3>
      <div data-racecourse-next-body>
        {state.next_meetings.length ? (
          <ul>
            {state.next_meetings.map((meeting) => {
              const detailPath = localizedDetailPath(meeting);
              const timeRange = formatTimeRange(meeting);
              return (
                <li>
                  <strong><a href={calendarDateHref(meeting.date)}>{meeting.date}</a></strong>
                  {' · '}{isJapanese ? `公開ランク ${meeting.effective_public_rank}` : `Public rank ${meeting.effective_public_rank}`}
                  {timeRange ? ` · ${timeRange}` : ''}
                  {` · ${meeting.timezone}`}
                  {detailPath ? <><span>{' · '}</span><a href={detailPath}>{isJapanese ? '開催詳細' : 'Meeting detail'}</a></> : null}
                  {' · '}<a href={meeting.official_source_url}>{isJapanese ? '公式ソース' : 'Official source'}</a>
                  <span class="meeting-meta">
                    {isJapanese
                      ? `ソース状態: ${sourceStatusLabel(meeting.source_status)} / 最終確認: ${meeting.last_checked_date}`
                      : `Source status: ${sourceStatusLabel(meeting.source_status)} / last checked: ${meeting.last_checked_date}`}
                  </span>
                </li>
              );
            })}
          </ul>
        ) : (
          <p>{isJapanese ? '現在の公開30日窓には次回開催がありません。' : 'No next meeting is listed in the current public 30-day window.'}</p>
        )}
      </div>
    </article>
  </div>

  <article class="card" data-meeting-state="upcoming">
    <h3>{isJapanese ? '今後の確認済み開催' : 'Upcoming reviewed meetings'}</h3>
    <div data-racecourse-upcoming-body>
      {upcomingPreview.length ? (
        <ul class="racecourse-meeting-panel__upcoming">
          {upcomingPreview.map((meeting) => {
            const detailPath = localizedDetailPath(meeting);
            const timeRange = formatTimeRange(meeting);
            return (
              <li>
                <a href={calendarDateHref(meeting.date)}>{meeting.date}</a>
                <span class="meeting-meta">
                  {isJapanese ? `公開ランク ${meeting.effective_public_rank}` : `Public rank ${meeting.effective_public_rank}`}
                  {timeRange ? ` · ${timeRange}` : ''}
                  {` · ${meeting.timezone}`}
                  {' · '}{sourceStatusLabel(meeting.source_status)}
                  {' · '}{isJapanese ? `最終確認 ${meeting.last_checked_date}` : `checked ${meeting.last_checked_date}`}
                </span>
                {detailPath ? <a href={detailPath}>{isJapanese ? '詳細' : 'Detail'}</a> : <a href={meeting.official_source_url}>{isJapanese ? '公式ソース' : 'Official source'}</a>}
              </li>
            );
          })}
        </ul>
      ) : (
        <p>{isJapanese ? 'この競馬場について、基準日以降の確認済み公開開催はありません。' : 'No reviewed public meeting is listed for this racecourse after the reference date.'}</p>
      )}
    </div>
    <p class="racecourse-meeting-panel__boundary">
      {isJapanese
        ? 'この欄は公開用meeting listだけを使用します。出走馬、オッズ、結果、払戻、予想、内部キュー情報は表示しません。'
        : 'This panel uses only the public meeting list. It does not display entries, odds, results, payouts, predictions, or internal queue state.'}
    </p>
    <p>
      <a href={calendarHref}>{isJapanese ? 'カレンダーを見る' : 'Open Calendar'}</a>
      {officialScheduleUrl ? <><span>{' · '}</span><a href={officialScheduleUrl}>{isJapanese ? '公式開催予定' : 'Official schedule'}</a></> : null}
    </p>
  </article>

  <script type="application/json" data-racecourse-timezone-candidates set:html={candidateJson}></script>
</section>

<script>
  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try { new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0)); return true; } catch { return false; }
  };
  const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
    timeZone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
  }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(Number(dateMatch[1]), Number(dateMatch[2]) - 1, Number(dateMatch[3]), Number(timeMatch[1]), Number(timeMatch[2]), Number(timeMatch[3] ?? '0'));
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second));
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };
  const formatDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };
  const formatTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', {
    timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
  }).format(instant);
  const addDateDays = (dateText, days) => {
    const date = new Date(`${dateText}T00:00:00.000Z`);
    date.setUTCDate(date.getUTCDate() + days);
    return date.toISOString().slice(0, 10);
  };
  const populateTimeZones = (select) => {
    const zones = typeof Intl.supportedValuesOf === 'function'
      ? Intl.supportedValuesOf('timeZone')
      : ['UTC', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Dubai', 'Europe/Istanbul', 'Europe/London', 'America/New_York', 'Australia/Sydney'];
    const values = Array.from(new Set(['UTC', ...zones]));
    select.replaceChildren(...values.map((zone) => {
      const option = document.createElement('option');
      option.value = zone;
      option.textContent = zone;
      return option;
    }));
  };
  const sourceStatus = (status, isJa) => {
    const en = { verified: 'Checked', partial: 'Partly checked', secondary: 'Secondary source', stale: 'Needs recheck', failed: 'Unavailable', 'official-link-only': 'Official link only', link_first: 'Link-first' };
    const ja = { verified: '確認済み', partial: '一部確認', secondary: '二次ソース', stale: '再確認が必要', failed: '取得不可', 'official-link-only': '公式リンクのみ', link_first: 'リンク優先' };
    return (isJa ? ja : en)[status] || status;
  };
  const projectRecord = (meeting, timeZone) => {
    const firstInstant = meeting.first_race_time_local
      ? localDateTimeToInstant(meeting.date, meeting.first_race_time_local, meeting.timezone)
      : null;
    let lastInstant = meeting.last_race_time_local
      ? localDateTimeToInstant(meeting.date, meeting.last_race_time_local, meeting.timezone)
      : null;
    if (firstInstant && lastInstant && lastInstant.getTime() < firstInstant.getTime()) {
      lastInstant = new Date(lastInstant.getTime() + 86_400_000);
    }
    const anchorInstant = firstInstant || lastInstant;
    const projectedDate = anchorInstant ? formatDate(anchorInstant, timeZone) : meeting.date;
    const firstProjectedTime = firstInstant ? formatTime(firstInstant, timeZone) : null;
    const lastProjectedTime = lastInstant ? formatTime(lastInstant, timeZone) : null;
    const lastProjectedDate = lastInstant ? formatDate(lastInstant, timeZone) : projectedDate;
    return { meeting, projectedDate, firstProjectedTime, lastProjectedTime, lastProjectedDate, projected: Boolean(anchorInstant) };
  };
  const withTimeZone = (href, timeZone) => {
    const url = new URL(href, window.location.origin);
    if (url.origin !== window.location.origin) return href;
    url.searchParams.set('tz', timeZone);
    return `${url.pathname}${url.search}${url.hash}`;
  };
  const calendarDateHrefFor = (isJa, date, timeZone) => {
    const url = new URL(isJa ? '/ja/calendar/' : '/calendar/', window.location.origin);
    url.searchParams.set('date', date);
    url.searchParams.set('tz', timeZone);
    return `${url.pathname}${url.search}`;
  };
  const timeLabelFor = (record) => {
    const { projectedDate, firstProjectedTime, lastProjectedTime, lastProjectedDate } = record;
    if (firstProjectedTime && lastProjectedTime) {
      return lastProjectedDate === projectedDate
        ? `${firstProjectedTime}–${lastProjectedTime}`
        : `${firstProjectedTime}–${lastProjectedDate} ${lastProjectedTime}`;
    }
    return firstProjectedTime || lastProjectedTime || '';
  };
  const appendMeetingList = (container, records, options) => {
    container.replaceChildren();
    if (!records.length) {
      const p = document.createElement('p');
      p.textContent = options.emptyText;
      container.append(p);
      return;
    }
    const ul = document.createElement('ul');
    if (options.upcoming) ul.className = 'racecourse-meeting-panel__upcoming';
    records.forEach((record) => {
      const { meeting, projectedDate, projected } = record;
      const li = document.createElement('li');
      const dateLink = document.createElement('a');
      dateLink.href = calendarDateHrefFor(options.isJa, projectedDate, options.timeZone);
      dateLink.textContent = projectedDate;
      if (!options.upcoming) {
        const strong = document.createElement('strong');
        strong.append(dateLink);
        li.append(strong);
      } else {
        li.append(dateLink);
      }
      const timeLabel = timeLabelFor(record);
      const summary = document.createElement(options.upcoming ? 'span' : 'span');
      summary.className = options.upcoming ? 'meeting-meta' : '';
      const rankText = options.isJa ? `公開ランク ${meeting.effective_public_rank}` : `Public rank ${meeting.effective_public_rank}`;
      const timeZoneLabel = projected ? options.timeZone : meeting.timezone;
      summary.textContent = ` · ${rankText}${timeLabel ? ` · ${timeLabel}` : ''} · ${timeZoneLabel}`;
      if (timeLabel) summary.title = `${meeting.date} ${meeting.first_race_time_local || ''}${meeting.last_race_time_local ? `–${meeting.last_race_time_local}` : ''} ${meeting.timezone}`;
      li.append(summary);
      if (!options.upcoming) {
        if (meeting.detail_path) {
          const sep = document.createTextNode(' · ');
          li.append(sep);
          const detail = document.createElement('a');
          detail.href = withTimeZone(options.isJa ? `/ja${meeting.detail_path}` : meeting.detail_path, options.timeZone);
          detail.textContent = options.isJa ? '開催詳細' : 'Meeting detail';
          li.append(detail);
        }
        li.append(document.createTextNode(' · '));
        const official = document.createElement('a');
        official.href = meeting.official_source_url;
        official.textContent = options.isJa ? '公式ソース' : 'Official source';
        li.append(official);
        const meta = document.createElement('span');
        meta.className = 'meeting-meta';
        meta.textContent = options.isJa
          ? `ソース状態: ${sourceStatus(meeting.source_status, true)} / 最終確認: ${meeting.last_checked_date}`
          : `Source status: ${sourceStatus(meeting.source_status, false)} / last checked: ${meeting.last_checked_date}`;
        li.append(meta);
      } else {
        summary.textContent += ` · ${sourceStatus(meeting.source_status, options.isJa)} · ${options.isJa ? `最終確認 ${meeting.last_checked_date}` : `checked ${meeting.last_checked_date}`}`;
        const action = document.createElement('a');
        if (meeting.detail_path) {
          action.href = withTimeZone(options.isJa ? `/ja${meeting.detail_path}` : meeting.detail_path, options.timeZone);
          action.textContent = options.isJa ? '詳細' : 'Detail';
        } else {
          action.href = meeting.official_source_url;
          action.textContent = options.isJa ? '公式ソース' : 'Official source';
        }
        li.append(action);
      }
      ul.append(li);
    });
    container.append(ul);
  };
  document.querySelectorAll('[data-racecourse-public-meeting-state]').forEach((panel) => {
    if (!(panel instanceof HTMLElement)) return;
    const select = panel.querySelector('[data-racecourse-timezone-select]');
    const dataNode = panel.querySelector('[data-racecourse-timezone-candidates]');
    const todayBody = panel.querySelector('[data-racecourse-today-body]');
    const nextBody = panel.querySelector('[data-racecourse-next-body]');
    const upcomingBody = panel.querySelector('[data-racecourse-upcoming-body]');
    if (!(select instanceof HTMLSelectElement) || !(dataNode instanceof HTMLScriptElement) || !(todayBody instanceof HTMLElement) || !(nextBody instanceof HTMLElement) || !(upcomingBody instanceof HTMLElement)) return;
    let meetings = [];
    try { meetings = JSON.parse(dataNode.textContent || '[]'); } catch { meetings = []; }
    const isJa = panel.dataset.lang === 'ja';
    populateTimeZones(select);
    const requested = new URL(window.location.href).searchParams.get('tz');
    const browser = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const initial = isTimeZoneSupported(requested) ? requested : isTimeZoneSupported(browser) ? browser : 'Asia/Tokyo';
    const apply = (timeZone) => {
      const today = formatDate(new Date(), timeZone);
      const endExclusive = addDateDays(today, 30);
      const projected = meetings
        .map((meeting) => projectRecord(meeting, timeZone))
        .filter((record) => record.projectedDate >= today && record.projectedDate < endExclusive)
        .sort((a, b) => a.projectedDate.localeCompare(b.projectedDate) || (a.firstProjectedTime || '99:99').localeCompare(b.firstProjectedTime || '99:99') || a.meeting.meeting_id.localeCompare(b.meeting.meeting_id));
      const todayRecords = projected.filter((record) => record.projectedDate === today);
      const futureRecords = projected.filter((record) => record.projectedDate > today);
      const nextDate = futureRecords[0]?.projectedDate || '';
      const nextRecords = nextDate ? futureRecords.filter((record) => record.projectedDate === nextDate) : [];
      appendMeetingList(todayBody, todayRecords, { isJa, timeZone, upcoming: false, emptyText: isJa ? '本日の確認済み公開開催はありません。' : 'No reviewed public meeting is listed for today.' });
      appendMeetingList(nextBody, nextRecords, { isJa, timeZone, upcoming: false, emptyText: isJa ? '選択した30日間には次回開催がありません。' : 'No next meeting is listed in the selected 30-day window.' });
      appendMeetingList(upcomingBody, futureRecords.slice(0, 8), { isJa, timeZone, upcoming: true, emptyText: isJa ? 'この競馬場について、選択した30日間に今後の確認済み公開開催はありません。' : 'No upcoming reviewed public meeting is listed for this racecourse in the selected 30-day window.' });
      panel.dataset.referenceDate = today;
      panel.dataset.todayCount = String(todayRecords.length);
      panel.dataset.nextDate = nextDate;
      const reference = panel.querySelector('[data-racecourse-projected-reference]');
      if (reference) reference.textContent = today;
      const status = panel.querySelector('[data-racecourse-timezone-status]');
      if (status) status.textContent = timeZone;
      window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: { timeZone, targetDate: today, scope: 'racecourse' } }));
    };
    select.value = initial;
    const initialUrl = new URL(window.location.href);
    if (initialUrl.searchParams.get('tz') !== initial) {
      initialUrl.searchParams.set('tz', initial);
      window.history.replaceState({}, '', `${initialUrl.pathname}${initialUrl.search}${initialUrl.hash}`);
    }
    apply(initial);
    select.addEventListener('change', () => {
      const selected = isTimeZoneSupported(select.value) ? select.value : 'Asia/Tokyo';
      const url = new URL(window.location.href);
      url.searchParams.set('tz', selected);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      apply(selected);
    });
  });
</script>

<style>
  .racecourse-meeting-panel {
    margin-block-start: 2rem;
  }

  .racecourse-meeting-panel__heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-block-end: 1rem;
  }

  .racecourse-timezone-control {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    margin-block-end: 1rem;
  }

  .racecourse-timezone-control label {
    display: grid;
    font-size: 0.82rem;
    gap: 0.2rem;
  }

  .racecourse-timezone-control select {
    max-width: min(24rem, 80vw);
    padding: 0.38rem 0.5rem;
  }

  .racecourse-timezone-control output {
    font-size: 0.82rem;
    opacity: 0.72;
  }

  .racecourse-meeting-panel__eyebrow,
  .racecourse-meeting-panel__meta,
  .racecourse-meeting-panel__boundary,
  .meeting-meta {
    color: var(--whr-color-text-muted);
    font-size: 0.9rem;
  }

  .racecourse-meeting-panel__grid .meeting-meta {
    display: block;
    margin-block-start: 0.25rem;
  }

  .racecourse-meeting-panel__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-block-end: 1rem;
  }

  .racecourse-meeting-panel__upcoming {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .racecourse-meeting-panel__upcoming li {
    align-items: center;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: minmax(7rem, auto) 1fr auto;
  }

  @media (max-width: 40rem) {
    .racecourse-meeting-panel__upcoming li {
      align-items: start;
      grid-template-columns: 1fr;
    }
  }
</style>
