---
import type { TimetableMeetingDayGroup, TimetableMeetingRow } from '../data/timetableMeetingRows';
import { getTimetableDateContext } from '../data/timetableMeetingRows';
import { evaluatePublicFreshness } from '../lib/timetable/publicFreshnessState.mjs';

type Props =
  | {
      groups: TimetableMeetingDayGroup[];
      emptyLabel?: string;
      lang?: 'en' | 'ja';
    }
  | {
      records: TimetableMeetingRow[];
      date?: string;
      emptyLabel?: string;
      lang?: 'en' | 'ja';
    };

const props = Astro.props as Props;
const lang = props.lang ?? 'en';
const referenceDate = getTimetableDateContext().today;
const emptyLabel = props.emptyLabel ?? (lang === 'ja'
  ? '開催情報はまだありません。最終確認には公式ソースを使用してください。'
  : 'No meetings are listed yet. Use official source links for final confirmation.');
const groups: TimetableMeetingDayGroup[] = 'groups' in props
  ? props.groups
  : [
      {
        date: props.date ?? props.records[0]?.date ?? '',
        records: props.records,
      },
    ].filter((group) => group.records.length > 0);

const text = lang === 'ja'
  ? {
      detail: '詳細',
      liveBadge: '● LIVE',
      likelyLiveBadge: '◐ LIVEの可能性',
      officialLive: '公式ライブ ↗',
      meetings: '開催',
      official: '公式 ↗',
      staleLegend: '古い確認を含みます。公式ソースで確認してください。',
      displayTimeZone: '表示タイムゾーン',
    }
  : {
      detail: 'Details',
      liveBadge: '● LIVE',
      likelyLiveBadge: '◐ Likely live',
      officialLive: 'Official live ↗',
      meetings: 'meetings',
      official: 'Official ↗',
      staleLegend: 'Some checks are stale. Confirm with official sources.',
      displayTimeZone: 'Display timezone',
    };

const jaRacecourseLabelById: Record<string, string> = {
  'tokyo-racecourse': '東京競馬場',
  'obihiro-racecourse': '帯広競馬場',
  'sha-tin-racecourse': '沙田競馬場',
  'happy-valley-racecourse': 'ハッピーバレー競馬場',
  'meydan-racecourse': 'メイダン競馬場',
  'ankara-racecourse': 'アンカラ競馬場',
  'kocaeli-racecourse': 'コジャエリ競馬場',
};
const jaAuthorityLabelById: Record<string, string> = {
  jra: 'JRA',
  hkjc: 'HKJC',
  'nar-local-government-racing': 'NAR',
  'banei-tokachi': 'ばんえい十勝',
  'emirates-racing-authority': 'ERA',
  'turkiye-jokey-kulubu': 'TJK',
};
const jaCountryLabelById: Record<string, string> = {
  japan: '日本',
  'hong-kong': '香港',
  'united-arab-emirates': 'アラブ首長国連邦',
  turkey: 'トルコ',
};

const narLiveDetectorByRacecourseId: Record<string, string> = {
  'monbetsu-racecourse': 'nar-monbetsu-youtube-live-2026',
  'morioka-racecourse': 'nar-iwate-youtube-live-2026',
  'mizusawa-racecourse': 'nar-iwate-youtube-live-2026',
  'urawa-racecourse': 'nar-urawa-youtube-live-2026',
  'funabashi-racecourse': 'nar-funabashi-youtube-live-2026',
  'oi-racecourse': 'nar-oi-youtube-live-2026',
  'kawasaki-racecourse': 'nar-kawasaki-youtube-live-2026',
  'kanazawa-racecourse': 'nar-kanazawa-youtube-live-2026',
  'kasamatsu-racecourse': 'nar-kasamatsu-youtube-live-2026',
  'nagoya-racecourse': 'nar-nagoya-youtube-live-2026',
  'sonoda-racecourse': 'nar-hyogo-youtube-live-2026',
  'himeji-racecourse': 'nar-hyogo-youtube-live-2026',
  'kochi-racecourse': 'nar-kochi-youtube-live-2026',
  'saga-racecourse': 'nar-saga-youtube-live-2026',
};

const liveDetectorIdFor = (record: TimetableMeetingRow) => {
  if (record.authority_id === 'jra') return 'jra-youtube-live-2026';
  if (record.authority_id === 'banei-tokachi' && record.racecourse_id === 'obihiro-racecourse') {
    return 'banei-youtube-live-2026';
  }
  if (record.authority_id === 'nar-local-government-racing') {
    return narLiveDetectorByRacecourseId[record.racecourse_id] ?? '';
  }
  return '';
};

const localizedDetailPath = (detailPath: string) => lang === 'ja' ? `/ja${detailPath}` : detailPath;
const displayRacecourse = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaRacecourseLabelById[record.racecourse_id] ?? record.racecourse_name : record.racecourse_name;
const displayAuthority = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaAuthorityLabelById[record.authority_id] ?? record.authority_label : record.authority_label;
const displayCountry = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaCountryLabelById[record.country_id] ?? record.country_label : record.country_label;
const freshnessFor = (record: TimetableMeetingRow) => evaluatePublicFreshness({
  lastCheckedDate: record.last_checked_date ?? null,
  referenceDate,
});
const raceTime = (record: TimetableMeetingRow) => {
  if (record.first_race_time_local && record.last_race_time_local) return `${record.first_race_time_local}–${record.last_race_time_local}`;
  if (record.first_race_time_local) return `${record.first_race_time_local}–`;
  return '—';
};
const mediaTitle = (record: TimetableMeetingRow) => {
  if (!record.live_media) return undefined;
  return lang === 'ja'
    ? record.live_media.access_note_ja ?? `${record.live_media.provider_label}の公式ライブページ`
    : record.live_media.access_note_en ?? `Official live page from ${record.live_media.provider_label}`;
};
const isLiveLikelihoodEligible = (record: TimetableMeetingRow) =>
  record.live_media !== null &&
  (record.capability_rank === 'A' || record.capability_rank === 'A+') &&
  Boolean(record.first_race_time_local && record.last_race_time_local);
const hasStaleRecords = groups.some((group) => group.records.some((record) => freshnessFor(record).status === 'stale'));
---

<div class="timetable-timezone-projection" data-display-timezone-root data-lang={lang}>
  <div class="timezone-control">
    <label>
      <span>{text.displayTimeZone}</span>
      <select data-display-timezone-select aria-label={text.displayTimeZone}>
        <option value="Asia/Tokyo">Asia/Tokyo</option>
        <option value="UTC">UTC</option>
      </select>
    </label>
    <output data-display-timezone-status>Asia/Tokyo</output>
  </div>

  {groups.length > 0 ? (
    <div class="timetable-date-groups" data-timetable-date-groups>
      {hasStaleRecords && <p class="meeting-list__stale">{text.staleLegend}</p>}
      {groups.map((group) => (
        <section
          class="timetable-date-group"
          aria-labelledby={`date-${group.date}`}
          data-calendar-date-group={group.date}
        >
          {group.date && (
            <h2 id={`date-${group.date}`} tabindex="-1">
              {group.date}
              <small> · {group.records.length} {text.meetings}</small>
            </h2>
          )}
          <ul class="meeting-list" aria-label={group.date ? `${group.date} meetings` : 'Meetings'}>
            {group.records.map((record) => {
              const racecourse = displayRacecourse(record);
              const country = displayCountry(record);
              const authority = displayAuthority(record);
              const liveDetectorId = liveDetectorIdFor(record);
              return (
                <li
                  class="meeting-row"
                  data-calendar-meeting-row
                  data-meeting-id={record.meeting_id}
                  data-date={record.date}
                  data-source-date={record.date}
                  data-source-timezone={record.timezone}
                  data-first-race-time={record.first_race_time_local ?? ''}
                  data-last-race-time={record.last_race_time_local ?? ''}
                  data-racecourse={racecourse}
                  data-country={record.country_label}
                  data-authority={record.authority_label}
                  data-rank={record.capability_rank}
                  data-live-available={String(record.live_media !== null)}
                  data-live-platform={record.live_media?.platform ?? ''}
                  data-media-id={record.live_media?.id ?? ''}
                  data-live-detector-id={liveDetectorId}
                  data-live-likelihood-eligible={String(isLiveLikelihoodEligible(record))}
                  data-live-state="unknown"
                >
                  <div class="meeting-row__identity">
                    <strong>{racecourse}</strong>
                  </div>
                  <p class="meeting-row__system">{country} · {authority}</p>
                  <p
                    class="meeting-row__time"
                    title={`${lang === 'ja' ? '開催地タイムゾーン' : 'Venue timezone'}: ${record.timezone}`}
                    data-source-time-label={raceTime(record)}
                  >
                    {record.first_race_time_local ? (
                      <>
                        <time data-race-time="first">{record.first_race_time_local}</time>
                        {record.last_race_time_local && (
                          <>–<time data-race-time="last">{record.last_race_time_local}</time></>
                        )}
                      </>
                    ) : '—'}
                  </p>
                  <span class={`meeting-row__rank meeting-row__rank--${record.capability_rank.replace('+', 'plus')}`} title={`${lang === 'ja' ? '公開ランク' : 'Public rank'} ${record.capability_rank}`}>
                    {record.capability_rank}
                  </span>
                  <div class="meeting-row__links">
                    {record.live_media && (
                      <>
                        <span class="meeting-row__live-badge" data-live-badge hidden>{text.liveBadge}</span>
                        <span class="meeting-row__likely-live-badge" data-live-likely-badge hidden>{text.likelyLiveBadge}</span>
                        <a
                          href={record.live_media.landing_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={mediaTitle(record)}
                          data-live-link
                          data-live-default-href={record.live_media.landing_url}
                        >
                          {text.officialLive}
                        </a>
                      </>
                    )}
                    {record.detail_path && <a href={localizedDetailPath(record.detail_path)}>{text.detail}</a>}
                    <a href={record.official_source_url} target="_blank" rel="noopener noreferrer">{text.official}</a>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p>{emptyLabel}</p>
  )}
</div>

<script>
  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try {
      new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0));
      return true;
    } catch {
      return false;
    }
  };

  const dateParts = (instant, timeZone) => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(instant);
    return Object.fromEntries(parts
      .filter((part) => part.type !== 'literal')
      .map((part) => [part.type, part.value]));
  };

  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(
      Number(dateMatch[1]), Number(dateMatch[2]) - 1, Number(dateMatch[3]),
      Number(timeMatch[1]), Number(timeMatch[2]), Number(timeMatch[3] ?? '0'),
    );
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(
        Number(parts.year), Number(parts.month) - 1, Number(parts.day),
        Number(parts.hour), Number(parts.minute), Number(parts.second),
      );
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };

  const formatProjectedDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };

  const formatProjectedTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', {
    timeZone,
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  }).format(instant);

  const populateTimeZones = (select) => {
    const supportedValuesOf = Intl.supportedValuesOf;
    const zones = typeof supportedValuesOf === 'function'
      ? supportedValuesOf.call(Intl, 'timeZone')
      : ['UTC', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Dubai', 'Europe/Istanbul', 'Europe/London', 'America/New_York', 'Australia/Sydney'];
    const values = Array.from(new Set(['UTC', ...zones]));
    select.replaceChildren(...values.map((zone) => {
      const option = document.createElement('option');
      option.value = zone;
      option.textContent = zone;
      return option;
    }));
  };

  const propagateTimeZoneToLinks = (root, timeZone) => {
    root.querySelectorAll('a[href]').forEach((anchor) => {
      const rawHref = anchor.getAttribute('href');
      if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:')) return;
      const url = new URL(rawHref, window.location.href);
      if (url.origin !== window.location.origin) return;
      url.searchParams.set('tz', timeZone);
      anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    });
  };

  const projectRoot = (root, timeZone) => {
    const rows = Array.from(root.querySelectorAll('[data-calendar-meeting-row]'));
    const lang = root.dataset.lang === 'ja' ? 'ja' : 'en';

    rows.forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const sourceDate = row.dataset.sourceDate || '';
      const sourceTimeZone = row.dataset.sourceTimezone || '';
      const firstTime = row.dataset.firstRaceTime || '';
      const lastTime = row.dataset.lastRaceTime || '';
      let projectedDate = sourceDate;

      const firstInstant = firstTime ? localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone) : null;
      const lastInstant = lastTime ? localDateTimeToInstant(sourceDate, lastTime, sourceTimeZone) : null;
      if (firstInstant) projectedDate = formatProjectedDate(firstInstant, timeZone);
      row.dataset.date = projectedDate;

      const firstElement = row.querySelector('[data-race-time="first"]');
      if (firstElement && firstInstant) {
        firstElement.textContent = formatProjectedTime(firstInstant, timeZone);
        firstElement.setAttribute('datetime', firstInstant.toISOString());
      }
      const lastElement = row.querySelector('[data-race-time="last"]');
      if (lastElement && lastInstant) {
        lastElement.textContent = formatProjectedTime(lastInstant, timeZone);
        lastElement.setAttribute('datetime', lastInstant.toISOString());
      }
    });

    const groupsContainer = root.querySelector('[data-timetable-date-groups]');
    if (groupsContainer) {
      groupsContainer.querySelectorAll('.timetable-date-group').forEach((section) => section.remove());
      const grouped = new Map();
      rows.forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        const date = row.dataset.date || row.dataset.sourceDate || '';
        if (!grouped.has(date)) grouped.set(date, []);
        grouped.get(date).push(row);
      });
      Array.from(grouped.keys()).sort().forEach((date) => {
        const dayRows = grouped.get(date);
        const section = document.createElement('section');
        section.className = 'timetable-date-group';
        section.dataset.calendarDateGroup = date;
        section.setAttribute('aria-labelledby', `date-${date}`);
        const heading = document.createElement('h2');
        heading.id = `date-${date}`;
        heading.tabIndex = -1;
        heading.append(document.createTextNode(date));
        const small = document.createElement('small');
        small.textContent = ` · ${dayRows.length} ${lang === 'ja' ? '開催' : 'meetings'}`;
        heading.append(small);
        const list = document.createElement('ul');
        list.className = 'meeting-list';
        list.setAttribute('aria-label', `${date} meetings`);
        dayRows.forEach((row) => list.append(row));
        section.append(heading, list);
        groupsContainer.append(section);
      });
    }

    const status = root.querySelector('[data-display-timezone-status]');
    if (status) status.textContent = timeZone;
    propagateTimeZoneToLinks(root, timeZone);
    window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: { timeZone } }));
  };

  document.querySelectorAll('[data-display-timezone-root]').forEach((root) => {
    const select = root.querySelector('[data-display-timezone-select]');
    if (!(select instanceof HTMLSelectElement)) return;
    populateTimeZones(select);
    const requested = new URL(window.location.href).searchParams.get('tz');
    const browser = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const initial = isTimeZoneSupported(requested)
      ? requested
      : isTimeZoneSupported(browser) ? browser : 'Asia/Tokyo';
    select.value = initial;
    projectRoot(root, initial);
    select.addEventListener('change', () => {
      const selected = isTimeZoneSupported(select.value) ? select.value : 'Asia/Tokyo';
      const url = new URL(window.location.href);
      url.searchParams.set('tz', selected);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      projectRoot(root, selected);
    });
  });
</script>

<style>
  .timetable-timezone-projection { display: grid; gap: 1rem; }
  .timezone-control { align-items: end; display: flex; flex-wrap: wrap; gap: 0.5rem 0.8rem; }
  .timezone-control label { display: grid; font-size: 0.82rem; gap: 0.2rem; }
  .timezone-control select { max-width: min(24rem, 80vw); padding: 0.38rem 0.5rem; }
  .timezone-control output { font-size: 0.82rem; opacity: 0.72; }
  .timetable-date-groups { display: grid; gap: 1.35rem; }
  .timetable-date-group h2 { margin-block-end: 0.45rem; }
  .timetable-date-group h2 small { font-size: 0.72rem; font-weight: 500; }
  .meeting-list__stale { font-size: 0.82rem; margin: 0; }
  .meeting-list { display: grid; list-style: none; margin: 0; padding: 0; }
  .meeting-row {
    align-items: center;
    border-block-end: 1px solid rgba(0, 0, 0, 0.12);
    display: grid;
    gap: 0.35rem 0.7rem;
    grid-template-columns: minmax(12rem, 1.45fr) minmax(10rem, 1fr) minmax(7rem, 0.65fr) 3rem minmax(13rem, auto);
    padding: 0.48rem 0.55rem;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }
  .meeting-row[data-live-state='live'] {
    background: #fff0f0;
    box-shadow: inset 0.25rem 0 0 #c40000;
  }
  .meeting-row[data-live-state='likely'] {
    background: #fff9e8;
    box-shadow: inset 0.25rem 0 0 #a56a00;
  }
  .meeting-row[hidden], .timetable-date-group[hidden] { display: none; }
  .meeting-row__identity, .meeting-row__system, .meeting-row__time { min-width: 0; }
  .meeting-row[data-live-state='live'] .meeting-row__identity strong { color: #9d0000; }
  .meeting-row[data-live-state='likely'] .meeting-row__identity strong { color: #765000; }
  .meeting-row__system, .meeting-row__time { font-size: 0.82rem; margin: 0; }
  .meeting-row__rank { border: 1px solid var(--whr-color-border); border-radius: 999px; font-size: 0.74rem; font-weight: 700; justify-self: start; padding: 0.1rem 0.42rem; }
  .meeting-row__links { align-items: center; display: flex; flex-wrap: wrap; font-size: 0.8rem; gap: 0.25rem 0.65rem; justify-content: flex-end; white-space: nowrap; }
  .meeting-row__live-badge,
  .meeting-row__likely-live-badge {
    border-radius: 999px;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 0.16rem 0.42rem;
  }
  .meeting-row__live-badge { background: #c40000; }
  .meeting-row__likely-live-badge { background: #9a6500; }
  .meeting-row__live-badge[hidden], .meeting-row__likely-live-badge[hidden] { display: none; }
  .meeting-row[data-live-state='live'] [data-live-link] {
    color: #a40000;
    font-weight: 800;
    text-decoration-thickness: 2px;
  }
  .meeting-row[data-live-state='likely'] [data-live-link] {
    color: #765000;
    font-weight: 700;
  }
  @media (max-width: 760px) {
    .meeting-row { align-items: start; grid-template-columns: 1fr auto; padding: 0.62rem 0.35rem; }
    .meeting-row__system, .meeting-row__time { grid-column: 1; }
    .meeting-row__rank { grid-column: 2; grid-row: 1; }
    .meeting-row__links { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>
