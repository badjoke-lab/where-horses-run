---
import type { TimetableMeetingDayGroup, TimetableMeetingRow } from '../data/timetableMeetingRows';
import { getTimetableDateContext } from '../data/timetableMeetingRows';
import { evaluatePublicFreshness } from '../lib/timetable/publicFreshnessState.mjs';

type Props =
  | {
      groups: TimetableMeetingDayGroup[];
      emptyLabel?: string;
      lang?: 'en' | 'ja';
    }
  | {
      records: TimetableMeetingRow[];
      date?: string;
      emptyLabel?: string;
      lang?: 'en' | 'ja';
    };

const props = Astro.props as Props;
const lang = props.lang ?? 'en';
const referenceDate = getTimetableDateContext().today;
const emptyLabel = props.emptyLabel ?? (lang === 'ja'
  ? '開催情報はまだありません。最終確認には公式ソースを使用してください。'
  : 'No meetings are listed yet. Use official source links for final confirmation.');
const groups: TimetableMeetingDayGroup[] = 'groups' in props
  ? props.groups
  : [
      {
        date: props.date ?? props.records[0]?.date ?? '',
        records: props.records,
      },
    ].filter((group) => group.records.length > 0);

const text = lang === 'ja'
  ? {
      detail: '詳細',
      liveBadge: '● LIVE',
      officialLive: '公式ライブ ↗',
      meetings: '開催',
      official: '公式 ↗',
      staleLegend: '古い確認を含みます。公式ソースで確認してください。',
    }
  : {
      detail: 'Details',
      liveBadge: '● LIVE',
      officialLive: 'Official live ↗',
      meetings: 'meetings',
      official: 'Official ↗',
      staleLegend: 'Some checks are stale. Confirm with official sources.',
    };

const jaRacecourseLabelById: Record<string, string> = {
  'tokyo-racecourse': '東京競馬場',
  'obihiro-racecourse': '帯広競馬場',
  'sha-tin-racecourse': '沙田競馬場',
  'happy-valley-racecourse': 'ハッピーバレー競馬場',
  'meydan-racecourse': 'メイダン競馬場',
  'ankara-racecourse': 'アンカラ競馬場',
  'kocaeli-racecourse': 'コジャエリ競馬場',
};
const jaAuthorityLabelById: Record<string, string> = {
  jra: 'JRA',
  hkjc: 'HKJC',
  'nar-local-government-racing': 'NAR',
  'banei-tokachi': 'ばんえい十勝',
  'emirates-racing-authority': 'ERA',
  'turkiye-jokey-kulubu': 'TJK',
};
const jaCountryLabelById: Record<string, string> = {
  japan: '日本',
  'hong-kong': '香港',
  'united-arab-emirates': 'アラブ首長国連邦',
  turkey: 'トルコ',
};

const narLiveDetectorByRacecourseId: Record<string, string> = {
  'monbetsu-racecourse': 'nar-monbetsu-youtube-live-2026',
  'morioka-racecourse': 'nar-iwate-youtube-live-2026',
  'mizusawa-racecourse': 'nar-iwate-youtube-live-2026',
  'urawa-racecourse': 'nar-urawa-youtube-live-2026',
  'funabashi-racecourse': 'nar-funabashi-youtube-live-2026',
  'oi-racecourse': 'nar-oi-youtube-live-2026',
  'kawasaki-racecourse': 'nar-kawasaki-youtube-live-2026',
  'kanazawa-racecourse': 'nar-kanazawa-youtube-live-2026',
  'kasamatsu-racecourse': 'nar-kasamatsu-youtube-live-2026',
  'nagoya-racecourse': 'nar-nagoya-youtube-live-2026',
  'sonoda-racecourse': 'nar-hyogo-youtube-live-2026',
  'himeji-racecourse': 'nar-hyogo-youtube-live-2026',
  'kochi-racecourse': 'nar-kochi-youtube-live-2026',
  'saga-racecourse': 'nar-saga-youtube-live-2026',
};

const liveDetectorIdFor = (record: TimetableMeetingRow) => {
  if (record.authority_id === 'jra') return 'jra-youtube-live-2026';
  if (record.authority_id === 'banei-tokachi' && record.racecourse_id === 'obihiro-racecourse') {
    return 'banei-youtube-live-2026';
  }
  if (record.authority_id === 'nar-local-government-racing') {
    return narLiveDetectorByRacecourseId[record.racecourse_id] ?? '';
  }
  return '';
};

const localizedDetailPath = (detailPath: string) => lang === 'ja' ? `/ja${detailPath}` : detailPath;
const displayRacecourse = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaRacecourseLabelById[record.racecourse_id] ?? record.racecourse_name : record.racecourse_name;
const displayAuthority = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaAuthorityLabelById[record.authority_id] ?? record.authority_label : record.authority_label;
const displayCountry = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaCountryLabelById[record.country_id] ?? record.country_label : record.country_label;
const freshnessFor = (record: TimetableMeetingRow) => evaluatePublicFreshness({
  lastCheckedDate: record.last_checked_date ?? null,
  referenceDate,
});
const raceTime = (record: TimetableMeetingRow) => {
  if (record.first_race_time_local && record.last_race_time_local) return `${record.first_race_time_local}–${record.last_race_time_local}`;
  if (record.first_race_time_local) return `${record.first_race_time_local}–`;
  return '—';
};
const mediaTitle = (record: TimetableMeetingRow) => {
  if (!record.live_media) return undefined;
  return lang === 'ja'
    ? record.live_media.access_note_ja ?? `${record.live_media.provider_label}の公式ライブページ`
    : record.live_media.access_note_en ?? `Official live page from ${record.live_media.provider_label}`;
};
const hasStaleRecords = groups.some((group) => group.records.some((record) => freshnessFor(record).status === 'stale'));
---

{groups.length > 0 ? (
  <div class="timetable-date-groups">
    {hasStaleRecords && <p class="meeting-list__stale">{text.staleLegend}</p>}
    {groups.map((group) => (
      <section
        class="timetable-date-group"
        aria-labelledby={`date-${group.date}`}
        data-calendar-date-group={group.date}
      >
        {group.date && (
          <h2 id={`date-${group.date}`} tabindex="-1">
            {group.date}
            <small> · {group.records.length} {text.meetings}</small>
          </h2>
        )}
        <ul class="meeting-list" aria-label={group.date ? `${group.date} meetings` : 'Meetings'}>
          {group.records.map((record) => {
            const racecourse = displayRacecourse(record);
            const country = displayCountry(record);
            const authority = displayAuthority(record);
            const liveDetectorId = liveDetectorIdFor(record);
            return (
              <li
                class="meeting-row"
                data-calendar-meeting-row
                data-meeting-id={record.meeting_id}
                data-date={record.date}
                data-racecourse={racecourse}
                data-country={record.country_label}
                data-authority={record.authority_label}
                data-rank={record.capability_rank}
                data-live-available={String(record.live_media !== null)}
                data-live-platform={record.live_media?.platform ?? ''}
                data-media-id={record.live_media?.id ?? ''}
                data-live-detector-id={liveDetectorId}
                data-live-state="unknown"
              >
                <div class="meeting-row__identity">
                  <strong>{racecourse}</strong>
                </div>
                <p class="meeting-row__system">{country} · {authority}</p>
                <p class="meeting-row__time">{raceTime(record)}</p>
                <span class={`meeting-row__rank meeting-row__rank--${record.capability_rank.replace('+', 'plus')}`} title={`${lang === 'ja' ? '公開ランク' : 'Public rank'} ${record.capability_rank}`}>
                  {record.capability_rank}
                </span>
                <div class="meeting-row__links">
                  {record.live_media && (
                    <>
                      <span class="meeting-row__live-badge" data-live-badge hidden>{text.liveBadge}</span>
                      <a
                        href={record.live_media.landing_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={mediaTitle(record)}
                        data-live-link
                        data-live-default-href={record.live_media.landing_url}
                      >
                        {text.officialLive}
                      </a>
                    </>
                  )}
                  {record.detail_path && <a href={localizedDetailPath(record.detail_path)}>{text.detail}</a>}
                  <a href={record.official_source_url} target="_blank" rel="noopener noreferrer">{text.official}</a>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
) : (
  <p>{emptyLabel}</p>
)}

<style>
  .timetable-date-groups { display: grid; gap: 1.35rem; }
  .timetable-date-group h2 { margin-block-end: 0.45rem; }
  .timetable-date-group h2 small { font-size: 0.72rem; font-weight: 500; }
  .meeting-list__stale { font-size: 0.82rem; margin: 0; }
  .meeting-list { display: grid; list-style: none; margin: 0; padding: 0; }
  .meeting-row {
    align-items: center;
    border-block-end: 1px solid rgba(0, 0, 0, 0.12);
    display: grid;
    gap: 0.35rem 0.7rem;
    grid-template-columns: minmax(12rem, 1.45fr) minmax(10rem, 1fr) minmax(7rem, 0.65fr) 3rem minmax(13rem, auto);
    padding: 0.48rem 0.55rem;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }
  .meeting-row[data-live-state='live'] {
    background: #fff0f0;
    box-shadow: inset 0.25rem 0 0 #c40000;
  }
  .meeting-row[hidden], .timetable-date-group[hidden] { display: none; }
  .meeting-row__identity, .meeting-row__system, .meeting-row__time { min-width: 0; }
  .meeting-row[data-live-state='live'] .meeting-row__identity strong { color: #9d0000; }
  .meeting-row__system, .meeting-row__time { font-size: 0.82rem; margin: 0; }
  .meeting-row__rank { border: 1px solid var(--whr-color-border); border-radius: 999px; font-size: 0.74rem; font-weight: 700; justify-self: start; padding: 0.1rem 0.42rem; }
  .meeting-row__links { align-items: center; display: flex; flex-wrap: wrap; font-size: 0.8rem; gap: 0.25rem 0.65rem; justify-content: flex-end; white-space: nowrap; }
  .meeting-row__live-badge {
    background: #c40000;
    border-radius: 999px;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 0.16rem 0.42rem;
  }
  .meeting-row__live-badge[hidden] { display: none; }
  .meeting-row[data-live-state='live'] [data-live-link] {
    color: #a40000;
    font-weight: 800;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 760px) {
    .meeting-row { align-items: start; grid-template-columns: 1fr auto; padding: 0.62rem 0.35rem; }
    .meeting-row__system, .meeting-row__time { grid-column: 1; }
    .meeting-row__rank { grid-column: 2; grid-row: 1; }
    .meeting-row__links { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>
