---
import type { TimetableMeetingDayGroup, TimetableMeetingRow } from '../data/timetableMeetingRows';
import { getTimetableDateContext } from '../data/timetableMeetingRows';
import { evaluatePublicFreshness } from '../lib/timetable/publicFreshnessState.mjs';

type ViewMode = 'all' | 'today' | 'tomorrow' | 'window30';
type CommonProps = {
  emptyLabel?: string;
  lang?: 'en' | 'ja';
  viewMode?: ViewMode;
};
type Props =
  | (CommonProps & { groups: TimetableMeetingDayGroup[] })
  | (CommonProps & { records: TimetableMeetingRow[]; date?: string });

const props = Astro.props as Props;
const lang = props.lang ?? 'en';
const viewMode = props.viewMode ?? 'all';
const referenceDate = getTimetableDateContext().today;
const emptyLabel = props.emptyLabel ?? (lang === 'ja'
  ? '開催情報はまだありません。最終確認には公式ソースを使用してください。'
  : 'No meetings are listed yet. Use official source links for final confirmation.');
const groups: TimetableMeetingDayGroup[] = 'groups' in props
  ? props.groups
  : [{ date: props.date ?? props.records[0]?.date ?? '', records: props.records }]
      .filter((group) => group.records.length > 0);

const text = lang === 'ja'
  ? {
      authority: '主催', checked: '確認', country: '国', detail: '開催詳細',
      displayTimeZone: '表示タイムゾーン', first: '第1R', last: '最終R', official: '公式 ↗',
      rank: '公開ランク:', source: 'ソース', staleLegend: '古い確認を含みます。公式ソースで確認してください。',
      unknownFreshness: '確認日不明', venueTimeZone: '開催地TZ', liveStream: 'ライブ ↗', youtube: 'YouTube ↗',
    }
  : {
      authority: 'Authority', checked: 'Checked', country: 'Country', detail: 'Meeting detail',
      displayTimeZone: 'Display timezone', first: 'First', last: 'Last', official: 'Official ↗',
      rank: 'Public rank:', source: 'Source', staleLegend: 'Some checks are stale. Confirm with official sources.',
      unknownFreshness: 'Check date unknown', venueTimeZone: 'Venue TZ', liveStream: 'Live stream ↗', youtube: 'YouTube ↗',
    };

const jaRacecourseLabelById: Record<string, string> = {
  'tokyo-racecourse': '東京競馬場', 'obihiro-racecourse': '帯広競馬場',
  'sha-tin-racecourse': '沙田競馬場', 'happy-valley-racecourse': 'ハッピーバレー競馬場',
  'meydan-racecourse': 'メイダン競馬場', 'ankara-racecourse': 'アンカラ競馬場',
  'kocaeli-racecourse': 'コジャエリ競馬場',
};
const jaAuthorityLabelById: Record<string, string> = {
  jra: 'JRA', hkjc: 'HKJC', 'nar-local-government-racing': 'NAR',
  'banei-tokachi': 'ばんえい十勝', 'emirates-racing-authority': 'ERA',
  'turkiye-jokey-kulubu': 'TJK',
};
const jaCountryLabelById: Record<string, string> = {
  japan: '日本', 'hong-kong': '香港', 'united-arab-emirates': 'アラブ首長国連邦', turkey: 'トルコ',
};

const shouldShowFirst = (record: TimetableMeetingRow) => record.capability_rank !== 'C';
const shouldShowLast = (record: TimetableMeetingRow) =>
  record.capability_rank === 'B+' || record.capability_rank === 'A' || record.capability_rank === 'A+';
const localizedDetailPath = (detailPath: string) => lang === 'ja' ? `/ja${detailPath}` : detailPath;
const displayRacecourse = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaRacecourseLabelById[record.racecourse_id] ?? record.racecourse_name : record.racecourse_name;
const displayAuthority = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaAuthorityLabelById[record.authority_id] ?? record.authority_label : record.authority_label;
const displayCountry = (record: TimetableMeetingRow) =>
  lang === 'ja' ? jaCountryLabelById[record.country_id] ?? record.country_label : record.country_label;
const freshnessFor = (record: TimetableMeetingRow) => evaluatePublicFreshness({
  lastCheckedDate: record.last_checked_date ?? null,
  referenceDate,
});
const mediaTitle = (record: TimetableMeetingRow) => {
  if (!record.live_media) return undefined;
  return lang === 'ja'
    ? record.live_media.access_note_ja ?? `${record.live_media.provider_label}の公式ライブページ`
    : record.live_media.access_note_en ?? `Official live page from ${record.live_media.provider_label}`;
};
const hasStaleRecords = groups.some((group) => group.records.some((record) => freshnessFor(record).status === 'stale'));
---

<div class="timetable-timezone-projection" data-display-timezone-root data-lang={lang} data-view-mode={viewMode}>
  <div class="timezone-control">
    <label>
      <span>{text.displayTimeZone}</span>
      <select data-display-timezone-select aria-label={text.displayTimeZone}>
        <option value="Asia/Tokyo">Asia/Tokyo</option>
        <option value="UTC">UTC</option>
      </select>
    </label>
    <output data-display-timezone-status>Asia/Tokyo</output>
  </div>

  <div class="timetable-date-groups" data-timetable-date-groups>
    {hasStaleRecords && <p class="meeting-list__stale">{text.staleLegend}</p>}
    {groups.map((group) => (
      <section class="timetable-date-group" aria-labelledby={`date-${group.date}`} data-calendar-date-group={group.date}>
        {group.date && <h2 id={`date-${group.date}`} tabindex="-1">{group.date}</h2>}
        <ul class="meeting-list" aria-label={group.date ? `${group.date} meetings` : 'Meetings'}>
          {group.records.map((record) => {
            const racecourse = displayRacecourse(record);
            const mediaLabel = record.live_media?.platform === 'youtube' ? text.youtube : text.liveStream;
            return (
              <li
                class="meeting-row"
                data-calendar-meeting-row
                data-meeting-id={record.meeting_id}
                data-date={record.date}
                data-racecourse={racecourse}
                data-country={record.country_label}
                data-authority={record.authority_label}
                data-rank={record.capability_rank}
                data-live-available={String(record.live_media !== null)}
                data-live-platform={record.live_media?.platform ?? ''}
                data-media-id={record.live_media?.id ?? ''}
              >
                <span
                  hidden
                  data-meeting-projection
                  data-meeting-id={record.meeting_id}
                  data-source-date={record.date}
                  data-source-timezone={record.timezone}
                  data-first-race-time={record.first_race_time_local ?? ''}
                  data-last-race-time={record.last_race_time_local ?? ''}
                ></span>
                <div class="meeting-row__identity">
                  <strong>{racecourse}</strong>
                  <span>{text.rank} {record.capability_rank}</span>
                </div>
                <p class="meeting-row__meta">
                  <span>{text.authority}: {displayAuthority(record)}</span>
                  <span>{text.country}: {displayCountry(record)}</span>
                  {shouldShowFirst(record) && record.first_race_time_local && (
                    <span>{text.first}: <time data-race-time="first">{record.first_race_time_local}</time></span>
                  )}
                  {shouldShowLast(record) && record.last_race_time_local && (
                    <span>{text.last}: <time data-race-time="last">{record.last_race_time_local}</time></span>
                  )}
                  <span>{text.venueTimeZone}: {record.timezone}</span>
                  <span>{text.source}: {record.source_status}</span>
                  {freshnessFor(record).status === 'unknown' ? (
                    <strong>{text.unknownFreshness}</strong>
                  ) : (
                    <span>{text.checked}: {record.last_checked_date}</span>
                  )}
                </p>
                <div class="meeting-row__links">
                  {record.live_media && (
                    <a href={record.live_media.landing_url} target="_blank" rel="noopener noreferrer" title={mediaTitle(record)} data-live-link>
                      {mediaLabel}
                    </a>
                  )}
                  {record.detail_path && <a href={localizedDetailPath(record.detail_path)}>{text.detail}</a>}
                  <a href={record.official_source_url} target="_blank" rel="noopener noreferrer">{text.official}</a>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
  <p data-projected-empty hidden>{emptyLabel}</p>
</div>

<script>
  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try {
      new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0));
      return true;
    } catch {
      return false;
    }
  };

  const dateParts = (instant, timeZone) => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
    }).formatToParts(instant);
    return Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
  };

  const addDateDays = (dateText, days) => {
    const date = new Date(`${dateText}T00:00:00.000Z`);
    date.setUTCDate(date.getUTCDate() + days);
    return date.toISOString().slice(0, 10);
  };

  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText);
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText);
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(
      Number(dateMatch[1]), Number(dateMatch[2]) - 1, Number(dateMatch[3]),
      Number(timeMatch[1]), Number(timeMatch[2]), Number(timeMatch[3] ?? '0'),
    );
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(
        Number(parts.year), Number(parts.month) - 1, Number(parts.day),
        Number(parts.hour), Number(parts.minute), Number(parts.second),
      );
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };

  const formatProjectedDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };
  const formatProjectedTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', {
    timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
  }).format(instant);

  const populateTimeZones = (select) => {
    const supportedValuesOf = Intl.supportedValuesOf;
    const zones = typeof supportedValuesOf === 'function'
      ? supportedValuesOf.call(Intl, 'timeZone')
      : ['UTC', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Dubai', 'Europe/London', 'Europe/Paris', 'America/New_York', 'America/Los_Angeles', 'Australia/Sydney'];
    const values = Array.from(new Set(['UTC', ...zones]));
    select.replaceChildren(...values.map((zone) => {
      const option = document.createElement('option');
      option.value = zone;
      option.textContent = zone;
      return option;
    }));
  };

  const propagateTimeZoneToLinks = (root, timeZone) => {
    root.querySelectorAll('a[href]').forEach((anchor) => {
      const rawHref = anchor.getAttribute('href');
      if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:')) return;
      const url = new URL(rawHref, window.location.href);
      if (url.origin !== window.location.origin) return;
      url.searchParams.set('tz', timeZone);
      anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    });
  };

  const matchesView = (displayDate, viewMode, today) => {
    if (viewMode === 'today') return displayDate === today;
    if (viewMode === 'tomorrow') return displayDate === addDateDays(today, 1);
    if (viewMode === 'window30') return displayDate >= today && displayDate < addDateDays(today, 30);
    return true;
  };

  const projectRoot = (root, timeZone) => {
    const rows = Array.from(root.querySelectorAll('.meeting-row'));
    const today = formatProjectedDate(new Date(), timeZone);
    const viewMode = root.dataset.viewMode || 'all';

    rows.forEach((row) => {
      const metadata = row.querySelector('[data-meeting-projection]');
      if (!(metadata instanceof HTMLElement)) return;
      const sourceDate = metadata.dataset.sourceDate;
      const sourceTimeZone = metadata.dataset.sourceTimezone;
      const firstTime = metadata.dataset.firstRaceTime;
      const lastTime = metadata.dataset.lastRaceTime;
      if (!sourceDate || !sourceTimeZone) return;

      let projectedDate = sourceDate;
      if (firstTime) {
        const instant = localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone);
        if (instant) projectedDate = formatProjectedDate(instant, timeZone);
      }
      metadata.dataset.displayDate = projectedDate;
      row.dataset.date = projectedDate;

      const firstElement = row.querySelector('[data-race-time="first"]');
      if (firstElement && firstTime) {
        const instant = localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone);
        if (instant) {
          firstElement.textContent = formatProjectedTime(instant, timeZone);
          firstElement.setAttribute('datetime', instant.toISOString());
        }
      }
      const lastElement = row.querySelector('[data-race-time="last"]');
      if (lastElement && lastTime) {
        const instant = localDateTimeToInstant(sourceDate, lastTime, sourceTimeZone);
        if (instant) {
          lastElement.textContent = formatProjectedTime(instant, timeZone);
          lastElement.setAttribute('datetime', instant.toISOString());
        }
      }
    });

    const visibleRows = rows.filter((row) => {
      const metadata = row.querySelector('[data-meeting-projection]');
      if (!(metadata instanceof HTMLElement)) return false;
      const displayDate = metadata.dataset.displayDate || metadata.dataset.sourceDate || '';
      return matchesView(displayDate, viewMode, today);
    });

    const groupsContainer = root.querySelector('[data-timetable-date-groups]');
    if (groupsContainer) {
      groupsContainer.querySelectorAll('.timetable-date-group').forEach((section) => section.remove());
      const grouped = new Map();
      visibleRows.forEach((row) => {
        const metadata = row.querySelector('[data-meeting-projection]');
        if (!(metadata instanceof HTMLElement)) return;
        const date = metadata.dataset.displayDate || metadata.dataset.sourceDate || '';
        if (!grouped.has(date)) grouped.set(date, []);
        grouped.get(date).push(row);
      });
      Array.from(grouped.keys()).sort().forEach((date) => {
        const section = document.createElement('section');
        section.className = 'timetable-date-group';
        section.dataset.calendarDateGroup = date;
        section.setAttribute('aria-labelledby', `date-${date}`);
        const heading = document.createElement('h2');
        heading.id = `date-${date}`;
        heading.tabIndex = -1;
        heading.textContent = date;
        const list = document.createElement('ul');
        list.className = 'meeting-list';
        list.setAttribute('aria-label', `${date} meetings`);
        grouped.get(date).forEach((row) => list.append(row));
        section.append(heading, list);
        groupsContainer.append(section);
      });
    }

    const empty = root.querySelector('[data-projected-empty]');
    if (empty instanceof HTMLElement) empty.hidden = visibleRows.length !== 0;
    const status = root.querySelector('[data-display-timezone-status]');
    if (status) status.textContent = timeZone;
    propagateTimeZoneToLinks(root, timeZone);
  };

  document.querySelectorAll('[data-display-timezone-root]').forEach((root) => {
    const select = root.querySelector('[data-display-timezone-select]');
    if (!(select instanceof HTMLSelectElement)) return;
    populateTimeZones(select);
    const queryTimeZone = new URL(window.location.href).searchParams.get('tz');
    const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const initialTimeZone = isTimeZoneSupported(queryTimeZone)
      ? queryTimeZone
      : isTimeZoneSupported(browserTimeZone) ? browserTimeZone : 'Asia/Tokyo';
    select.value = initialTimeZone;
    projectRoot(root, initialTimeZone);
    window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: { timeZone: initialTimeZone } }));
    select.addEventListener('change', () => {
      const selected = isTimeZoneSupported(select.value) ? select.value : 'Asia/Tokyo';
      const url = new URL(window.location.href);
      url.searchParams.set('tz', selected);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      projectRoot(root, selected);
      window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: { timeZone: selected } }));
    });
  });
</script>

<style>
  .timetable-timezone-projection { display: grid; gap: 1rem; }
  .timezone-control { align-items: end; display: flex; flex-wrap: wrap; gap: 0.5rem 0.8rem; }
  .timezone-control label { display: grid; font-size: 0.82rem; gap: 0.2rem; }
  .timezone-control select { max-width: min(24rem, 80vw); padding: 0.38rem 0.5rem; }
  .timezone-control output, .meeting-list__stale { font-size: 0.82rem; opacity: 0.72; }
  .meeting-list__stale { margin: 0; }
  .timetable-date-groups { display: grid; gap: 1.35rem; }
  .timetable-date-group h2 { margin-block-end: 0.45rem; }
  .timetable-date-group[data-query-focused="true"] h2 { text-decoration: underline; text-underline-offset: 0.2em; }
  .meeting-list { display: grid; list-style: none; margin: 0; padding: 0; }
  .meeting-row {
    align-items: center; border-block-end: 1px solid rgba(0, 0, 0, 0.12); display: grid;
    gap: 0.2rem 0.7rem; grid-template-columns: minmax(11rem, 1.05fr) minmax(19rem, 2.25fr) auto; padding: 0.48rem 0;
  }
  .meeting-row[hidden], .timetable-date-group[hidden] { display: none; }
  .meeting-row__identity { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.2rem 0.55rem; }
  .meeting-row__identity span, .meeting-row__meta, .meeting-row__links { font-size: 0.82rem; }
  .meeting-row__meta { display: flex; flex-wrap: wrap; gap: 0.15rem 0.65rem; margin: 0; }
  .meeting-row__links { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; justify-content: flex-end; white-space: nowrap; }
  @media (max-width: 760px) {
    .meeting-row { align-items: start; grid-template-columns: 1fr; padding: 0.6rem 0; }
    .meeting-row__links { justify-content: flex-start; }
  }
</style>
