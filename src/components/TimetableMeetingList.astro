  .meeting-row__system, .meeting-row__time { font-size: .82rem; margin: 0; }
  .meeting-row__country-flag { display: inline-block; margin-inline-end: .32rem; font-size: 1rem; line-height: 1; vertical-align: -0.08em; }
  .meeting-row__rank { border: 1px solid var(--whr-color-border); border-radius: 999px; font-size: .74rem; font-weight: 700; justify-self: start; padding: .1rem .42rem; }
  .meeting-row__links { align-items: center; display: flex; flex-wrap: wrap; font-size: .8rem; gap: .25rem .65rem; justify-content: flex-end; white-space: nowrap; }
  .meeting-row__meeting-badge { border-radius: 999px; font-size: .7rem; font-weight: 800; padding: .16rem .42rem; }
  .meeting-row__meeting-badge--today, .meeting-row__meeting-badge--upcoming { border: 1px solid var(--whr-color-border); }
  .meeting-row__meeting-badge--running { background: #c40000; color: #fff; }
  .meeting-row__meeting-badge--ended { background: #666; color: #fff; }
  .meeting-row__meeting-badge[hidden] { display: none; }
  .meeting-row__stream[data-stream-state='live'] .meeting-row__watch-direct { color: #a40000; font-weight: 800; text-decoration-thickness: 2px; }
  @media (max-width: 1023px) {
    .meeting-row { align-items: start; grid-template-columns: minmax(0,1fr) auto; padding: .62rem .35rem; }
    .meeting-row__system { grid-column: 1 / -1; }
    .meeting-row__time { grid-column: 1; }
    .meeting-row__time[data-time-empty='true'] { min-height: 0; }
    .meeting-row__rank { grid-column: 2; grid-row: 1; }
    .meeting-row__links { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>