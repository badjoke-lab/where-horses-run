---
import type { TimetableMeetingDayGroup, TimetableMeetingRow } from '../data/timetableMeetingRows';
import { getTimetableDateContext } from '../data/timetableMeetingRows';
import { getCountries, getRacecourses } from '../lib/data';
import { evaluatePublicFreshness } from '../lib/timetable/publicFreshnessState.mjs';
import {
  getCalendarAuthorityDisplayName,
  getCalendarCountryDisplayName,
  getCalendarCountryFlagEmoji,
  getCalendarRacecourseDisplayName,
  getCalendarRacecourseSearchAliases,
} from '../lib/calendarDisplayNames';

type ProjectionScope = 'all' | 'today' | 'tomorrow' | 'rolling-30';
type CommonProps = { emptyLabel?: string; lang?: 'en' | 'ja'; scope?: ProjectionScope };
type Props = CommonProps & (
  | { groups: TimetableMeetingDayGroup[] }
  | { records: TimetableMeetingRow[]; date?: string }
);

const props = Astro.props as Props;
const lang = props.lang ?? 'en';
const projectionScope = props.scope ?? 'all';
const referenceDate = getTimetableDateContext().today;
const emptyLabel = props.emptyLabel ?? (lang === 'ja'
  ? '開催情報はまだありません。最終確認には公式ソースを使用してください。'
  : 'No meetings are listed yet. Use official source links for final confirmation.');
const groups: TimetableMeetingDayGroup[] = 'groups' in props
  ? props.groups
  : [{ date: props.date ?? props.records[0]?.date ?? '', records: props.records }]
      .filter((group) => group.records.length > 0);
const countriesById = new Map(getCountries().map((country) => [country.id, country]));
const racecoursesById = new Map(getRacecourses().map((racecourse) => [racecourse.id, racecourse]));
const localePrefix = lang === 'ja' ? '/ja' : '';
const countryHrefFor = (record: TimetableMeetingRow) => {
  const country = countriesById.get(record.country_id);
  return country?.slug ? `${localePrefix}/countries/${country.slug}/` : null;
};
const racecourseHrefFor = (record: TimetableMeetingRow) => {
  const racecourse = racecoursesById.get(record.racecourse_id);
  return racecourse?.slug ? `${localePrefix}/tracks/${racecourse.slug}/` : null;
};

const text = lang === 'ja'
  ? {
      detail: '詳細',
      meetingToday: '本日開催',
      meetingUpcoming: '開催前',
      meetingRunning: '開催中',
      meetingEnded: '終了',
      officialStream: '公式配信 ↗',
      watch: 'Watch',
      watchOptions: '配信先',
      open: '開く ↗',
      close: '閉じる',
      meetings: '開催',
      officialSite: '公式サイト ↗',
      staleLegend: '古い確認を含みます。公式ソースで確認してください。',
      displayTimeZone: '表示タイムゾーン',
      columns: {
        racecourse: '競馬場',
        system: '国・主催',
        time: '時刻',
        status: '状態',
        stream: '配信',
        detail: '詳細',
        map: '地図',
        source: '公式',
      },
    }
  : {
      detail: 'Details',
      meetingToday: 'Today meeting',
      meetingUpcoming: 'Upcoming',
      meetingRunning: 'Racing now',
      meetingEnded: 'Finished',
      officialStream: 'Official stream ↗',
      watch: 'Watch',
      watchOptions: 'Watch options',
      open: 'Open ↗',
      close: 'Close',
      meetings: 'meetings',
      officialSite: 'Official site ↗',
      staleLegend: 'Some checks are stale. Confirm with official sources.',
      displayTimeZone: 'Display timezone',
      columns: {
        racecourse: 'Racecourse',
        system: 'Country / authority',
        time: 'Time',
        status: 'Status',
        stream: 'Watch',
        detail: 'Details',
        map: 'Map',
        source: 'Source',
      },
    };

const timeZoneOptions = [
  { value: 'Asia/Tokyo', label: lang === 'ja' ? '日本 — UTC+09:00' : 'Japan — UTC+09:00' },
  { value: 'Asia/Seoul', label: lang === 'ja' ? '韓国 — UTC+09:00' : 'South Korea — UTC+09:00' },
  { value: 'Asia/Hong_Kong', label: lang === 'ja' ? '香港 — UTC+08:00' : 'Hong Kong — UTC+08:00' },
  { value: 'Asia/Dubai', label: lang === 'ja' ? 'アラブ首長国連邦 — UTC+04:00' : 'United Arab Emirates — UTC+04:00' },
  { value: 'Europe/Istanbul', label: lang === 'ja' ? 'トルコ — UTC+03:00' : 'Türkiye — UTC+03:00' },
  { value: 'UTC', label: 'UTC — UTC+00:00' },
];

const liveDetectorMediaIds = new Set([
  'jra-youtube-live-2026',
  'banei-youtube-live-2026',
  'nar-monbetsu-youtube-live-2026',
  'nar-iwate-youtube-live-2026',
  'nar-urawa-youtube-live-2026',
  'nar-funabashi-youtube-live-2026',
  'nar-oi-youtube-live-2026',
  'nar-kawasaki-youtube-live-2026',
  'nar-kanazawa-youtube-live-2026',
  'nar-kasamatsu-youtube-live-2026',
  'nar-nagoya-youtube-live-2026',
  'nar-hyogo-youtube-live-2026',
  'nar-kochi-youtube-live-2026',
  'nar-saga-youtube-live-2026',
  'jcsa-youtube-live-2026',
]);
const liveDetectorIdForMedia = (media: TimetableMeetingRow['live_media'][number]) =>
  media.platform === 'youtube' && liveDetectorMediaIds.has(media.id) ? media.id : '';
const localizedDetailPath = (detailPath: string) => lang === 'ja' ? `/ja${detailPath}` : detailPath;
const displayRacecourse = (record: TimetableMeetingRow) => getCalendarRacecourseDisplayName(record.racecourse_id, record.racecourse_name, lang);
const displayAuthority = (record: TimetableMeetingRow) => getCalendarAuthorityDisplayName(record.authority_id, record.authority_label, lang);
const displayCountry = (record: TimetableMeetingRow) => getCalendarCountryDisplayName(record.country_id, record.country_label, lang);
const displayCountryFlag = (record: TimetableMeetingRow) => getCalendarCountryFlagEmoji(record.country_id);
const freshnessFor = (record: TimetableMeetingRow) => evaluatePublicFreshness({ lastCheckedDate: record.last_checked_date ?? null, referenceDate });
const raceTime = (record: TimetableMeetingRow) => {
  if (record.first_race_time_local && record.last_race_time_local) return `${record.first_race_time_local}–${record.last_race_time_local}`;
  if (record.first_race_time_local) return `${record.first_race_time_local}–`;
  return '';
};
const mediaTitle = (media: TimetableMeetingRow['live_media'][number]) => lang === 'ja'
  ? media.access_note_ja ?? `${media.provider_label}の公式配信ページ`
  : media.access_note_en ?? `Official stream page from ${media.provider_label}`;
const mediaBadgeLabels = lang === 'ja'
  ? {
      free: '無料',
      account_required: '会員',
      betting_account_required: '投票口座',
      paid: '有料',
      geo_restricted: '地域制限',
      access_unknown: '条件未確認',
      selected_meetings: '一部配信',
      feature_only: '特定競走',
      seasonal: '季節限定',
    }
  : {
      free: 'FREE',
      account_required: 'ACCOUNT',
      betting_account_required: 'BETTING ACCOUNT',
      paid: 'PAID',
      geo_restricted: 'GEO',
      access_unknown: 'ACCESS ?',
      selected_meetings: 'SELECTED',
      feature_only: 'FEATURE ONLY',
      seasonal: 'SEASONAL',
    };
const mediaBadges = (media: TimetableMeetingRow['live_media'][number]) => {
  const accessBadges = media.access_tags
    .map((tag) => mediaBadgeLabels[tag])
    .filter(Boolean);
  const coverageBadge = media.coverage === 'all_meetings'
    ? null
    : mediaBadgeLabels[media.coverage];
  return coverageBadge ? [...accessBadges, coverageBadge] : accessBadges;
};
const mediaConditionLabel = (media: TimetableMeetingRow['live_media'][number]) =>
  mediaBadges(media).join(lang === 'ja' ? '・' : ' · ');
const singleWatchDefaultLabel = (media: TimetableMeetingRow['live_media'][number]) => {
  const condition = mediaConditionLabel(media);
  return condition ? `${text.watch} · ${condition}` : text.watch;
};
const singleWatchLiveLabel = () => `● LIVE · ${text.watch}`;
const multipleWatchDefaultLabel = (count: number) => `${text.watch} ${count}`;
const multipleWatchLiveLabel = (count: number) => `● LIVE · ${text.watch} ${count}`;
const isMeetingStateEligible = (record: TimetableMeetingRow) =>
  Boolean(record.first_race_time_local && record.last_race_time_local);
const hasStaleRecords = groups.some((group) => group.records.some((record) => freshnessFor(record).status === 'stale'));
---

<div class="timetable-timezone-projection" data-display-timezone-root data-lang={lang} data-projection-scope={projectionScope}>
  <div class="timezone-control">
    <label>
      <span>{text.displayTimeZone}</span>
      <select data-display-timezone-select aria-label={text.displayTimeZone}>
        {timeZoneOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
    <output data-display-timezone-status>{timeZoneOptions[0].label}</output>
  </div>

  <div class="timetable-date-groups" data-timetable-date-groups>
    {hasStaleRecords && <p class="meeting-list__stale">{text.staleLegend}</p>}
    {groups.map((group) => (
      <section class="timetable-date-group" aria-labelledby={`date-${group.date}`} data-calendar-date-group={group.date}>
        {group.date && <h2 id={`date-${group.date}`} tabindex="-1">{group.date}<small> · {group.records.length} {text.meetings}</small></h2>}
        <ul class="meeting-list" aria-label={group.date ? `${group.date} ${text.meetings}` : text.meetings}>
          <li class="meeting-list__columns" aria-hidden="true">
            <span>{text.columns.racecourse}</span>
            <span>{text.columns.system}</span>
            <span>{text.columns.time}</span>
            <span aria-hidden="true"></span>
            <span>{text.columns.status}</span>
            <span class="meeting-list__columns-actions">
              <span>{text.columns.stream}</span>
              <span>{text.columns.detail}</span>
              <span>{text.columns.map}</span>
              <span>{text.columns.source}</span>
            </span>
          </li>
          {group.records.map((record) => {
            const racecourse = displayRacecourse(record);
            const racecourseSearch = getCalendarRacecourseSearchAliases(record.racecourse_id, record.racecourse_name).join(' | ');
            const detectorIds = record.live_media.map(liveDetectorIdForMedia).filter(Boolean);
            const firstMedia = record.live_media[0] ?? null;
            const racecourseHref = racecourseHrefFor(record);
            const countryHref = countryHrefFor(record);
            const countryLabel = displayCountry(record);
            const countryFlag = displayCountryFlag(record);
            const mediaCount = record.live_media.length;
            const watchDefaultLabel = mediaCount > 1 ? multipleWatchDefaultLabel(mediaCount) : '';
            const watchLiveLabel = mediaCount > 1 ? multipleWatchLiveLabel(mediaCount) : '';
            return (
              <li
                class="meeting-row"
                data-calendar-meeting-row
                data-meeting-id={record.meeting_id}
                data-date={record.date}
                data-source-date={record.date}
                data-source-timezone={record.timezone}
                data-first-race-time={record.first_race_time_local ?? ''}
                data-last-race-time={record.last_race_time_local ?? ''}
                data-racecourse={racecourse}
                data-racecourse-search={racecourseSearch}
                data-country={record.country_id}
                data-authority={record.authority_id}
                data-rank={record.capability_rank}
                data-live-available={String(record.live_media.length > 0)}
                data-live-media-count={String(record.live_media.length)}
                data-live-platform={firstMedia?.platform ?? ''}
                data-live-provider={firstMedia?.provider_label ?? ''}
                data-live-access={firstMedia?.access ?? ''}
                data-live-access-tags={firstMedia?.access_tags.join(',') ?? ''}
                data-live-coverage={firstMedia?.coverage ?? ''}
                data-media-id={firstMedia?.id ?? ''}
                data-live-detector-id={detectorIds.join(',')}
                data-meeting-state-eligible={String(isMeetingStateEligible(record))}
                data-meeting-state="unknown"
                data-meeting-presentation-state="unknown"
                data-meeting-day-state="unknown"
                data-stream-state="unknown"
                data-timezone-scope-hidden="false"
              >
                <div class="meeting-row__identity"><strong>{racecourseHref ? <a href={racecourseHref} data-no-timezone-propagation>{racecourse}</a> : racecourse}</strong></div>
                <p class="meeting-row__system"><span class="meeting-row__country-flag" aria-hidden="true">{countryFlag}</span>{countryHref ? <a href={countryHref} data-no-timezone-propagation>{countryLabel}</a> : countryLabel} · {displayAuthority(record)}</p>
                <p class="meeting-row__time" title={`${lang === 'ja' ? '開催地タイムゾーン' : 'Venue timezone'}: ${record.timezone}`} data-source-time-label={raceTime(record)} data-time-empty={String(!record.first_race_time_local)}>
                  {record.first_race_time_local ? <><time data-race-time="first">{record.first_race_time_local}</time>{record.last_race_time_local && <>–<time data-race-time="last">{record.last_race_time_local}</time></>}</> : null}
                </p>
                <span class={`meeting-row__rank meeting-row__rank--${record.capability_rank.replace('+', 'plus')}`} title={`${lang === 'ja' ? '公開ランク' : 'Public rank'} ${record.capability_rank}`}>{record.capability_rank}</span>
                <div class="meeting-row__status">
                  <span class="meeting-row__meeting-badge meeting-row__meeting-badge--today" data-meeting-today-badge hidden>{text.meetingToday}</span>
                  <span class="meeting-row__meeting-badge meeting-row__meeting-badge--upcoming" data-meeting-upcoming-badge hidden>{text.meetingUpcoming}</span>
                  <span class="meeting-row__meeting-badge meeting-row__meeting-badge--running" data-meeting-running-badge hidden>{text.meetingRunning}</span>
                  <span class="meeting-row__meeting-badge meeting-row__meeting-badge--ended" data-meeting-ended-badge hidden>{text.meetingEnded}</span>
                </div>
                <div class="meeting-row__links">
                  {mediaCount === 1 && record.live_media[0] && (() => {
                    const media = record.live_media[0];
                    const detectorId = liveDetectorIdForMedia(media);
                    const defaultLabel = singleWatchDefaultLabel(media);
                    const liveLabel = singleWatchLiveLabel();
                    return (
                      <span class="meeting-row__stream meeting-row__stream--single" data-media-route data-media-id={media.id} data-live-detector-id={detectorId}>
                        <a
                          class="meeting-row__watch-direct"
                          href={media.landing_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={mediaTitle(media)}
                          data-live-link
                          data-live-default-href={media.landing_url}
                          data-live-default-label={defaultLabel}
                          data-live-live-label={liveLabel}
                          data-live-detector-id={detectorId}
                          data-live-role="watch-direct"
                        >{defaultLabel}</a>
                      </span>
                    );
                  })()}
                  {mediaCount > 1 && (
                    <details class="meeting-row__watch-menu" data-watch-menu>
                      <summary
                        class="meeting-row__watch-summary"
                        data-watch-summary
                        data-watch-default-label={watchDefaultLabel}
                        data-watch-live-label={watchLiveLabel}
                      ><span data-watch-summary-label>{watchDefaultLabel}</span></summary>
                      <div class="meeting-row__watch-panel" role="group" aria-label={`${text.watchOptions}: ${racecourse}`}>
                        <div class="meeting-row__watch-panel-head">
                          <div>
                            <strong>{text.watchOptions}</strong>
                            <small>{racecourse} · {countryLabel} · {displayAuthority(record)}</small>
                          </div>
                          <button type="button" class="meeting-row__watch-close" data-watch-close aria-label={text.close}>×</button>
                        </div>
                        <div class="meeting-row__watch-options">
                          {record.live_media.map((media) => {
                            const detectorId = liveDetectorIdForMedia(media);
                            const condition = mediaConditionLabel(media);
                            return (
                              <div class="meeting-row__watch-option" data-media-route data-media-id={media.id} data-live-detector-id={detectorId}>
                                <div class="meeting-row__watch-provider">
                                  <span class="meeting-row__watch-live" data-provider-live-indicator hidden>● LIVE</span>
                                  <strong>{media.provider_label}</strong>
                                  {condition && <small>{condition}</small>}
                                </div>
                                <a
                                  href={media.landing_url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  title={mediaTitle(media)}
                                  data-live-link
                                  data-live-default-href={media.landing_url}
                                  data-live-default-label={text.open}
                                  data-live-live-label={text.open}
                                  data-live-detector-id={detectorId}
                                  data-live-role="provider-open"
                                >{text.open}</a>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    </details>
                  )}
                  {record.detail_path && <a class="meeting-row__detail-link" href={localizedDetailPath(record.detail_path)}>{text.detail}</a>}
                  <a class="meeting-row__official-link" href={record.official_source_url} target="_blank" rel="noopener noreferrer">{text.officialSite}</a>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
  <p data-timezone-scope-empty hidden={groups.length > 0}>{emptyLabel}</p>
</div>

<script>
  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try { new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0)); return true; } catch { return false; }
  };
  const curatedTimeZones = (isJa) => [
    ['Asia/Tokyo', isJa ? '日本 — UTC+09:00' : 'Japan — UTC+09:00'],
    ['Asia/Seoul', isJa ? '韓国 — UTC+09:00' : 'South Korea — UTC+09:00'],
    ['Asia/Hong_Kong', isJa ? '香港 — UTC+08:00' : 'Hong Kong — UTC+08:00'],
    ['Asia/Dubai', isJa ? 'アラブ首長国連邦 — UTC+04:00' : 'United Arab Emirates — UTC+04:00'],
    ['Europe/Istanbul', isJa ? 'トルコ — UTC+03:00' : 'Türkiye — UTC+03:00'],
    ['UTC', 'UTC — UTC+00:00'],
  ];
  const isCuratedTimeZone = (timeZone) => curatedTimeZones(false).some(([value]) => value === timeZone);
  const displayTimeZone = (timeZone, isJa) => curatedTimeZones(isJa).find(([value]) => value === timeZone)?.[1] ?? timeZone;
  const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
    timeZone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
  }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(Number(dateMatch[1]), Number(dateMatch[2]) - 1, Number(dateMatch[3]), Number(timeMatch[1]), Number(timeMatch[2]), Number(timeMatch[3] ?? '0'));
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second));
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };
  const formatProjectedDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };
  const formatProjectedTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(instant);
  const addDateDays = (dateText, days) => {
    const date = new Date(`${dateText}T00:00:00.000Z`);
    date.setUTCDate(date.getUTCDate() + days);
    return date.toISOString().slice(0, 10);
  };
  const scopeWindowFor = (scope, timeZone) => {
    const today = formatProjectedDate(new Date(), timeZone);
    if (scope === 'today') return { start: today, endExclusive: addDateDays(today, 1), targetDate: today, windowStart: null, windowEndInclusive: null };
    if (scope === 'tomorrow') {
      const tomorrow = addDateDays(today, 1);
      return { start: tomorrow, endExclusive: addDateDays(tomorrow, 1), targetDate: tomorrow, windowStart: null, windowEndInclusive: null };
    }
    if (scope === 'rolling-30') {
      const endExclusive = addDateDays(today, 30);
      return { start: today, endExclusive, targetDate: null, windowStart: today, windowEndInclusive: addDateDays(endExclusive, -1) };
    }
    return { start: null, endExclusive: null, targetDate: null, windowStart: null, windowEndInclusive: null };
  };
  const populateTimeZones = (select, isJa) => {
    select.replaceChildren(...curatedTimeZones(isJa).map(([value, label]) => {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = label;
      return option;
    }));
  };
  const propagateTimeZoneToLinks = (root, timeZone) => {
    root.querySelectorAll('a[href]').forEach((anchor) => {
      if (anchor.hasAttribute('data-no-timezone-propagation')) return;
      const rawHref = anchor.getAttribute('href');
      if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:')) return;
      const url = new URL(rawHref, window.location.href);
      if (url.origin !== window.location.origin) return;
      url.searchParams.set('tz', timeZone);
      anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    });
  };
  const setMeetingDayState = (row, now = Date.now()) => {
    if (!(row instanceof HTMLElement)) return;
    const sourceDate = row.dataset.sourceDate || '';
    const sourceTimeZone = row.dataset.sourceTimezone || '';
    if (!sourceDate || !isTimeZoneSupported(sourceTimeZone)) {
      row.dataset.meetingDayState = 'unknown';
      return;
    }
    const currentDate = formatProjectedDate(new Date(now), sourceTimeZone);
    row.dataset.meetingDayState = sourceDate < currentDate ? 'past' : sourceDate > currentDate ? 'future' : 'today';
  };
  const setMeetingState = (row, now = Date.now()) => {
    if (!(row instanceof HTMLElement)) return;
    setMeetingDayState(row, now);
    if (row.dataset.meetingStateEligible !== 'true') {
      row.dataset.meetingState = 'unknown';
      return;
    }
    const sourceDate = row.dataset.sourceDate || '';
    const sourceTimeZone = row.dataset.sourceTimezone || '';
    const firstTime = row.dataset.firstRaceTime || '';
    const lastTime = row.dataset.lastRaceTime || '';
    const start = localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone);
    const rawEnd = localDateTimeToInstant(sourceDate, lastTime, sourceTimeZone);
    if (!start || !rawEnd) { row.dataset.meetingState = 'unknown'; return; }
    let endMs = rawEnd.getTime();
    if (endMs < start.getTime()) endMs += 86_400_000;
    row.dataset.sortStart = String(start.getTime());
    row.dataset.meetingState = now < start.getTime() ? 'upcoming' : now <= endMs ? 'running' : 'ended';
  };
  const rowSort = (left, right) => {
    const leftStart = Number(left.dataset.sortStart || Number.POSITIVE_INFINITY);
    const rightStart = Number(right.dataset.sortStart || Number.POSITIVE_INFINITY);
    if (leftStart !== rightStart) return leftStart - rightStart;
    const venue = (left.dataset.racecourse || '').localeCompare(right.dataset.racecourse || '');
    if (venue !== 0) return venue;
    return (left.dataset.meetingId || '').localeCompare(right.dataset.meetingId || '');
  };
  const createColumnHeader = (uiLang) => {
    const labels = uiLang === 'ja'
      ? { racecourse: '競馬場', system: '国・主催', time: '時刻', rank: 'ランク', status: '状態', stream: '配信', detail: '詳細', map: '地図', source: '公式' }
      : { racecourse: 'Racecourse', system: 'Country / authority', time: 'Time', rank: 'Rank', status: 'Status', stream: 'Watch', detail: 'Details', map: 'Map', source: 'Source' };
    const header = document.createElement('li');
    header.className = 'meeting-list__columns';
    header.setAttribute('aria-hidden', 'true');
    header.innerHTML = `<span>${labels.racecourse}</span><span>${labels.system}</span><span>${labels.time}</span><span>${labels.rank}</span><span>${labels.status}</span><span class="meeting-list__columns-actions"><span>${labels.stream}</span><span>${labels.detail}</span><span>${labels.map}</span><span>${labels.source}</span></span>`;
    return header;
  };
  const moveMapActionIntoLinks = (root) => {
    root.querySelectorAll('[data-calendar-meeting-row]').forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const mapAction = row.querySelector('.meeting-row__map-focus');
      const links = row.querySelector('.meeting-row__links');
      if (!(mapAction instanceof HTMLElement) || !(links instanceof HTMLElement) || mapAction.parentElement === links) return;
      const official = links.querySelector('.meeting-row__official-link');
      links.insertBefore(mapAction, official);
    });
  };
  const installMeetingRowUi = (root) => {
    moveMapActionIntoLinks(root);
    const observer = new MutationObserver(() => moveMapActionIntoLinks(root));
    observer.observe(root, { childList: true, subtree: true });
    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const close = target.closest('[data-watch-close]');
      if (close) {
        const menu = close.closest('[data-watch-menu]');
        if (menu instanceof HTMLDetailsElement) menu.open = false;
        return;
      }
      const summary = target.closest('[data-watch-summary]');
      if (summary) {
        const current = summary.closest('[data-watch-menu]');
        root.querySelectorAll('[data-watch-menu][open]').forEach((menu) => {
          if (menu !== current && menu instanceof HTMLDetailsElement) menu.open = false;
        });
      }
    });
  };
  const projectRoot = (root, timeZone) => {
    const rows = Array.from(root.querySelectorAll('[data-calendar-meeting-row]'));
    const uiLang = root.dataset.lang === 'ja' ? 'ja' : 'en';
    const isJa = uiLang === 'ja';
    const scope = root.dataset.projectionScope || 'all';
    const scopeWindow = scopeWindowFor(scope, timeZone);
    let scopeVisibleCount = 0;
    rows.forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const sourceDate = row.dataset.sourceDate || '';
      const sourceTimeZone = row.dataset.sourceTimezone || '';
      const firstTime = row.dataset.firstRaceTime || '';
      const lastTime = row.dataset.lastRaceTime || '';
      const firstInstant = firstTime ? localDateTimeToInstant(sourceDate, firstTime, sourceTimeZone) : null;
      let lastInstant = lastTime ? localDateTimeToInstant(sourceDate, lastTime, sourceTimeZone) : null;
      if (firstInstant && lastInstant && lastInstant.getTime() < firstInstant.getTime()) lastInstant = new Date(lastInstant.getTime() + 86_400_000);
      row.dataset.date = firstInstant ? formatProjectedDate(firstInstant, timeZone) : sourceDate;
      if (firstInstant) row.dataset.sortStart = String(firstInstant.getTime()); else delete row.dataset.sortStart;
      const firstElement = row.querySelector('[data-race-time="first"]');
      if (firstElement && firstInstant) { firstElement.textContent = formatProjectedTime(firstInstant, timeZone); firstElement.setAttribute('datetime', firstInstant.toISOString()); }
      const lastElement = row.querySelector('[data-race-time="last"]');
      if (lastElement && lastInstant) { lastElement.textContent = formatProjectedTime(lastInstant, timeZone); lastElement.setAttribute('datetime', lastInstant.toISOString()); }
      const visibleByScope = !scopeWindow.start || !scopeWindow.endExclusive || (row.dataset.date >= scopeWindow.start && row.dataset.date < scopeWindow.endExclusive);
      row.dataset.timezoneScopeHidden = visibleByScope ? 'false' : 'true';
      row.hidden = !visibleByScope;
      if (visibleByScope) scopeVisibleCount += 1;
      setMeetingState(row);
    });
    const groupsContainer = root.querySelector('[data-timetable-date-groups]');
    if (groupsContainer) {
      groupsContainer.querySelectorAll('.timetable-date-group').forEach((section) => section.remove());
      const grouped = new Map();
      rows.forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        const date = row.dataset.date || row.dataset.sourceDate || '';
        if (!grouped.has(date)) grouped.set(date, []);
        grouped.get(date).push(row);
      });
      Array.from(grouped.keys()).sort().forEach((date) => {
        const dayRows = grouped.get(date).sort(rowSort);
        const visibleRows = dayRows.filter((row) => row.dataset.timezoneScopeHidden !== 'true');
        const section = document.createElement('section');
        section.className = 'timetable-date-group';
        section.dataset.calendarDateGroup = date;
        section.hidden = visibleRows.length === 0;
        section.setAttribute('aria-labelledby', `date-${date}`);
        const heading = document.createElement('h2');
        heading.id = `date-${date}`;
        heading.tabIndex = -1;
        heading.append(document.createTextNode(date));
        const small = document.createElement('small');
        small.textContent = ` · ${visibleRows.length} ${uiLang === 'ja' ? '開催' : 'meetings'}`;
        heading.append(small);
        const list = document.createElement('ul');
        list.className = 'meeting-list';
        list.setAttribute('aria-label', uiLang === 'ja' ? `${date} 開催` : `${date} meetings`);
        list.append(createColumnHeader(uiLang));
        dayRows.forEach((row) => list.append(row));
        section.append(heading, list);
        groupsContainer.append(section);
      });
    }
    const empty = root.querySelector('[data-timezone-scope-empty]');
    if (empty instanceof HTMLElement) empty.hidden = scopeVisibleCount !== 0;
    const status = root.querySelector('[data-display-timezone-status]');
    if (status) status.textContent = displayTimeZone(timeZone, isJa);
    propagateTimeZoneToLinks(root, timeZone);
    window.dispatchEvent(new CustomEvent('whr:meetingstatechange'));
    window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: {
      timeZone,
      scope,
      targetDate: scopeWindow.targetDate,
      windowStart: scopeWindow.windowStart,
      windowEndInclusive: scopeWindow.windowEndInclusive,
    } }));
  };
  document.querySelectorAll('[data-display-timezone-root]').forEach((root) => {
    const select = root.querySelector('[data-display-timezone-select]');
    if (!(select instanceof HTMLSelectElement)) return;
    const isJa = root.dataset.lang === 'ja';
    populateTimeZones(select, isJa);
    const requested = new URL(window.location.href).searchParams.get('tz');
    const browser = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const initial = isCuratedTimeZone(requested) ? requested : isCuratedTimeZone(browser) ? browser : 'Asia/Tokyo';
    select.value = initial;
    const initialUrl = new URL(window.location.href);
    if (initialUrl.searchParams.get('tz') !== initial) {
      initialUrl.searchParams.set('tz', initial);
      window.history.replaceState({}, '', `${initialUrl.pathname}${initialUrl.search}${initialUrl.hash}`);
    }
    installMeetingRowUi(root);
    projectRoot(root, initial);
    select.addEventListener('change', () => {
      const selected = isCuratedTimeZone(select.value) ? select.value : 'Asia/Tokyo';
      const url = new URL(window.location.href);
      url.searchParams.set('tz', selected);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      projectRoot(root, selected);
    });
    window.addEventListener('whr:timezonechange', (event) => {
      const selected = event?.detail?.timeZone;
      if (!isCuratedTimeZone(selected) || select.value === selected) return;
      select.value = selected;
      projectRoot(root, selected);
    });
    window.setInterval(() => {
      const selected = isCuratedTimeZone(select.value) ? select.value : 'Asia/Tokyo';
      projectRoot(root, selected);
    }, 60_000);
  });
</script>

