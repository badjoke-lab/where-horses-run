---
type CalendarContext = {
  today: string;
  tomorrow: string;
  timeZone: string;
  referenceSource: string;
  windowDays: number;
  windowStart: string;
  windowEndInclusive: string;
  windowEndExclusive: string;
};

type CalendarDataState = {
  status: string;
  generatedDate: string;
  earliestRecordDate: string | null;
  latestRecordDate: string | null;
  totalRecordCount: number;
  windowRecordCount: number;
};

type Props = {
  context: CalendarContext;
  dataState: CalendarDataState;
  lang?: 'en' | 'ja';
};

const { dataState, lang = 'en' } = Astro.props as Props;
const isStaleGeneration = dataState.status === 'stale_generation_with_window_records';
const staleLabel = lang === 'ja' ? 'データ鮮度警告' : 'Stale data warning';
const statusText = lang === 'ja'
  ? dataState.status === 'records_before_window'
    ? '現在の公開データは表示対象より前のものです。最新情報は公式ソースで確認してください。'
    : dataState.status === 'records_after_window'
      ? '公開データには現在の表示対象より後の開催のみがあります。'
      : dataState.status === 'no_public_records'
        ? '現在、確認済みの公開開催データはありません。最新情報は公式ソースで確認してください。'
        : dataState.status === 'stale_generation_with_window_records'
          ? '表示対象の開催がありますが、公開データの生成が古い可能性があります。最終確認は各開催の公式ソースで行ってください。'
          : '確認済みの公開開催があります。表示タイムゾーンを変更すると、開催日の所属と表示日時もそのタイムゾーンへ切り替わります。'
  : dataState.status === 'records_before_window'
    ? 'The current public data is older than the active display range. Check official sources for current information.'
    : dataState.status === 'records_after_window'
      ? 'The public data contains meetings only after the active display range.'
      : dataState.status === 'no_public_records'
        ? 'No reviewed public meeting data is currently available. Check official sources for current information.'
        : dataState.status === 'stale_generation_with_window_records'
          ? 'Meetings are available, but the public projection may be stale. Use each meeting’s official source for final confirmation.'
          : 'Reviewed public meetings are available. Changing the display timezone also changes date membership and displayed date/time values.';
---

<aside class="calendar-date-status" data-calendar-data-status={dataState.status}>
  <p>{isStaleGeneration && <strong>{staleLabel}: </strong>}{statusText}</p>
</aside>

<style>
  .calendar-date-status {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.75rem;
    display: grid;
    gap: 0.45rem;
    margin-block: 1.25rem;
    padding: 0.85rem;
  }

  .calendar-date-status p { margin: 0; }
</style>
