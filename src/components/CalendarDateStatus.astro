---
type CalendarContext = {
  today: string;
  tomorrow: string;
  timeZone: string;
  referenceSource: string;
  windowDays: number;
  windowStart: string;
  windowEndInclusive: string;
  windowEndExclusive: string;
};

type CalendarDataState = {
  status: string;
  generatedDate: string;
  earliestRecordDate: string | null;
  latestRecordDate: string | null;
  totalRecordCount: number;
  windowRecordCount: number;
};

type Props = {
  context: CalendarContext;
  dataState: CalendarDataState;
  lang?: 'en' | 'ja';
  displayDate?: string;
};

const { context, dataState, lang = 'en', displayDate } = Astro.props as Props;
const isStaleGeneration = dataState.status === 'stale_generation_with_window_records';
const statusText = lang === 'ja'
  ? dataState.status === 'records_before_window'
    ? `掲載中の開催情報は現在の表示期間より前のものです。最新の掲載日は ${dataState.latestRecordDate ?? '未掲載'} です。最新情報は公式情報源で確認してください。`
    : dataState.status === 'records_after_window'
      ? `掲載中の開催情報は現在の表示期間より後のものです。最初の掲載日は ${dataState.earliestRecordDate ?? '未掲載'} です。`
      : dataState.status === 'no_public_records'
        ? '現在、この期間の開催情報は掲載されていません。最新情報は公式情報源で確認してください。'
        : dataState.status === 'stale_generation_with_window_records'
          ? `掲載情報の更新日は ${dataState.generatedDate} です。最新情報は各開催の公式情報源で確認してください。`
          : `掲載情報の更新日: ${dataState.generatedDate}`
  : dataState.status === 'records_before_window'
    ? `The listed meetings are older than the current display window. The latest listed date is ${dataState.latestRecordDate ?? 'not listed'}. Check official sources for current information.`
    : dataState.status === 'records_after_window'
      ? `The listed meetings are later than the current display window. The earliest listed date is ${dataState.earliestRecordDate ?? 'not listed'}.`
      : dataState.status === 'no_public_records'
        ? 'No meetings are currently listed for this period. Check official sources for current information.'
        : dataState.status === 'stale_generation_with_window_records'
          ? `This information was last updated on ${dataState.generatedDate}. Check each meeting's official source for the latest information.`
          : `Last updated: ${dataState.generatedDate}`;
---

<aside class="calendar-date-status" data-calendar-data-status={dataState.status}>
  <p>
    {displayDate ? (
      <>{lang === 'ja' ? '対象日' : 'Date'}: <strong>{displayDate}</strong></>
    ) : (
      <>{lang === 'ja' ? '表示期間' : 'Display period'}: <strong>{context.windowStart}</strong>–<strong>{context.windowEndInclusive}</strong></>
    )}
    {' '}· {lang === 'ja' ? '時刻基準' : 'Timezone'}: <strong>{context.timeZone}</strong>
  </p>
  <p>{isStaleGeneration && <strong>{lang === 'ja' ? '更新情報: ' : 'Update notice: '}</strong>}{statusText}</p>
</aside>

<style>
  .calendar-date-status {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.75rem;
    display: grid;
    gap: 0.45rem;
    margin-block: 1.25rem;
    padding: 0.85rem;
  }

  .calendar-date-status p {
    margin: 0;
  }
</style>
