---
import '../styles/racecourse-map.css';
import '../styles/racecourse-map-qa.css';

interface Props {
  racecourseIds?: string[];
  visibleRacecourseIds?: string[];
  ariaLabel?: string;
  initialZoom?: number;
  clusterPoints?: boolean;
  geojsonUrl?: string;
  styleUrl?: string;
  fallbackMessage?: string;
}

const {
  racecourseIds = [],
  visibleRacecourseIds = racecourseIds,
  ariaLabel = 'Interactive racecourse map',
  initialZoom = 2,
  clusterPoints = true,
  geojsonUrl = '/data/racecourse-locations-v1.geojson',
  styleUrl = 'https://tiles.openfreemap.org/styles/liberty',
  fallbackMessage = 'Interactive map unavailable. Verified location details and page navigation remain available.'
} = Astro.props;
---

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.7.0/dist/maplibre-gl.css" />

<div
  class="racecourse-map"
  data-racecourse-map
  data-racecourse-ids={JSON.stringify(racecourseIds)}
  data-visible-racecourse-ids={JSON.stringify(visibleRacecourseIds)}
  data-initial-zoom={String(initialZoom)}
  data-cluster-points={clusterPoints ? 'true' : 'false'}
  data-geojson-url={geojsonUrl}
  data-style-url={styleUrl}
  data-fallback-message={fallbackMessage}
  data-map-state="idle"
>
  <div class="racecourse-map__canvas" data-map-canvas role="region" aria-label={ariaLabel}></div>
  <p class="racecourse-map__status" data-map-status aria-live="polite">Loading interactive map…</p>
  <div class="racecourse-map__legend" data-map-legend hidden>
    <span class="racecourse-map__legend-title racecourse-map__legend-title--en">Meeting status</span>
    <span class="racecourse-map__legend-title racecourse-map__legend-title--ja">開催状態</span>
    <span class="racecourse-map__legend-item" data-map-legend-state="running">
      <span class="racecourse-map__legend-dot racecourse-map__legend-dot--running" aria-hidden="true"></span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--en">Racing now</span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--ja">開催中</span>
    </span>
    <span class="racecourse-map__legend-item" data-map-legend-state="upcoming">
      <span class="racecourse-map__legend-dot racecourse-map__legend-dot--upcoming" aria-hidden="true"></span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--en">Upcoming</span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--ja">開催前</span>
    </span>
    <span class="racecourse-map__legend-item" data-map-legend-state="today">
      <span class="racecourse-map__legend-dot racecourse-map__legend-dot--today" aria-hidden="true"></span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--en">Today meeting</span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--ja">本日開催</span>
    </span>
    <span class="racecourse-map__legend-item" data-map-legend-state="future">
      <span class="racecourse-map__legend-dot racecourse-map__legend-dot--future" aria-hidden="true"></span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--en">Scheduled</span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--ja">開催予定</span>
    </span>
    <span class="racecourse-map__legend-item" data-map-legend-state="ended">
      <span class="racecourse-map__legend-dot racecourse-map__legend-dot--ended" aria-hidden="true"></span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--en">Finished</span>
      <span class="racecourse-map__legend-label racecourse-map__legend-label--ja">終了</span>
    </span>
  </div>
  <noscript>
    <p class="racecourse-map__fallback">{fallbackMessage}</p>
  </noscript>
</div>

<style is:global>
  .racecourse-map__legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin: 0;
    font-size: 0.78rem;
    color: var(--whr-color-muted);
  }

  .racecourse-map__legend[hidden],
  .racecourse-map__legend-item[hidden] {
    display: none;
  }

  .racecourse-map__legend-title {
    font-weight: 800;
    color: var(--whr-color-text);
  }

  .racecourse-map__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .racecourse-map__legend-dot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px #111;
    flex: 0 0 auto;
  }

  .racecourse-map__legend-dot--running {
    background: #c40000;
  }

  .racecourse-map__legend-dot--upcoming {
    background: #d18a00;
  }

  .racecourse-map__legend-dot--today {
    background: #fffcf4;
    border-color: #7a5a00;
    box-shadow: none;
  }

  .racecourse-map__legend-dot--future {
    background: #111;
  }

  .racecourse-map__legend-dot--ended {
    background: #666;
  }

  html:lang(ja) .racecourse-map__legend-title--en,
  html:lang(ja) .racecourse-map__legend-label--en {
    display: none;
  }

  html:not(:lang(ja)) .racecourse-map__legend-title--ja,
  html:not(:lang(ja)) .racecourse-map__legend-label--ja {
    display: none;
  }

  @media (max-width: 700px) {
    .racecourse-map__canvas {
      min-height: clamp(320px, 48vh, 420px);
    }

    .racecourse-map__legend {
      align-items: flex-start;
      gap: 0.4rem 0.65rem;
    }

    .racecourse-map__legend-title {
      flex-basis: 100%;
    }
  }
</style>

<script is:inline type="module">
  const MAPLIBRE_MODULE_URL = 'https://unpkg.com/maplibre-gl@6.7.0/dist/maplibre-gl.mjs';
  const MAP_SOURCE = 'racecourses';
  const MAP_CLUSTER_LAYER = 'racecourse-clusters';
  const MAP_CLUSTER_SHADOW_LAYER = 'racecourse-cluster-shadow';
  const MAP_CLUSTER_LIVE_GLOW_LAYER = 'racecourse-cluster-live-glow';
  const MAP_CLUSTER_STATUS_AURA_LAYER = 'racecourse-cluster-status-aura';
  const MAP_CLUSTER_STATUS_RING_LAYER = 'racecourse-cluster-status-ring';
  const MAP_CLUSTER_COUNT_LAYER = 'racecourse-cluster-count';
  const MAP_CLUSTER_RUNNING_BADGE_LAYER = 'racecourse-cluster-running-badge';
  const MAP_CLUSTER_UPCOMING_BADGE_LAYER = 'racecourse-cluster-upcoming-badge';
  const MAP_CLUSTER_LIVE_BADGE_IMAGE = 'racecourse-cluster-live-pill';
  const MAP_CLUSTER_UPCOMING_BADGE_IMAGE = 'racecourse-cluster-upcoming-pill';
  const MAP_SELECTED_RING_LAYER = 'racecourse-selected-ring';
  const MAP_POINT_LAYER = 'racecourse-points';
  const MAP_HIT_LAYER = 'racecourse-hit-targets';
  const MAP_LOAD_TIMEOUT_MS = 15000;
  const MOBILE_BREAKPOINT = '(max-width: 700px)';
  const FINE_POINTER = '(hover: hover) and (pointer: fine)';
  const STATUS_REFRESH_MS = 60_000;
  const PUBLIC_STATUS_KEYS = new Set(['running', 'upcoming', 'today', 'future', 'ended']);

  const STATUS_PRIORITY = {
    neutral: 0,
    ended: 1,
    future: 2,
    today: 3,
    upcoming: 4,
    running: 5
  };

  const parseRacecourseIds = (value) => {
    try {
      const parsed = JSON.parse(value || '[]');
      return Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'string' && id.length > 0) : [];
    } catch {
      return [];
    }
  };

  const parseJsonNode = (node) => {
    if (!(node instanceof HTMLScriptElement)) return [];
    try {
      const parsed = JSON.parse(node.textContent || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const boundsForFeatures = (features) => {
    const points = features
      .map((feature) => feature?.geometry?.coordinates)
      .filter((coordinates) => Array.isArray(coordinates) && coordinates.length >= 2);
    if (points.length === 0) return null;

    let minLng = points[0][0];
    let maxLng = points[0][0];
    let minLat = points[0][1];
    let maxLat = points[0][1];
    for (const [lng, lat] of points.slice(1)) {
      minLng = Math.min(minLng, lng);
      maxLng = Math.max(maxLng, lng);
      minLat = Math.min(minLat, lat);
      maxLat = Math.max(maxLat, lat);
    }
    return [[minLng, minLat], [maxLng, maxLat]];
  };

  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try {
      new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0));
      return true;
    } catch {
      return false;
    }
  };

  const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
    timeZone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23'
  }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));

  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(
      Number(dateMatch[1]),
      Number(dateMatch[2]) - 1,
      Number(dateMatch[3]),
      Number(timeMatch[1]),
      Number(timeMatch[2]),
      Number(timeMatch[3] ?? '0')
    );
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(
        Number(parts.year),
        Number(parts.month) - 1,
        Number(parts.day),
        Number(parts.hour),
        Number(parts.minute),
        Number(parts.second)
      );
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };

  const formatDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };

  const addDays = (dateText, days) => {
    const date = new Date(`${dateText}T00:00:00.000Z`);
    date.setUTCDate(date.getUTCDate() + days);
    return date.toISOString().slice(0, 10);
  };


  const registerClusterPillImage = (map, name, fill, border) => {
    if (typeof map.hasImage === 'function' && map.hasImage(name)) return;
    const width = 56;
    const height = 32;
    const radius = height / 2;
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext('2d');
    if (!context) return;

    context.beginPath();
    context.moveTo(radius, 1);
    context.lineTo(width - radius, 1);
    context.arcTo(width - 1, 1, width - 1, radius, radius - 1);
    context.arcTo(width - 1, height - 1, width - radius, height - 1, radius - 1);
    context.lineTo(radius, height - 1);
    context.arcTo(1, height - 1, 1, radius, radius - 1);
    context.arcTo(1, 1, radius, 1, radius - 1);
    context.closePath();
    context.fillStyle = fill;
    context.fill();
    context.strokeStyle = border;
    context.lineWidth = 2;
    context.stroke();

    map.addImage(name, context.getImageData(0, 0, width, height), {
      pixelRatio: 2,
      stretchX: [[16, 40]],
      content: [12, 5, 44, 27]
    });
  };

  const strongerStatus = (current, next) => {
    if (!current) return next;
    return (STATUS_PRIORITY[next] ?? 0) > (STATUS_PRIORITY[current] ?? 0) ? next : current;
  };

  const statusFromMeetingRow = (row) => {
    const presentationState = row.dataset.meetingPresentationState || 'unknown';
    return PUBLIC_STATUS_KEYS.has(presentationState) ? presentationState : 'neutral';
  };

  const homeWindow = (context, timeZone) => {
    const selected = context.querySelector('[data-home-map-period][aria-pressed="true"]');
    const period = selected instanceof HTMLElement ? selected.dataset.homeMapPeriod || 'today' : 'today';
    const today = formatDate(new Date(), timeZone);
    if (period === 'tomorrow') {
      const start = addDays(today, 1);
      return { start, endExclusive: addDays(start, 1) };
    }
    if (period === 'next7') return { start: today, endExclusive: addDays(today, 7) };
    return { start: today, endExclusive: addDays(today, 1) };
  };

  const homeRecordProjection = (record, displayTimeZone) => {
    const first = record.firstRaceTime
      ? localDateTimeToInstant(record.sourceDate, record.firstRaceTime, record.sourceTimezone)
      : null;
    let last = record.lastRaceTime
      ? localDateTimeToInstant(record.sourceDate, record.lastRaceTime, record.sourceTimezone)
      : null;
    if (first && last && last.getTime() < first.getTime()) {
      last = new Date(last.getTime() + 86_400_000);
    }
    const anchor = first || last;
    return {
      first,
      last,
      projectedDate: anchor ? formatDate(anchor, displayTimeZone) : record.sourceDate
    };
  };

  const statusFromHomeRecord = (record, projected, displayTimeZone, now) => {
    const today = formatDate(now, displayTimeZone);
    const { first, last, projectedDate } = projected;

    if (first && last) {
      if (now.getTime() >= first.getTime() && now.getTime() <= last.getTime()) return 'running';
      if (now.getTime() < first.getTime()) return projectedDate === today ? 'upcoming' : 'future';
      return 'ended';
    }

    if (projectedDate < today) return 'ended';
    if (projectedDate === today) return 'upcoming';
    return 'future';
  };

  const initRacecourseMap = async (root) => {
    if (root.dataset.mapInitialized === 'true') return;
    root.dataset.mapInitialized = 'true';
    root.dataset.mapState = 'loading';

    const canvas = root.querySelector('[data-map-canvas]');
    const status = root.querySelector('[data-map-status]');
    const legend = root.querySelector('[data-map-legend]');
    const fallbackMessage = root.dataset.fallbackMessage || 'Interactive map unavailable.';
    const requestedIds = parseRacecourseIds(root.dataset.racecourseIds);
    const initialVisibleIds = parseRacecourseIds(root.dataset.visibleRacecourseIds);
    const initialZoom = Number(root.dataset.initialZoom || '2');
    const clusterPoints = root.dataset.clusterPoints !== 'false';
    const geojsonUrl = root.dataset.geojsonUrl || '/data/racecourse-locations-v1.geojson';
    const styleUrl = root.dataset.styleUrl || 'https://tiles.openfreemap.org/styles/liberty';
    const statusContext = root.closest('[data-home-racing-map], [data-today-map-sync], [data-calendar-map-switch]');
    const useStatusPresentation = statusContext instanceof HTMLElement;
    if (legend instanceof HTMLElement) {
      legend.hidden = true;
      legend.setAttribute('aria-label', document.documentElement.lang === 'ja' ? '開催状態の凡例' : 'Meeting status legend');
    }

    let map = null;
    let ready = false;
    let failed = false;
    let loadTimeout = null;
    let statusRefresh = null;
    let clusterPulseTimer = null;
    let hoverPopup = null;

    const fail = () => {
      if (ready || failed) return;
      failed = true;
      if (loadTimeout !== null) window.clearTimeout(loadTimeout);
      if (statusRefresh !== null) window.clearInterval(statusRefresh);
      if (clusterPulseTimer !== null) window.clearInterval(clusterPulseTimer);
      root.dataset.mapState = 'failed';
      if (canvas) canvas.hidden = true;
      if (legend instanceof HTMLElement) legend.hidden = true;
      if (status) {
        status.hidden = false;
        status.textContent = fallbackMessage;
      }
      try {
        hoverPopup?.remove();
        map?.remove();
      } catch {
        // Keep the non-map page usable even if cleanup also fails.
      }
      hoverPopup = null;
      map = null;
    };

    try {
      const [maplibregl, response] = await Promise.all([
        import(MAPLIBRE_MODULE_URL),
        fetch(geojsonUrl, { credentials: 'same-origin' })
      ]);

      if (!response.ok) throw new Error(`GeoJSON request failed: ${response.status}`);
      if (typeof maplibregl.supported === 'function' && !maplibregl.supported()) {
        throw new Error('MapLibre is not supported in this browser');
      }

      const projection = await response.json();
      const allFeatures = Array.isArray(projection?.features) ? projection.features : [];
      const requestedSet = new Set(requestedIds);
      const features = requestedSet.size > 0
        ? allFeatures.filter((feature) => requestedSet.has(feature?.properties?.racecourse_id))
        : allFeatures;

      if (requestedSet.size > 0 && features.length !== requestedSet.size) {
        throw new Error('One or more requested racecourse locations are not present in the reviewed projection');
      }
      if (features.length === 0) throw new Error('No reviewed racecourse locations available for this map');

      const featureByRacecourseId = new Map(
        features.map((feature) => [feature?.properties?.racecourse_id, feature])
      );
      const allowedVisibleIds = initialVisibleIds.filter((id) => featureByRacecourseId.has(id));
      const startingFeatures = allowedVisibleIds
        .map((id) => featureByRacecourseId.get(id))
        .filter(Boolean);
      const singleCoordinates = startingFeatures.length === 1 ? startingFeatures[0]?.geometry?.coordinates : null;
      const startCenter = Array.isArray(singleCoordinates) ? singleCoordinates : [0, 20];
      const startZoom = Number.isFinite(initialZoom) ? initialZoom : 2;
      const mobileViewport = window.matchMedia(MOBILE_BREAKPOINT).matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      map = new maplibregl.Map({
        container: canvas,
        style: styleUrl,
        center: startCenter,
        zoom: startingFeatures.length === 1 ? (features.length === 1 ? startZoom : Math.max(startZoom, 8)) : 1.5,
        attributionControl: true,
        keyboard: true,
        cooperativeGestures: mobileViewport
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false, showZoom: true }), 'top-right');
      loadTimeout = window.setTimeout(fail, MAP_LOAD_TIMEOUT_MS);

      let selectedFeatureId = null;
      let visibleRacecourseIds = new Set(allowedVisibleIds);

      const clearSelected = (emit = true) => {
        const racecourseId = root.dataset.selectedRacecourseId || null;
        if (selectedFeatureId !== null) {
          try {
            map.setFeatureState({ source: MAP_SOURCE, id: selectedFeatureId }, { selected: false });
          } catch {
            // The feature may have been re-clustered or removed from the visible source.
          }
        }
        selectedFeatureId = null;
        delete root.dataset.selectedRacecourseId;
        if (emit && racecourseId) {
          root.dispatchEvent(new CustomEvent('racecourse-map:deselect', {
            bubbles: true,
            detail: { racecourseId }
          }));
        }
      };

      const setSelected = (racecourseId, emit = true, toggle = false) => {
        const feature = featureByRacecourseId.get(racecourseId);
        if (!feature || !visibleRacecourseIds.has(racecourseId)) return;
        if (toggle && root.dataset.selectedRacecourseId === racecourseId) {
          clearSelected(emit);
          return;
        }
        if (selectedFeatureId !== null) {
          map.setFeatureState({ source: MAP_SOURCE, id: selectedFeatureId }, { selected: false });
        }
        selectedFeatureId = feature.id;
        map.setFeatureState({ source: MAP_SOURCE, id: selectedFeatureId }, { selected: true });
        root.dataset.selectedRacecourseId = racecourseId;
        if (emit) {
          root.dispatchEvent(new CustomEvent('racecourse-map:select', {
            bubbles: true,
            detail: { racecourseId }
          }));
        }
      };

      const focusRacecourse = (racecourseId) => {
        const feature = featureByRacecourseId.get(racecourseId);
        const coordinates = feature?.geometry?.coordinates;
        if (!Array.isArray(coordinates) || !visibleRacecourseIds.has(racecourseId)) return;
        setSelected(racecourseId, false);
        map.jumpTo({ center: coordinates, zoom: Math.max(map.getZoom(), features.length === 1 ? startZoom : 8) });
      };

      const fitVisible = (visibleFeatures) => {
        if (visibleFeatures.length === 1) {
          const coordinates = visibleFeatures[0]?.geometry?.coordinates;
          if (Array.isArray(coordinates)) {
            map.jumpTo({
              center: coordinates,
              zoom: features.length === 1 ? startZoom : Math.max(startZoom, 8)
            });
          }
          return;
        }
        if (visibleFeatures.length > 1) {
          const bounds = boundsForFeatures(visibleFeatures);
          if (bounds) map.fitBounds(bounds, {
            padding: mobileViewport ? 28 : 48,
            maxZoom: 8,
            duration: 0
          });
        }
      };

      const racecourseLabelFor = (racecourseId) => {
        if (statusContext instanceof HTMLElement) {
          const homeRows = parseJsonNode(statusContext.querySelector('[data-home-map-records]'));
          const homeMatch = homeRows.find((entry) => entry?.racecourseId === racecourseId);
          if (typeof homeMatch?.racecourseName === 'string' && homeMatch.racecourseName) return homeMatch.racecourseName;

          const mappingNode = statusContext.querySelector('[data-today-map-meeting-map], [data-calendar-map-meeting-map]');
          const mapping = parseJsonNode(mappingNode);
          const meetingIds = new Set(mapping.filter((entry) => entry?.racecourseId === racecourseId).map((entry) => entry?.meetingId));
          for (const row of document.querySelectorAll('[data-calendar-meeting-row]')) {
            if (!(row instanceof HTMLElement)) continue;
            if (!meetingIds.has(row.dataset.meetingId)) continue;
            if (row.dataset.racecourse) return row.dataset.racecourse;
          }
        }
        return racecourseId.replace(/-racecourse$/, '').replaceAll('-', ' ');
      };

      const inferStatuses = () => {
        const result = {};
        if (!useStatusPresentation || !(statusContext instanceof HTMLElement)) return result;

        if (statusContext.matches('[data-home-racing-map]')) {
          const records = parseJsonNode(statusContext.querySelector('[data-home-map-records]'));
          const zoneSelect = statusContext.querySelector('[data-home-map-timezone]');
          const displayTimeZone = zoneSelect instanceof HTMLSelectElement && isTimeZoneSupported(zoneSelect.value)
            ? zoneSelect.value
            : 'Asia/Tokyo';
          const windowRange = homeWindow(statusContext, displayTimeZone);
          const now = new Date();

          records.forEach((record) => {
            if (!visibleRacecourseIds.has(record?.racecourseId)) return;
            const projected = homeRecordProjection(record, displayTimeZone);
            if (projected.projectedDate < windowRange.start || projected.projectedDate >= windowRange.endExclusive) return;
            const next = statusFromHomeRecord(record, projected, displayTimeZone, now);
            result[record.racecourseId] = strongerStatus(result[record.racecourseId], next);
          });
          return result;
        }

        const mappingNode = statusContext.querySelector('[data-today-map-meeting-map], [data-calendar-map-meeting-map]');
        const mapping = parseJsonNode(mappingNode);
        const racecourseByMeetingId = new Map(mapping.map((entry) => [entry?.meetingId, entry?.racecourseId]));
        document.querySelectorAll('[data-calendar-meeting-row]').forEach((row) => {
          if (!(row instanceof HTMLElement) || row.hidden || row.dataset.timezoneScopeHidden === 'true') return;
          const racecourseId = racecourseByMeetingId.get(row.dataset.meetingId || '');
          if (typeof racecourseId !== 'string' || !visibleRacecourseIds.has(racecourseId)) return;
          const next = statusFromMeetingRow(row);
          result[racecourseId] = strongerStatus(result[racecourseId], next);
        });
        return result;
      };

      const syncLegend = (inferred) => {
        if (!(legend instanceof HTMLElement) || !useStatusPresentation) return;
        const active = new Set(Object.values(inferred).filter((state) => PUBLIC_STATUS_KEYS.has(state)));
        legend.querySelectorAll('[data-map-legend-state]').forEach((item) => {
          if (!(item instanceof HTMLElement)) return;
          item.hidden = !active.has(item.dataset.mapLegendState || '');
        });
        legend.hidden = active.size === 0;
      };

      const presentedFeatures = (inferred) => [...visibleRacecourseIds]
        .map((id) => featureByRacecourseId.get(id))
        .filter(Boolean)
        .map((feature) => ({
          ...feature,
          properties: {
            ...feature.properties,
            meeting_status: useStatusPresentation
              ? inferred[feature?.properties?.racecourse_id] || 'neutral'
              : 'neutral'
          }
        }));

      const refreshSourceData = () => {
        const source = map.getSource(MAP_SOURCE);
        if (!source || typeof source.setData !== 'function') return;
        const inferred = inferStatuses();
        syncLegend(inferred);
        source.setData({
          ...projection,
          features: presentedFeatures(inferred)
        });
        if (selectedFeatureId !== null) {
          try {
            map.setFeatureState({ source: MAP_SOURCE, id: selectedFeatureId }, { selected: true });
          } catch {
            // Selection will be restored by the next explicit focus/select interaction if the feature was re-clustered.
          }
        }
      };

      const applyStatuses = () => {
        if (!ready || !map.getSource(MAP_SOURCE)) return;
        refreshSourceData();
      };

      const applyVisibleIds = (ids, fit = true) => {
        const nextIds = Array.from(new Set(ids)).filter((id) => featureByRacecourseId.has(id));

        const selectedRacecourseId = root.dataset.selectedRacecourseId;
        if (selectedRacecourseId && !nextIds.includes(selectedRacecourseId)) {
          if (selectedFeatureId !== null) {
            try {
              map.setFeatureState({ source: MAP_SOURCE, id: selectedFeatureId }, { selected: false });
            } catch {
              // The selected feature may already have left the source after a visibility update.
            }
          }
          selectedFeatureId = null;
          delete root.dataset.selectedRacecourseId;
        }

        visibleRacecourseIds = new Set(nextIds);
        refreshSourceData();

        const visibleFeatures = nextIds.map((id) => featureByRacecourseId.get(id)).filter(Boolean);
        if (fit) fitVisible(visibleFeatures);
        root.dataset.visibleRacecourseCount = String(visibleFeatures.length);
        root.dispatchEvent(new CustomEvent('racecourse-map:visiblechange', {
          bubbles: true,
          detail: { racecourseIds: nextIds }
        }));
      };

      map.once('load', () => {
        if (failed) return;
        if (loadTimeout !== null) {
          window.clearTimeout(loadTimeout);
          loadTimeout = null;
        }
        if (canvas) canvas.hidden = false;

        map.addSource(MAP_SOURCE, {
          type: 'geojson',
          data: {
            ...projection,
            features: startingFeatures.map((feature) => ({
              ...feature,
              properties: {
                ...feature.properties,
                meeting_status: 'neutral'
              }
            }))
          },
          cluster: clusterPoints && features.length > 1,
          clusterMaxZoom: 9,
          clusterRadius: 44,
          clusterProperties: {
            running_count: ['+', ['case', ['==', ['get', 'meeting_status'], 'running'], 1, 0]],
            upcoming_count: ['+', ['case', ['==', ['get', 'meeting_status'], 'upcoming'], 1, 0]],
            today_count: ['+', ['case', ['==', ['get', 'meeting_status'], 'today'], 1, 0]],
            future_count: ['+', ['case', ['==', ['get', 'meeting_status'], 'future'], 1, 0]],
            ended_count: ['+', ['case', ['==', ['get', 'meeting_status'], 'ended'], 1, 0]]
          }
        });

        const clusterAllToday = ['==', ['get', 'today_count'], ['get', 'point_count']];
        const clusterAllFuture = ['==', ['get', 'future_count'], ['get', 'point_count']];
        const clusterAllEnded = ['==', ['get', 'ended_count'], ['get', 'point_count']];
        const clusterAllNeutral = [
          '==',
          ['+', ['get', 'running_count'], ['get', 'upcoming_count'], ['get', 'today_count'], ['get', 'future_count'], ['get', 'ended_count']],
          0
        ];
        const clusterHasRunning = ['>', ['get', 'running_count'], 0];
        const clusterHasUpcoming = ['>', ['get', 'upcoming_count'], 0];
        const clusterHasPriorityState = ['any', clusterHasRunning, clusterHasUpcoming];

        registerClusterPillImage(map, MAP_CLUSTER_LIVE_BADGE_IMAGE, '#e53935', 'rgba(255, 255, 255, 0.68)');
        registerClusterPillImage(map, MAP_CLUSTER_UPCOMING_BADGE_IMAGE, '#fb8c00', 'rgba(255, 255, 255, 0.68)');

        map.addLayer({
          id: MAP_CLUSTER_SHADOW_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['has', 'point_count'],
          paint: {
            'circle-radius': 22,
            'circle-color': '#000000',
            'circle-opacity': 0.26,
            'circle-blur': 0.82,
            'circle-translate': [0, 4],
            'circle-translate-anchor': 'viewport'
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_LIVE_GLOW_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['all', ['has', 'point_count'], clusterHasRunning],
          paint: {
            'circle-radius': 31,
            'circle-color': '#e53935',
            'circle-opacity': 0.18,
            'circle-blur': 0.72
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_STATUS_AURA_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['all', ['has', 'point_count'], clusterHasPriorityState],
          paint: {
            'circle-radius': 28,
            'circle-color': [
              'case',
              clusterHasRunning, 'rgba(229, 57, 53, 0.20)',
              'rgba(251, 140, 0, 0.17)'
            ]
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_STATUS_RING_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['all', ['has', 'point_count'], clusterHasPriorityState],
          paint: {
            'circle-radius': 23,
            'circle-color': [
              'case',
              clusterHasRunning, '#e53935',
              '#fb8c00'
            ]
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['has', 'point_count'],
          paint: {
            'circle-radius': 19,
            'circle-color': [
              'case',
              clusterHasPriorityState, '#59636f',
              clusterAllToday, '#fffcf4',
              clusterAllEnded, '#666666',
              clusterAllFuture, '#111111',
              clusterAllNeutral, '#ffffff',
              '#111111'
            ],
            'circle-stroke-color': [
              'case',
              clusterHasRunning, '#ff8b87',
              clusterHasUpcoming, '#ffd08a',
              clusterAllToday, '#7a5a00',
              clusterAllNeutral, '#777777',
              '#ffffff'
            ],
            'circle-stroke-width': [
              'case',
              clusterAllToday, 3,
              2
            ]
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_COUNT_LAYER,
          type: 'symbol',
          source: MAP_SOURCE,
          filter: ['has', 'point_count'],
          layout: {
            'text-field': ['get', 'point_count_abbreviated'],
            'text-size': 12,
            'text-allow-overlap': true,
            'text-ignore-placement': true
          },
          paint: {
            'text-color': [
              'case',
              clusterHasPriorityState, '#ffffff',
              clusterAllToday, '#3b2b00',
              clusterAllNeutral, '#111111',
              '#ffffff'
            ]
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_RUNNING_BADGE_LAYER,
          type: 'symbol',
          source: MAP_SOURCE,
          filter: ['all', ['has', 'point_count'], clusterHasRunning],
          layout: {
            'icon-image': MAP_CLUSTER_LIVE_BADGE_IMAGE,
            'icon-text-fit': 'width',
            'icon-text-fit-padding': [1, 4, 1, 4],
            'icon-allow-overlap': true,
            'icon-ignore-placement': true,
            'text-field': ['concat', 'LIVE ', ['to-string', ['get', 'running_count']]],
            'text-size': 8,
            'text-allow-overlap': true,
            'text-ignore-placement': true
          },
          paint: {
            'icon-translate': [0, -28],
            'icon-translate-anchor': 'viewport',
            'text-translate': [0, -28],
            'text-translate-anchor': 'viewport',
            'text-color': '#ffffff'
          }
        });

        map.addLayer({
          id: MAP_CLUSTER_UPCOMING_BADGE_LAYER,
          type: 'symbol',
          source: MAP_SOURCE,
          filter: ['all', ['has', 'point_count'], clusterHasUpcoming],
          layout: {
            'icon-image': MAP_CLUSTER_UPCOMING_BADGE_IMAGE,
            'icon-text-fit': 'width',
            'icon-text-fit-padding': [1, 4, 1, 4],
            'icon-allow-overlap': true,
            'icon-ignore-placement': true,
            'text-field': ['concat', 'UP ', ['to-string', ['get', 'upcoming_count']]],
            'text-size': 8,
            'text-allow-overlap': true,
            'text-ignore-placement': true
          },
          paint: {
            'icon-translate': [0, 28],
            'icon-translate-anchor': 'viewport',
            'text-translate': [0, 28],
            'text-translate-anchor': 'viewport',
            'text-color': '#ffffff'
          }
        });

        if (!reducedMotion) {
          const pulseStartedAt = performance.now();
          clusterPulseTimer = window.setInterval(() => {
            if (!map?.getLayer(MAP_CLUSTER_LIVE_GLOW_LAYER)) return;
            const phase = (Math.sin(((performance.now() - pulseStartedAt) / 900) * Math.PI) + 1) / 2;
            map.setPaintProperty(MAP_CLUSTER_LIVE_GLOW_LAYER, 'circle-radius', 30 + (phase * 2));
            map.setPaintProperty(MAP_CLUSTER_LIVE_GLOW_LAYER, 'circle-opacity', 0.14 + (phase * 0.10));
          }, 120);
        }

        const pointBaseRadius = [
          'match',
          ['get', 'meeting_status'],
          'running', 10,
          'upcoming', 10,
          'today', 9,
          'ended', 9,
          'future', 7,
          'neutral', 7,
          7
        ];

        map.addLayer({
          id: MAP_SELECTED_RING_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-radius': [
              'case',
              ['boolean', ['feature-state', 'selected'], false],
              ['+', pointBaseRadius, 8],
              0
            ],
            'circle-color': '#111111',
            'circle-opacity': ['case', ['boolean', ['feature-state', 'selected'], false], 1, 0]
          }
        });

        map.addLayer({
          id: MAP_HIT_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-radius': 22,
            'circle-color': '#111111',
            'circle-opacity': 0.01
          }
        });

        map.addLayer({
          id: MAP_POINT_LAYER,
          type: 'circle',
          source: MAP_SOURCE,
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-radius': [
              '+',
              pointBaseRadius,
              ['case', ['boolean', ['feature-state', 'selected'], false], 3, 0]
            ],
            'circle-color': [
              'match',
              ['get', 'meeting_status'],
              'running', '#c40000',
              'upcoming', '#d18a00',
              'today', '#fffcf4',
              'ended', '#666666',
              'future', '#111111',
              'neutral', '#ffffff',
              '#ffffff'
            ],
            'circle-stroke-color': [
              'match',
              ['get', 'meeting_status'],
              'today', '#7a5a00',
              'neutral', '#777777',
              '#ffffff'
            ],
            'circle-stroke-width': [
              'case',
              ['boolean', ['feature-state', 'selected'], false],
              4,
              ['==', ['get', 'meeting_status'], 'today'],
              3,
              2
            ]
          }
        });

        const setPointerCursor = (enabled) => {
          map.getCanvas().style.cursor = enabled ? 'pointer' : '';
        };

        map.on('mouseenter', MAP_CLUSTER_LAYER, () => setPointerCursor(true));
        map.on('mouseleave', MAP_CLUSTER_LAYER, () => setPointerCursor(false));
        map.on('mouseenter', MAP_HIT_LAYER, (event) => {
          setPointerCursor(true);
          if (!window.matchMedia(FINE_POINTER).matches) return;
          const feature = event.features?.[0];
          const racecourseId = feature?.properties?.racecourse_id;
          const coordinates = feature?.geometry?.coordinates;
          if (typeof racecourseId !== 'string' || !Array.isArray(coordinates)) return;
          hoverPopup?.remove();
          hoverPopup = new maplibregl.Popup({
            closeButton: false,
            closeOnClick: false,
            offset: 12
          })
            .setLngLat(coordinates)
            .setText(racecourseLabelFor(racecourseId))
            .addTo(map);
        });
        map.on('mouseleave', MAP_HIT_LAYER, () => {
          setPointerCursor(false);
          hoverPopup?.remove();
          hoverPopup = null;
        });

        map.on('click', MAP_CLUSTER_LAYER, async (event) => {
          const cluster = event.features?.[0];
          const clusterId = cluster?.properties?.cluster_id;
          const coordinates = cluster?.geometry?.coordinates;
          if (!Number.isInteger(clusterId) || !Array.isArray(coordinates)) return;
          const source = map.getSource(MAP_SOURCE);
          if (!source || typeof source.getClusterExpansionZoom !== 'function') return;
          const zoom = await source.getClusterExpansionZoom(clusterId);
          map.easeTo({
            center: coordinates,
            zoom,
            duration: reducedMotion ? 0 : 240
          });
        });

        map.on('click', MAP_HIT_LAYER, (event) => {
          const racecourseId = event.features?.[0]?.properties?.racecourse_id;
          if (typeof racecourseId === 'string') setSelected(racecourseId, true, true);
        });

        map.on('click', (event) => {
          if (!root.dataset.selectedRacecourseId) return;
          const interactive = map.queryRenderedFeatures(event.point, {
            layers: [MAP_CLUSTER_LAYER, MAP_HIT_LAYER]
          });
          if (interactive.length === 0) clearSelected(true);
        });

        ready = true;
        applyVisibleIds([...visibleRacecourseIds], true);
        if (visibleRacecourseIds.size === 1 && features.length === 1) {
          const racecourseId = [...visibleRacecourseIds][0];
          setSelected(racecourseId, false);
        }

        root.addEventListener('racecourse-map:set-visible', (event) => {
          const ids = Array.isArray(event?.detail?.racecourseIds) ? event.detail.racecourseIds : [];
          applyVisibleIds(ids, event?.detail?.fit !== false);
        });

        root.addEventListener('racecourse-map:focus', (event) => {
          const racecourseId = event?.detail?.racecourseId;
          if (typeof racecourseId === 'string') focusRacecourse(racecourseId);
        });

        root.addEventListener('racecourse-map:clear-selection', () => clearSelected(false));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && root.dataset.selectedRacecourseId) clearSelected(true);
        });

        root.dataset.mapState = 'ready';
        if (status) status.hidden = true;
        applyStatuses();
        statusRefresh = window.setInterval(applyStatuses, STATUS_REFRESH_MS);
        window.addEventListener('whr:meetingstatechange', applyStatuses);
        window.addEventListener('whr:timezonechange', applyStatuses);
        window.addEventListener('whr:todayfilterchange', applyStatuses);

        root.dispatchEvent(new CustomEvent('racecourse-map:ready', {
          bubbles: true,
          detail: { featureCount: features.length, visibleFeatureCount: visibleRacecourseIds.size }
        }));

        const pendingFocus = root.dataset.pendingFocusRacecourseId;
        if (pendingFocus) {
          delete root.dataset.pendingFocusRacecourseId;
          focusRacecourse(pendingFocus);
        }
      });
    } catch {
      fail();
    }
  };

  const scheduleRacecourseMap = (root) => {
    const activate = () => {
      if (root.dataset.mapInitialized === 'true') return;
      observer?.disconnect();
      initRacecourseMap(root);
    };

    let observer = null;
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) activate();
      }, { rootMargin: '320px 0px' });
      observer.observe(root);
    } else {
      activate();
    }

    root.addEventListener('racecourse-map:activate', activate);
    root.addEventListener('racecourse-map:set-visible', () => {
      if (root.dataset.mapInitialized !== 'true') activate();
    });
    root.addEventListener('racecourse-map:focus', (event) => {
      if (root.dataset.mapInitialized === 'true') return;
      const racecourseId = event?.detail?.racecourseId;
      if (typeof racecourseId === 'string') root.dataset.pendingFocusRacecourseId = racecourseId;
      activate();
    });
  };

  document.querySelectorAll('[data-racecourse-map]').forEach((root) => {
    scheduleRacecourseMap(root);
  });
</script>