---
import RacecoursePublicMeetingPanelCore from './RacecoursePublicMeetingPanelCore.astro';
import RacecourseLocationMapSection from './RacecourseLocationMapSection.astro';
import { getCountries, getRacecourses } from '../lib/data';
import type { PublicRacecourseMeetingState } from '../lib/racecourses/publicRacecourseMeetingState';

interface Props {
  state: PublicRacecourseMeetingState;
  lang?: 'en' | 'ja';
  officialScheduleUrl?: string;
}

const { state, lang = 'en', officialScheduleUrl } = Astro.props;
const isJapanese = lang === 'ja';
const racecourse = getRacecourses().find((entry) => entry.id === state.racecourse_id) as any;
const country = racecourse
  ? getCountries().find((entry) => entry.id === racecourse.country_id) as any
  : null;
const racecourseName = racecourse
  ? (isJapanese ? racecourse.name_ja ?? racecourse.name_local ?? racecourse.name_en : racecourse.name_en)
  : state.racecourse_id;
const countryLabel = country
  ? (isJapanese ? country.name_ja ?? country.name_en : country.name_en)
  : racecourse?.country_id;
const locationContext = racecourse
  ? [racecourse.city, racecourse.region, countryLabel]
      .filter((value) => typeof value === 'string' && value.length > 0)
      .join(' / ')
  : undefined;
---

<RacecoursePublicMeetingPanelCore
  state={state}
  lang={lang}
  officialScheduleUrl={officialScheduleUrl}
/>

<RacecourseLocationMapSection
  racecourseId={state.racecourse_id}
  racecourseName={racecourseName}
  contextText={locationContext}
  lang={lang}
/>
