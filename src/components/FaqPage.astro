---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const isJa = locale === 'ja';

const content = isJa
  ? {
      title: 'よくある質問 | 競馬どこ？',
      description: '競馬どこ？の掲載情報、公式情報源、更新、時刻、ライブ配信などに関するよくある質問です。',
      eyebrow: 'よくある質問',
      heading: 'よくある質問',
      summary: '掲載情報の見方や、最新情報をどこで確認するかをまとめています。',
      sectionLabel: 'よくある質問と回答',
      relatedHeading: '関連ページ',
      relatedText: 'サイト概要、情報の扱い、免責事項、公式情報源もあわせて確認できます。',
      links: [
        { href: '/ja/about/', label: 'このサイトについて' },
        { href: '/ja/methods/', label: '情報の扱い' },
        { href: '/ja/disclaimer/', label: '免責事項' },
        { href: '/ja/sources/', label: '公式情報源' },
        { href: '/ja/glossary/', label: '用語集' },
      ],
      items: [
        {
          question: '競馬どこ？とは何ですか？',
          answer: '世界の競馬開催日、レース時刻、競馬場、競馬種別、公式情報源を探すためのガイドです。公式の出走表、結果、払戻、馬券ページの代わりではありません。',
        },
        {
          question: 'どのような情報を確認できますか？',
          answer: '国・地域ごとの競馬情報、競馬場、開催日、確認できたレース時刻やレース概要、競馬種別、用語、公式情報源を確認できます。掲載内容は国・競馬場・開催によって異なります。',
        },
        {
          question: '情報はどこから確認していますか？',
          answer: '主催者、規制機関、競馬場などの公式情報を優先しています。現在の開催日程や変更内容は、各ページから案内している公式情報源でも確認してください。',
        },
        {
          question: '情報はリアルタイムですか？',
          answer: 'リアルタイム更新を保証していません。開催日、発走時刻、配信条件などは変更される場合があるため、観戦や移動の前には公式情報源で最終確認してください。',
        },
        {
          question: '近日開催が表示されていない場合、その国では競馬がないのですか？',
          answer: 'いいえ。このサイトに現在掲載できる開催情報がないだけの場合があります。その国・地域の最新日程は公式情報源で確認してください。',
        },
        {
          question: '表示される時刻はどのタイムゾーンですか？',
          answer: 'ページに表示されるタイムゾーンを基準にしてください。開催地の現地時刻や選択した表示タイムゾーンとの関係は、ページ上の表示に従って確認してください。',
        },
        {
          question: '出走馬、騎手、調教師、オッズ、結果、払戻は掲載しますか？',
          answer: '原則として掲載しません。出走表、馬名、騎手名、調教師名、枠順、斤量、オッズ、結果、払戻、予想、買い目などは公式サービスで確認してください。',
        },
        {
          question: '馬券の予想や賭け方を案内しますか？',
          answer: '案内しません。競馬どこ？は開催情報を探すためのサイトで、馬券の推奨、予想、買い目、賭けの助言は提供しません。',
        },
        {
          question: 'ライブ配信やリプレイは見られますか？',
          answer: '公式のライブ配信やリプレイへの導線が確認できる場合は案内することがあります。視聴可否、地域制限、アカウント要否などは提供元の条件に従ってください。',
        },
        {
          question: '間違いや古い情報を見つけた場合はどうなりますか？',
          answer: '公式情報を確認したうえで訂正または表示内容を見直します。最新情報との食い違いがある場合は、公式情報源を優先してください。',
        },
      ],
    }
  : {
      title: 'Frequently Asked Questions | Where Horses Run',
      description: 'Frequently asked questions about listed racing information, official sources, updates, times, and live viewing routes.',
      eyebrow: 'FAQ',
      heading: 'Frequently Asked Questions',
      summary: 'How to read the site and where to confirm the latest racing information.',
      sectionLabel: 'Frequently asked questions and answers',
      relatedHeading: 'Related pages',
      relatedText: 'You can also read the site overview, information policy, disclaimer, official-source directory, and glossary.',
      links: [
        { href: '/about/', label: 'About' },
        { href: '/methods/', label: 'Information Policy' },
        { href: '/disclaimer/', label: 'Disclaimer' },
        { href: '/sources/', label: 'Official Sources' },
        { href: '/glossary/', label: 'Glossary' },
      ],
      items: [
        {
          question: 'What is Where Horses Run?',
          answer: 'Where Horses Run helps you find horse-racing dates, race times, racecourses, racing types, and official information around the world. It is not a replacement for official racecards, results, payouts, or betting services.',
        },
        {
          question: 'What information can I find here?',
          answer: 'You can browse racing by country or region, racecourse, date, racing type, glossary term, and official source. Available race times and lightweight race details are shown where the information is available.',
        },
        {
          question: 'Where does the information come from?',
          answer: 'Official information from organizers, regulators, and racecourses is prioritized. For current schedules and late changes, also confirm the official source linked from the relevant page.',
        },
        {
          question: 'Is the information real time?',
          answer: 'Real-time updates are not guaranteed. Meeting dates, post times, and viewing conditions can change, so confirm the official source before travel, viewing, or other plans.',
        },
        {
          question: 'If no upcoming meetings are shown, does that mean there is no racing?',
          answer: 'No. It may only mean that this site does not currently list an upcoming meeting for that country or region. Check the official source for the latest schedule.',
        },
        {
          question: 'Which timezone is used for displayed times?',
          answer: 'Use the timezone shown on the page. When a display timezone can be selected, the page presentation follows that selection while the official source remains the final reference for the event time.',
        },
        {
          question: 'Does the site publish entries, jockeys, trainers, odds, results, or payouts?',
          answer: 'Generally no. Entries, horse names, jockey and trainer names, draws, weights, odds, results, payouts, predictions, and betting picks should be checked on official services.',
        },
        {
          question: 'Does Where Horses Run provide betting advice?',
          answer: 'No. The site is for finding racing information and does not provide wagering recommendations, predictions, picks, or gambling advice.',
        },
        {
          question: 'Can I watch live racing or replays?',
          answer: 'When an official live or replay route is available, the site may provide a way to reach it. Availability, regional restrictions, account requirements, and other access conditions are set by the provider.',
        },
        {
          question: 'What happens if information is wrong or outdated?',
          answer: 'The displayed information is corrected or reduced after checking the official source. If there is a conflict, use the official source for the latest information.',
        },
      ],
    };

const canonicalPath = isJa ? '/ja/faq/' : '/faq/';
const alternatePath = isJa ? '/faq/' : '/ja/faq/';
const canonicalUrl = `https://whr.badjoke-lab.com${canonicalPath}`;
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  url: canonicalUrl,
  name: content.title,
  description: content.description,
  inLanguage: locale,
  isPartOf: { '@id': `${canonicalUrl}#webpage` },
  mainEntity: content.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const faqStructuredDataJson = JSON.stringify(faqStructuredData).replace(/</g, '\\u003c');
---

<BaseLayout
  title={content.title}
  description={content.description}
  lang={locale}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
>
  <script type="application/ld+json" set:html={faqStructuredDataJson}></script>

  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">{content.eyebrow}</p>
    <h1 id="page-title">{content.heading}</h1>
    <p class="hero__summary">{content.summary}</p>
  </section>

  <section class="faq-list" aria-label={content.sectionLabel}>
    {content.items.map((item, index) => (
      <article class="card faq-item" id={`question-${index + 1}`}>
        <h2>{item.question}</h2>
        <p>{item.answer}</p>
      </article>
    ))}
  </section>

  <section class="card faq-related" aria-labelledby="related-pages-heading">
    <h2 id="related-pages-heading">{content.relatedHeading}</h2>
    <p>{content.relatedText}</p>
    <p>
      {content.links.map((link, index) => (
        <>
          {index > 0 && ' · '}
          <a href={link.href}>{link.label}</a>
        </>
      ))}
    </p>
  </section>
</BaseLayout>

<style>
  .faq-list { display: grid; gap: 1rem; margin-block-start: 2rem; }
  .faq-item h2, .faq-item p, .faq-related h2, .faq-related p { margin-block: 0 0.75rem; }
  .faq-related { margin-block-start: 2rem; }
</style>
