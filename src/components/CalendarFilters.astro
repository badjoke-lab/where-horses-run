---
import type { TimetableMeetingRow } from '../data/timetableMeetingRows';
import {
  getCalendarAuthorityDisplayName,
  getCalendarCountryDisplayName,
} from '../lib/calendarDisplayNames';

type Props = { records: TimetableMeetingRow[]; lang?: 'en' | 'ja' };
const { records, lang = 'en' } = Astro.props as Props;
const isJa = lang === 'ja';
const countries = [...new Map(records.map((record) => [
  record.country_id,
  getCalendarCountryDisplayName(record.country_id, record.country_label, lang),
])).entries()].sort((a, b) => a[1].localeCompare(b[1], isJa ? 'ja' : 'en'));
const authorities = [...new Map(records.map((record) => [
  record.authority_id,
  getCalendarAuthorityDisplayName(record.authority_id, record.authority_label, lang),
])).entries()].sort((a, b) => a[1].localeCompare(b[1], isJa ? 'ja' : 'en'));
const ranks = ['A+', 'A', 'B+', 'B', 'C'].filter((rank) => records.some((record) => record.capability_rank === rank));
---

<details class="calendar-filters" data-calendar-filters>
  <summary class="calendar-filters__summary">
    <span>{isJa ? '絞り込み' : 'Filters'}</span>
    <small data-filter-summary>{isJa ? '0件の条件' : '0 active'}</small>
  </summary>
  <div class="calendar-filters__panel">
    <div class="calendar-filters__grid">
      <label><strong>{isJa ? '競馬場' : 'Racecourse'}</strong><input type="search" data-filter-search placeholder={isJa ? '競馬場を検索…' : 'Search racecourse…'} /></label>
      <label><strong>{isJa ? '国' : 'Country'}</strong><select data-filter-country><option value="">{isJa ? 'すべて' : 'All'}</option>{countries.map(([id, label]) => <option value={id}>{label}</option>)}</select></label>
      <label><strong>{isJa ? '主催' : 'Authority'}</strong><select data-filter-authority><option value="">{isJa ? 'すべて' : 'All'}</option>{authorities.map(([id, label]) => <option value={id}>{label}</option>)}</select></label>
      <label><strong>{isJa ? '公開ランク' : 'Rank'}</strong><select data-filter-rank><option value="">{isJa ? 'すべて' : 'All'}</option>{ranks.map((rank) => <option value={rank}>{rank}</option>)}</select></label>
      <label>
        <strong>{isJa ? '開催状態' : 'Meeting state'}</strong>
        <select data-filter-meeting-state>
          <option value="">{isJa ? 'すべて' : 'All'}</option>
          <option value="running">{isJa ? '開催中' : 'Racing now'}</option>
          <option value="upcoming">{isJa ? '開催前' : 'Upcoming'}</option>
          <option value="today">{isJa ? '本日開催' : 'Today meeting'}</option>
          <option value="ended">{isJa ? '終了' : 'Finished'}</option>
          <option value="future">{isJa ? '開催予定' : 'Scheduled'}</option>
        </select>
      </label>
      <label>
        <strong>{isJa ? '配信' : 'Stream'}</strong>
        <select data-filter-stream>
          <option value="">{isJa ? 'すべて' : 'All'}</option>
          <option value="live" data-stream-live-option hidden disabled>{isJa ? '公式配信中' : 'Live now'}</option>
          <option value="available">{isJa ? '公式配信あり' : 'Official stream available'}</option>
        </select>
      </label>
    </div>
    <div class="calendar-filters__footer">
      <button type="button" data-filter-reset>{isJa ? '絞り込みをリセット' : 'Reset filters'}</button>
      <p aria-live="polite" data-filter-result></p>
    </div>
  </div>
</details>

<script>
  import { deriveMeetingStreamState } from '../lib/timetable/meetingStreamState.mjs';

  const init = () => {
    const root = document.querySelector('[data-calendar-filters]');
    if (!(root instanceof HTMLDetailsElement) || root.dataset.filterReady === 'true') return;
    const search = root.querySelector('[data-filter-search]');
    const country = root.querySelector('[data-filter-country]');
    const authority = root.querySelector('[data-filter-authority]');
    const rank = root.querySelector('[data-filter-rank]');
    const meetingState = root.querySelector('[data-filter-meeting-state]');
    const stream = root.querySelector('[data-filter-stream]');
    const streamLiveOption = root.querySelector('[data-stream-live-option]');
    const date = document.querySelector('[data-filter-date]');
    const reset = root.querySelector('[data-filter-reset]');
    const result = root.querySelector('[data-filter-result]');
    const summary = root.querySelector('[data-filter-summary]');
    const isJa = document.documentElement.lang === 'ja';
    if (!(search instanceof HTMLInputElement) || !(country instanceof HTMLSelectElement) || !(authority instanceof HTMLSelectElement) ||
        !(rank instanceof HTMLSelectElement) || !(meetingState instanceof HTMLSelectElement) || !(stream instanceof HTMLSelectElement) ||
        !(streamLiveOption instanceof HTMLOptionElement) || !(date instanceof HTMLSelectElement) || !(reset instanceof HTMLButtonElement)) return;

    root.dataset.filterReady = 'true';
    root.open = false;
    let refreshTimer = null;
    let lastPayload = { statuses: [] };
    const rows = () => [...document.querySelectorAll('[data-calendar-meeting-row]')];
    const groups = () => [...document.querySelectorAll('[data-calendar-date-group]')];
    const normalize = (value) => value.trim().toLocaleLowerCase();
    const isWithinTimezoneScope = (row) => row instanceof HTMLElement && row.dataset.timezoneScopeHidden !== 'true';
    const activeFilterCount = () => [search.value, country.value, authority.value, rank.value, meetingState.value, stream.value].filter(Boolean).length;

    const setLiveOptionAvailability = (available) => {
      streamLiveOption.hidden = !available;
      streamLiveOption.disabled = !available;
      if (!available && stream.value === 'live') stream.value = '';
    };

    const apply = () => {
      const query = normalize(search.value);
      let visible = 0;
      for (const row of rows()) {
        if (!(row instanceof HTMLElement)) continue;
        const racecourseSearch = row.dataset.racecourseSearch || row.dataset.racecourse || '';
        const matches = isWithinTimezoneScope(row) &&
          (!date.value || row.dataset.date === date.value) &&
          (!query || normalize(racecourseSearch).includes(query)) &&
          (!country.value || row.dataset.country === country.value) &&
          (!authority.value || row.dataset.authority === authority.value) &&
          (!rank.value || row.dataset.rank === rank.value) &&
          (!meetingState.value || row.dataset.meetingPresentationState === meetingState.value) &&
          (!stream.value || (stream.value === 'live' && row.dataset.streamState === 'live') || (stream.value === 'available' && row.dataset.liveAvailable === 'true'));
        row.hidden = !matches;
        if (matches) visible += 1;
      }
      for (const group of groups()) {
        if (!(group instanceof HTMLElement)) continue;
        group.hidden = ![...group.querySelectorAll('[data-calendar-meeting-row]')].some((row) => row instanceof HTMLElement && !row.hidden);
      }
      const dateLabel = date.value || (isJa ? '選択日' : 'Selected date');
      if (result) result.textContent = isJa ? `${dateLabel} · ${visible}開催` : `${dateLabel} · ${visible} meetings`;
      if (summary) {
        const active = activeFilterCount();
        summary.textContent = isJa ? `${active}件の条件 · ${visible}開催` : `${active} active · ${visible} meetings`;
      }
      window.dispatchEvent(new CustomEvent('whr:calendarfilterchange', { detail: { visible, date: date.value } }));
    };

    const applyStreamStatuses = (payload) => {
      const statuses = Array.isArray(payload?.statuses) ? payload.statuses : [];
      const byDetectorId = new Map(statuses.filter((entry) => entry && typeof entry.detector_id === 'string').map((entry) => [entry.detector_id, entry]));
      let hasLiveMeeting = false;

      for (const row of rows()) {
        if (!(row instanceof HTMLElement)) continue;
        const detectorId = row.dataset.liveDetectorId || '';
        const entry = byDetectorId.get(detectorId);
        const sourceDate = row.dataset.sourceDate || row.dataset.date || '';
        const detectorStatus = entry?.status === 'live' || entry?.status === 'upcoming' || entry?.status === 'ended' || entry?.status === 'offline'
          ? entry.status
          : 'unknown';
        const eventDate = typeof entry?.event_date === 'string' ? entry.event_date : '';
        const state = deriveMeetingStreamState({
          hasOfficialDestination: row.dataset.liveAvailable === 'true',
          detectorStatus,
          eventDate,
          sourceDate,
        });
        row.dataset.streamState = state;
        if (state === 'live') hasLiveMeeting = true;

        const link = row.querySelector('[data-live-link]');
        if (link instanceof HTMLAnchorElement) {
          const defaultHref = link.dataset.liveDefaultHref || link.href;
          link.href = defaultHref;
          link.textContent = state === 'live'
            ? (isJa ? '● 公式配信中 ↗' : '● Live now ↗')
            : (isJa ? '公式配信 ↗' : 'Official stream ↗');
        }
      }

      setLiveOptionAvailability(hasLiveMeeting);
      apply();
    };

    const scheduleRefresh = (delay) => {
      if (refreshTimer !== null) window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(refreshStreamStatus, delay);
    };

    const refreshStreamStatus = async () => {
      try {
        const response = await fetch(new URL('/api/live-status', location.origin), { headers: { accept: 'application/json' }, cache: 'no-store' });
        if (!response.ok) throw new Error(`live status ${response.status}`);
        const payload = await response.json();
        if (payload?.configured !== true) throw new Error('live status not configured');
        lastPayload = payload;
        applyStreamStatuses(lastPayload);
        const requestedRefresh = Number(payload?.refresh_after_seconds);
        const refreshSeconds = Number.isFinite(requestedRefresh) ? Math.min(3600, Math.max(60, requestedRefresh)) : 900;
        scheduleRefresh(refreshSeconds * 1000);
      } catch {
        lastPayload = { statuses: [] };
        applyStreamStatuses(lastPayload);
        scheduleRefresh(300_000);
      }
    };

    for (const control of [search, country, authority, rank, meetingState, stream]) {
      control.addEventListener('input', apply);
      control.addEventListener('change', apply);
    }
    date.addEventListener('change', apply);
    reset.addEventListener('click', () => {
      search.value = '';
      country.value = '';
      authority.value = '';
      rank.value = '';
      meetingState.value = '';
      stream.value = '';
      apply();
    });
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const countryTrigger = target.closest('[data-coverage-filter-country]');
      if (countryTrigger instanceof HTMLElement) {
        country.value = countryTrigger.dataset.coverageFilterCountry || '';
        if (countryTrigger.dataset.coverageFilterLive) stream.value = countryTrigger.dataset.coverageFilterLive === 'now' ? 'live' : 'available';
        apply();
        root.open = true;
        root.scrollIntoView({ block: 'center' });
      }
    });
    window.addEventListener('whr:timezonechange', () => requestAnimationFrame(() => applyStreamStatuses(lastPayload)));
    window.addEventListener('whr:meetingstatechange', apply);
    window.addEventListener('whr:calendardatechange', apply);
    setLiveOptionAvailability(false);
    apply();
    refreshStreamStatus();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>