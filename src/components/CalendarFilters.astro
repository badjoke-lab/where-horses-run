---
import type { TimetableMeetingRow } from '../data/timetableMeetingRows';

type Props = { records: TimetableMeetingRow[]; lang?: 'en' | 'ja' };
const { records, lang = 'en' } = Astro.props as Props;
const isJa = lang === 'ja';
const unique = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b));
const countries = unique(records.map((record) => record.country_label));
const authorities = unique(records.map((record) => record.authority_label));
const dates = unique(records.map((record) => record.date));
const ranks = ['A+', 'A', 'B+', 'B', 'C'].filter((rank) => records.some((record) => record.capability_rank === rank));
---

<section class="calendar-filters card flow" data-calendar-filters aria-label={isJa ? 'カレンダー絞り込み' : 'Calendar filters'}>
  <h2>{isJa ? '開催を絞り込む' : 'Filter meetings'}</h2>
  <div class="section-grid">
    <label><strong>{isJa ? '競馬場' : 'Racecourse'}</strong><br /><input type="search" data-filter-search placeholder={isJa ? '競馬場を検索…' : 'Search racecourse…'} /></label>
    <label><strong>{isJa ? '国' : 'Country'}</strong><br /><select data-filter-country><option value="">{isJa ? 'すべて' : 'All'}</option>{countries.map((country) => <option value={country}>{country}</option>)}</select></label>
    <label><strong>{isJa ? '主催' : 'Authority'}</strong><br /><select data-filter-authority><option value="">{isJa ? 'すべて' : 'All'}</option>{authorities.map((authority) => <option value={authority}>{authority}</option>)}</select></label>
    <label><strong>{isJa ? '公開ランク' : 'Rank'}</strong><br /><select data-filter-rank><option value="">{isJa ? 'すべて' : 'All'}</option>{ranks.map((rank) => <option value={rank}>{rank}</option>)}</select></label>
    <label>
      <strong>{isJa ? '開催状態' : 'Meeting state'}</strong><br />
      <select data-filter-meeting-state>
        <option value="">{isJa ? 'すべて' : 'All'}</option>
        <option value="upcoming">{isJa ? '開催前' : 'Upcoming'}</option>
        <option value="running">{isJa ? '開催中' : 'Racing now'}</option>
        <option value="ended">{isJa ? '終了' : 'Finished'}</option>
      </select>
    </label>
    <label>
      <strong>{isJa ? '配信' : 'Stream'}</strong><br />
      <select data-filter-stream>
        <option value="">{isJa ? 'すべて' : 'All'}</option>
        <option value="live" data-stream-live-option hidden disabled>{isJa ? '公式配信中' : 'Official stream live'}</option>
        <option value="available">{isJa ? '公式ライブあり' : 'Official live available'}</option>
      </select>
    </label>
    <label><strong>{isJa ? '日付' : 'Date'}</strong><br /><select data-filter-date><option value="">{isJa ? '30日すべて' : 'All 30 days'}</option>{dates.map((date) => <option value={date}>{date}</option>)}</select></label>
  </div>
  <p><button type="button" data-filter-reset>{isJa ? 'リセット' : 'Reset'}</button></p>
  <p aria-live="polite" data-filter-result></p>
</section>

<script is:inline>
  (() => {
    const init = () => {
      const root = document.querySelector('[data-calendar-filters]');
      if (!root || root.dataset.filterReady === 'true') return;
      const search = root.querySelector('[data-filter-search]');
      const country = root.querySelector('[data-filter-country]');
      const authority = root.querySelector('[data-filter-authority]');
      const rank = root.querySelector('[data-filter-rank]');
      const meetingState = root.querySelector('[data-filter-meeting-state]');
      const stream = root.querySelector('[data-filter-stream]');
      const streamLiveOption = root.querySelector('[data-stream-live-option]');
      const date = root.querySelector('[data-filter-date]');
      const reset = root.querySelector('[data-filter-reset]');
      const result = root.querySelector('[data-filter-result]');
      const isJa = document.documentElement.lang === 'ja';
      if (!(search instanceof HTMLInputElement) || !(country instanceof HTMLSelectElement) || !(authority instanceof HTMLSelectElement) ||
          !(rank instanceof HTMLSelectElement) || !(meetingState instanceof HTMLSelectElement) || !(stream instanceof HTMLSelectElement) ||
          !(streamLiveOption instanceof HTMLOptionElement) || !(date instanceof HTMLSelectElement) || !(reset instanceof HTMLButtonElement)) return;

      root.dataset.filterReady = 'true';
      let refreshTimer = null;
      let lastPayload = { statuses: [] };
      const rows = () => [...document.querySelectorAll('[data-calendar-meeting-row]')];
      const groups = () => [...document.querySelectorAll('[data-calendar-date-group]')];
      const normalize = (value) => value.trim().toLocaleLowerCase();
      const isWithinTimezoneScope = (row) => row instanceof HTMLElement && row.dataset.timezoneScopeHidden !== 'true';

      const setStreamFeedAvailable = (available) => {
        streamLiveOption.hidden = !available;
        streamLiveOption.disabled = !available;
        if (!available && stream.value === 'live') stream.value = '';
      };
      const syncDateOptions = () => {
        const current = date.value;
        const values = [...new Set(rows().filter(isWithinTimezoneScope).map((row) => row.dataset.date || '').filter(Boolean))].sort();
        const all = document.createElement('option');
        all.value = '';
        all.textContent = isJa ? '30日すべて' : 'All 30 days';
        date.replaceChildren(all, ...values.map((value) => { const option = document.createElement('option'); option.value = value; option.textContent = value; return option; }));
        if (current && values.includes(current)) date.value = current;
        else if (current) date.value = '';
      };
      const apply = () => {
        const query = normalize(search.value);
        let visible = 0;
        for (const row of rows()) {
          if (!(row instanceof HTMLElement)) continue;
          const matches = isWithinTimezoneScope(row) &&
            (!query || normalize(row.dataset.racecourse || '').includes(query)) &&
            (!country.value || row.dataset.country === country.value) &&
            (!authority.value || row.dataset.authority === authority.value) &&
            (!rank.value || row.dataset.rank === rank.value) &&
            (!meetingState.value || row.dataset.meetingState === meetingState.value) &&
            (!date.value || row.dataset.date === date.value) &&
            (!stream.value || (stream.value === 'live' && row.dataset.streamState === 'live') || (stream.value === 'available' && row.dataset.liveAvailable === 'true'));
          row.hidden = !matches;
          if (matches) visible += 1;
        }
        for (const group of groups()) {
          if (!(group instanceof HTMLElement)) continue;
          group.hidden = ![...group.querySelectorAll('[data-calendar-meeting-row]')].some((row) => row instanceof HTMLElement && !row.hidden);
        }
        if (result) result.textContent = isJa ? `${visible}開催を表示` : `${visible} meetings shown`;
      };
      const applyStreamStatuses = (payload) => {
        const statuses = Array.isArray(payload?.statuses) ? payload.statuses : [];
        const byDetectorId = new Map(statuses.filter((entry) => entry && typeof entry.detector_id === 'string').map((entry) => [entry.detector_id, entry]));
        for (const row of rows()) {
          if (!(row instanceof HTMLElement)) continue;
          const detectorId = row.dataset.liveDetectorId || '';
          const entry = byDetectorId.get(detectorId);
          const rawState = entry?.status === 'live' || entry?.status === 'upcoming' || entry?.status === 'ended' || entry?.status === 'offline' ? entry.status : 'unknown';
          const eventSpecific = rawState === 'live' || rawState === 'upcoming' || rawState === 'ended';
          const sourceDate = row.dataset.sourceDate || row.dataset.date || '';
          const dateMatches = typeof entry?.event_date === 'string' && entry.event_date === sourceDate;
          const state = eventSpecific && !dateMatches ? 'unknown' : rawState;
          row.dataset.streamState = state;
          const badge = row.querySelector('[data-stream-live-badge]');
          if (badge instanceof HTMLElement) badge.hidden = state !== 'live';
          const link = row.querySelector('[data-live-link]');
          if (link instanceof HTMLAnchorElement) {
            const defaultHref = link.dataset.liveDefaultHref || link.href;
            const videoId = typeof entry?.video_id === 'string' && /^[A-Za-z0-9_-]{11}$/.test(entry.video_id) ? entry.video_id : null;
            const useWatchPage = dateMatches && videoId && (state === 'live' || state === 'upcoming');
            link.href = useWatchPage ? `https://www.youtube.com/watch?v=${videoId}` : defaultHref;
            link.textContent = isJa ? '公式ライブ ↗' : 'Official live ↗';
          }
        }
        apply();
      };
      const scheduleRefresh = (delay) => {
        if (refreshTimer !== null) window.clearTimeout(refreshTimer);
        refreshTimer = window.setTimeout(refreshStreamStatus, delay);
      };
      const refreshStreamStatus = async () => {
        try {
          const response = await fetch(new URL('/api/live-status', location.origin), { headers: { accept: 'application/json' }, cache: 'no-store' });
          if (!response.ok) throw new Error(`live status ${response.status}`);
          const payload = await response.json();
          if (payload?.configured !== true) throw new Error('live status not configured');
          lastPayload = payload;
          setStreamFeedAvailable(true);
          applyStreamStatuses(lastPayload);
          const requestedRefresh = Number(payload?.refresh_after_seconds);
          const refreshSeconds = Number.isFinite(requestedRefresh) ? Math.min(3600, Math.max(60, requestedRefresh)) : 900;
          scheduleRefresh(refreshSeconds * 1000);
        } catch {
          setStreamFeedAvailable(false);
          lastPayload = { statuses: [] };
          applyStreamStatuses(lastPayload);
          scheduleRefresh(300_000);
        }
      };
      for (const control of [search, country, authority, rank, meetingState, stream, date]) {
        control.addEventListener('input', apply);
        control.addEventListener('change', apply);
      }
      reset.addEventListener('click', () => {
        search.value = ''; country.value = ''; authority.value = ''; rank.value = ''; meetingState.value = ''; stream.value = ''; date.value = '';
        const url = new URL(location.href); url.searchParams.delete('date'); history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`); apply();
      });
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const countryTrigger = target.closest('[data-coverage-filter-country]');
        if (countryTrigger instanceof HTMLElement) {
          country.value = countryTrigger.dataset.coverageFilterCountry || '';
          if (countryTrigger.dataset.coverageFilterLive) stream.value = countryTrigger.dataset.coverageFilterLive === 'now' ? 'live' : countryTrigger.dataset.coverageFilterLive;
          apply(); root.scrollIntoView({ block: 'center' });
        }
      });
      window.addEventListener('whr:timezonechange', () => { syncDateOptions(); applyStreamStatuses(lastPayload); });
      window.addEventListener('whr:meetingstatechange', apply);
      syncDateOptions();
      const requestedDate = new URLSearchParams(location.search).get('date');
      if (requestedDate && [...date.options].some((option) => option.value === requestedDate)) date.value = requestedDate;
      setStreamFeedAvailable(false);
      apply();
      refreshStreamStatus();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else init();
  })();
</script>
