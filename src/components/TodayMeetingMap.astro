---
import RacecourseMap from './RacecourseMap.astro';
import locationRegistry from '../../data/static/racecourse-locations-v1.json';
import { getRacecourses } from '../lib/data';
import type { TimetableMeetingRow } from '../data/timetableMeetingRows';

interface Props {
  records: TimetableMeetingRow[];
  date: string;
  lang?: 'en' | 'ja';
}

const { records, date, lang = 'en' } = Astro.props;
const isJapanese = lang === 'ja';
const reviewedRacecourseIds = new Set(
  ((locationRegistry as any).locations ?? [])
    .map((entry: any) => entry?.id)
    .filter((id: unknown) => typeof id === 'string' && id.length > 0)
);
const racecourseById = new Map(getRacecourses().map((track) => [track.id, track]));
const mappedRecords = records.filter((record) => reviewedRacecourseIds.has(record.racecourse_id));
const candidateRacecourseIds = [...new Set(mappedRecords.map((record) => record.racecourse_id))];
const initialVisibleRacecourseIds = [...new Set(
  mappedRecords.filter((record) => record.date === date).map((record) => record.racecourse_id)
)];
const meetingMap = records.map((record) => ({
  meetingId: record.meeting_id,
  racecourseId: record.racecourse_id,
  racecourseSlug: racecourseById.get(record.racecourse_id)?.slug ?? null,
  hasReviewedLocation: reviewedRacecourseIds.has(record.racecourse_id),
}));
const meetingMapJson = JSON.stringify(meetingMap).replace(/</g, '\\u003c');
const unresolvedCandidateCount = records.filter((record) => !reviewedRacecourseIds.has(record.racecourse_id)).length;
const fallbackMessage = isJapanese
  ? 'インタラクティブ地図を読み込めません。下の開催一覧、競馬場リンク、公式リンクは引き続き利用できます。'
  : 'Interactive map unavailable. The meeting list, racecourse links, and official links below remain available.';
---

<section class="today-meeting-map card" aria-labelledby="today-map-title" data-today-map-sync data-lang={lang}>
  <div class="today-meeting-map__heading">
    <div>
      <p class="today-meeting-map__eyebrow">{isJapanese ? '同じ公開開催データ' : 'Same public meeting data'}</p>
      <h2 id="today-map-title">{isJapanese ? '今日の開催マップ' : 'Today on the map'}</h2>
    </div>
    <p class="today-meeting-map__status" data-today-map-status aria-live="polite">
      {initialVisibleRacecourseIds.length} {isJapanese ? '競馬場を地図表示' : 'mapped racecourses'}
    </p>
  </div>

  <p>
    {isJapanese
      ? '地図と下の開催一覧は同じ公開meeting recordを使用します。地図の地点を選ぶと対応する開催が選択され、一覧の「地図」から地点へフォーカスできます。'
      : 'The map and meeting list below use the same public meeting records. Select a point to select its meeting, or use Map on a row to focus that venue.'}
  </p>

  {candidateRacecourseIds.length > 0 ? (
    <>
      <RacecourseMap
        racecourseIds={candidateRacecourseIds}
        visibleRacecourseIds={initialVisibleRacecourseIds}
        initialZoom={2.25}
        ariaLabel={isJapanese ? '今日の確認済み開催競馬場マップ' : 'Map of reviewed racecourses with meetings today'}
        fallbackMessage={fallbackMessage}
      />
      <p class="racecourse-map__attribution">
        Map: <a href="https://openfreemap.org/">OpenFreeMap</a> · Data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
      </p>
      <div class="today-meeting-map__selected map-selected-card" data-today-map-selected hidden>
        <div class="map-selected-card__body">
          <strong data-today-map-selected-label></strong>
          <span class="map-selected-card__status" data-today-map-selected-status></span>
          <span class="map-selected-card__meta" data-today-map-selected-meta></span>
        </div>
        <div class="map-selected-card__actions">
          <a data-today-map-selected-track hidden>{isJapanese ? '競馬場ページ' : 'Racecourse page'}</a>
          <button type="button" data-today-map-show-list>{isJapanese ? 'Listで見る' : 'Show in List'}</button>
          <button type="button" class="map-selected-card__close" data-today-map-close aria-label={isJapanese ? '選択を閉じる' : 'Close selection'}>×</button>
        </div>
      </div>
    </>
  ) : (
    <p>{isJapanese ? '現在の候補開催には、確認済み位置情報を持つ競馬場がありません。' : 'No candidate meeting currently has a reviewed racecourse location.'}</p>
  )}

  {unresolvedCandidateCount > 0 ? (
    <p class="racecourse-map__meta">
      {isJapanese
        ? `位置未確認の開催 ${unresolvedCandidateCount}件は、開催一覧には残し、地図には推測表示しません。`
        : `${unresolvedCandidateCount} meeting(s) without a reviewed venue location remain in the list and are not guessed onto the map.`}
    </p>
  ) : null}

  <script type="application/json" data-today-map-meeting-map set:html={meetingMapJson}></script>
</section>

<script is:inline>
  (() => {
    const install = () => {
      document.querySelectorAll('[data-today-map-sync]').forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.todayMapInitialized === 'true') return;
        root.dataset.todayMapInitialized = 'true';

        const mapRoot = root.querySelector('[data-racecourse-map]');
        const status = root.querySelector('[data-today-map-status]');
        const dataNode = root.querySelector('[data-today-map-meeting-map]');
        const selectedBox = root.querySelector('[data-today-map-selected]');
        const selectedLabel = root.querySelector('[data-today-map-selected-label]');
        const selectedStatus = root.querySelector('[data-today-map-selected-status]');
        const selectedMeta = root.querySelector('[data-today-map-selected-meta]');
        const selectedTrack = root.querySelector('[data-today-map-selected-track]');
        const showListButton = root.querySelector('[data-today-map-show-list]');
        const closeButton = root.querySelector('[data-today-map-close]');
        if (!(mapRoot instanceof HTMLElement) || !(dataNode instanceof HTMLScriptElement)) return;

        let entries = [];
        try { entries = JSON.parse(dataNode.textContent || '[]'); } catch { entries = []; }
        const mapping = new Map(entries.map((entry) => [entry.meetingId, entry]));
        const isJa = root.dataset.lang === 'ja';
        let selectedRacecourseId = null;

        const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const listRows = () => Array.from(document.querySelectorAll('[data-calendar-meeting-row]'))
          .filter((row) => row instanceof HTMLElement);
        const mappedEntryForRow = (row) => mapping.get(row.dataset.meetingId || '');
        const visibleRacecourseIds = () => Array.from(new Set(
          listRows()
            .filter((row) => row.dataset.timezoneScopeHidden !== 'true' && !row.hidden)
            .map(mappedEntryForRow)
            .filter((entry) => entry?.hasReviewedLocation)
            .map((entry) => entry.racecourseId)
        ));
        const statusForRow = (row) => {
          const meetingState = row.dataset.meetingState || 'unknown';
          const dayState = row.dataset.meetingDayState || 'unknown';
          if (meetingState === 'running') return { key: 'running', label: isJa ? '開催中' : 'Racing now' };
          if ((meetingState === 'upcoming' || meetingState === 'unknown') && dayState === 'today') {
            return { key: 'upcoming', label: isJa ? '今日これから' : 'Later today' };
          }
          if (meetingState === 'ended' || dayState === 'past') return { key: 'ended', label: isJa ? '終了' : 'Finished' };
          return { key: 'future', label: isJa ? '開催予定' : 'Scheduled' };
        };
        const timeForRow = (row) => {
          const first = row.querySelector('[data-race-time="first"]')?.textContent?.trim() || '';
          const last = row.querySelector('[data-race-time="last"]')?.textContent?.trim() || '';
          if (first && last) return `${first}–${last}`;
          if (first) return `${first}–`;
          return '—';
        };

        const clearRowSelection = () => {
          listRows().forEach((row) => row.classList.remove('meeting-row--map-selected'));
        };
        const hideSelected = () => {
          selectedRacecourseId = null;
          clearRowSelection();
          if (selectedBox instanceof HTMLElement) selectedBox.hidden = true;
          if (selectedLabel) selectedLabel.textContent = '';
          if (selectedStatus instanceof HTMLElement) {
            selectedStatus.textContent = '';
            delete selectedStatus.dataset.status;
          }
          if (selectedMeta) selectedMeta.textContent = '';
          if (selectedTrack instanceof HTMLAnchorElement) {
            selectedTrack.hidden = true;
            selectedTrack.removeAttribute('href');
          }
        };
        const matchingRowsForRacecourse = (racecourseId) => listRows().filter((row) => {
          const entry = mappedEntryForRow(row);
          return entry?.racecourseId === racecourseId && row.dataset.timezoneScopeHidden !== 'true' && !row.hidden;
        });
        const renderSelectedDetails = (first) => {
          const entry = mappedEntryForRow(first);
          const meetingStatus = statusForRow(first);
          if (selectedLabel) selectedLabel.textContent = first.dataset.racecourse || entry?.racecourseId || '';
          if (selectedStatus instanceof HTMLElement) {
            selectedStatus.textContent = meetingStatus.label;
            selectedStatus.dataset.status = meetingStatus.key;
          }
          if (selectedMeta) {
            const rank = first.dataset.rank || '—';
            selectedMeta.textContent = `${timeForRow(first)} · ${isJa ? '公開ランク' : 'Public rank'} ${rank}`;
          }
          if (selectedTrack instanceof HTMLAnchorElement && entry?.racecourseSlug) {
            selectedTrack.href = `${isJa ? '/ja' : ''}/tracks/${entry.racecourseSlug}/`;
            selectedTrack.hidden = false;
          } else if (selectedTrack instanceof HTMLAnchorElement) {
            selectedTrack.hidden = true;
            selectedTrack.removeAttribute('href');
          }
        };
        const selectRowsForRacecourse = (racecourseId) => {
          clearRowSelection();
          const matchingRows = matchingRowsForRacecourse(racecourseId);
          matchingRows.forEach((row) => row.classList.add('meeting-row--map-selected'));
          const first = matchingRows[0];
          if (!first) {
            hideSelected();
            return null;
          }
          selectedRacecourseId = racecourseId;
          renderSelectedDetails(first);
          if (selectedBox instanceof HTMLElement) selectedBox.hidden = false;
          return first;
        };
        const showSelectedInList = () => {
          if (!selectedRacecourseId) return;
          const first = matchingRowsForRacecourse(selectedRacecourseId)[0];
          if (!first) return;
          first.scrollIntoView({ block: 'center', behavior: reducedMotion() ? 'auto' : 'smooth' });
          const button = first.querySelector('[data-meeting-map-focus]');
          if (button instanceof HTMLElement) button.focus({ preventScroll: true });
        };
        const clearMapSelection = () => {
          if (!(mapRoot instanceof HTMLElement)) return;
          mapRoot.dispatchEvent(new CustomEvent('racecourse-map:clear-selection'));
        };

        const addListMapControls = () => {
          listRows().forEach((row) => {
            if (row.querySelector('[data-meeting-map-focus]')) return;
            const entry = mappedEntryForRow(row);
            if (!entry?.hasReviewedLocation) return;
            const identity = row.querySelector('.meeting-row__identity');
            if (!(identity instanceof HTMLElement)) return;
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'meeting-row__map-focus';
            button.dataset.meetingMapFocus = 'true';
            button.textContent = isJa ? '地図' : 'Map';
            button.setAttribute('aria-label', isJa ? 'この競馬場を地図で表示' : 'Show this racecourse on the map');
            button.addEventListener('click', () => {
              selectRowsForRacecourse(entry.racecourseId);
              root.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
              requestAnimationFrame(() => mapRoot.dispatchEvent(new CustomEvent('racecourse-map:focus', {
                detail: { racecourseId: entry.racecourseId }
              })));
            });
            identity.append(' ', button);
          });
        };

        const syncVisible = () => {
          addListMapControls();
          const ids = visibleRacecourseIds();
          mapRoot.dispatchEvent(new CustomEvent('racecourse-map:set-visible', {
            detail: { racecourseIds: ids, fit: true }
          }));
          if (status) {
            status.textContent = isJa ? `${ids.length}競馬場を地図表示` : `${ids.length} mapped racecourses`;
          }
          if (selectedRacecourseId && !ids.includes(selectedRacecourseId)) hideSelected();
          else if (selectedRacecourseId) selectRowsForRacecourse(selectedRacecourseId);
        };

        mapRoot.addEventListener('racecourse-map:ready', syncVisible);
        mapRoot.addEventListener('racecourse-map:deselect', hideSelected);
        mapRoot.addEventListener('racecourse-map:select', (event) => {
          const racecourseId = event?.detail?.racecourseId;
          if (typeof racecourseId !== 'string') return;
          const first = selectRowsForRacecourse(racecourseId);
          if (first && !window.matchMedia('(max-width: 700px)').matches) showSelectedInList();
        });
        if (showListButton instanceof HTMLButtonElement) showListButton.addEventListener('click', showSelectedInList);
        if (closeButton instanceof HTMLButtonElement) {
          closeButton.addEventListener('click', () => {
            const closing = selectedRacecourseId;
            hideSelected();
            clearMapSelection(closing);
          });
        }
        window.addEventListener('whr:timezonechange', () => requestAnimationFrame(syncVisible));
        window.addEventListener('whr:meetingstatechange', () => requestAnimationFrame(syncVisible));

        addListMapControls();
        syncVisible();
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true });
    else install();
  })();
</script>