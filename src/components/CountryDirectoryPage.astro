---
import BaseLayout from '../layouts/BaseLayout.astro';
import type {
  CountryDirectoryLocale,
  CountryFilterOptions,
  CountryFilterRecord,
} from '../lib/country-filter-data';

interface Props {
  locale: CountryDirectoryLocale;
  records: CountryFilterRecord[];
  options: CountryFilterOptions;
}

const { locale, records } = Astro.props;
const isJapanese = locale === 'ja';
const directoryPath = isJapanese ? '/ja/countries/' : '/countries/';
const calendarPath = isJapanese ? '/ja/calendar/' : '/calendar/';
const tracksPath = isJapanese ? '/ja/tracks/' : '/tracks/';

const racingTypeLabelsJa: Record<string, string> = {
  'thoroughbred-flat': 'サラブレッド平地',
  'thoroughbred-racing': 'サラブレッド競馬',
  'jump-racing': '障害競走',
  steeplechase: '障害競走',
  'harness-racing': '繋駕速歩',
  trotting: 'トロット',
  pacing: 'ペース',
  'arabian-racing': 'アラブ競馬',
  'quarter-horse-racing': 'クォーターホース',
  'banei-racing': 'ばんえい',
};

const regionLabelsJa: Record<string, string> = {
  Africa: 'アフリカ',
  Asia: 'アジア',
  Caribbean: 'カリブ海地域',
  'Central America': '中央アメリカ',
  'Central Asia': '中央アジア',
  'East Africa': '東アフリカ',
  'East Asia': '東アジア',
  Europe: 'ヨーロッパ',
  'Middle East': '中東',
  'North Africa': '北アフリカ',
  'North America': '北米',
  Oceania: 'オセアニア',
  'South America': '南米',
  'South Caucasus': '南コーカサス',
  'Southeast Asia': '東南アジア',
  'Southern Africa': '南部アフリカ',
  'Southern Europe': '南ヨーロッパ',
  'West Africa': '西アフリカ',
  'West Asia': '西アジア',
};

function humanize(value: string): string {
  return value
    .split('-')
    .map((part) => part ? `${part[0].toUpperCase()}${part.slice(1)}` : part)
    .join(' ');
}

function racingTypeLabel(value: string): string {
  return isJapanese ? racingTypeLabelsJa[value] ?? humanize(value) : humanize(value);
}

function regionLabel(value: string): string {
  if (!isJapanese) return value;
  return value
    .split(' / ')
    .map((part) => regionLabelsJa[part] ?? part)
    .join(' / ');
}
---

<BaseLayout
  title={isJapanese ? '国・地域から探す | 競馬どこ？' : 'Countries and Regions | Where Horses Run'}
  description={isJapanese
    ? '現在カレンダー対応中の競馬開催国・地域から、開催日程と競馬場を探せます。'
    : 'Browse countries and regions currently supported by the Calendar, then open meetings and racecourses.'}
  lang={locale}
  canonicalPath={directoryPath}
  alternatePath={isJapanese ? '/countries/' : '/ja/countries/'}
>
  <div class="countries-index" data-country-directory data-country-records={records.length}>
    <header class="countries-index__hero" aria-labelledby="page-title">
      <p class="countries-index__eyebrow">{isJapanese ? 'カレンダー対応国' : 'Calendar-supported countries'}</p>
      <div class="countries-index__title-row">
        <div>
          <h1 id="page-title">{isJapanese ? '国・地域から探す' : 'Countries and Regions'}</h1>
          <p>{isJapanese
            ? '対応済みの国・地域を入口として、開催日程と競馬場へ進むための索引です。'
            : 'A compact index for moving from supported countries and regions to meetings and racecourses.'}</p>
        </div>
        <strong>{isJapanese ? `${records.length}か国・地域` : `${records.length} supported`}</strong>
      </div>
    </header>

    <section class="countries-index__shortcuts" aria-label={isJapanese ? '主要導線' : 'Primary shortcuts'}>
      <a href={calendarPath}>{isJapanese ? '開催日程を見る' : 'Open Calendar'} <span aria-hidden="true">→</span></a>
      <a href={tracksPath}>{isJapanese ? '競馬場から探す' : 'Browse Racecourses'} <span aria-hidden="true">→</span></a>
    </section>

    <section class="countries-index__section" aria-labelledby="supported-countries-heading">
      <div class="countries-index__section-heading">
        <h2 id="supported-countries-heading">{isJapanese ? '対応中の国・地域' : 'Supported countries and regions'}</h2>
        <p>{isJapanese
          ? 'カレンダー対応が確認できている国・地域だけを掲載しています。'
          : 'Only countries and regions with reviewed Calendar support are shown here.'}</p>
      </div>

      <div class="countries-index__list">
        {records.map((record) => {
          const typeLabels = record.racingTypes.map(racingTypeLabel);
          const secondaryName = record.alternateName && record.alternateName !== record.name
            ? record.alternateName
            : record.localName && record.localName !== record.name
              ? record.localName
              : '';
          return (
            <article class="countries-index__row" data-country-record data-country-id={record.id}>
              <div class="countries-index__identity">
                <h3><a href={record.href}>{record.name}</a></h3>
                {secondaryName && <span>{secondaryName}</span>}
              </div>

              <div class="countries-index__meta">
                <span>{regionLabel(record.region)}</span>
                {typeLabels.length > 0 && <span>{typeLabels.join(' · ')}</span>}
              </div>

              <nav class="countries-index__actions" aria-label={isJapanese ? `${record.name}のリンク` : `${record.name} links`}>
                <a href={`${calendarPath}?country=${encodeURIComponent(record.id)}`}>{isJapanese ? '日程' : 'Calendar'}</a>
                <a href={`${tracksPath}?country=${encodeURIComponent(record.id)}`}>{isJapanese ? '競馬場' : 'Racecourses'}</a>
              </nav>
            </article>
          );
        })}
      </div>
    </section>
  </div>

  <style>
    .countries-index {
      width: min(1080px, 100%);
      margin-inline: auto;
      padding-block: .5rem 3rem;
    }

    .countries-index__hero {
      padding: .35rem 0 1.2rem;
      border-bottom: 1px solid var(--whr-color-border);
    }

    .countries-index__eyebrow {
      margin: 0 0 .35rem;
      color: var(--whr-color-muted);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .countries-index__title-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .countries-index__title-row h1 {
      margin: 0;
      color: var(--whr-color-navy);
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.04;
    }

    .countries-index__title-row p {
      max-width: 44rem;
      margin: .55rem 0 0;
      color: var(--whr-color-muted);
      line-height: 1.55;
    }

    .countries-index__title-row > strong {
      flex: 0 0 auto;
      padding-bottom: .2rem;
      color: var(--whr-color-muted);
      font-size: .85rem;
    }

    .countries-index__shortcuts {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      padding: .9rem 0;
      border-bottom: 1px solid var(--whr-color-border);
    }

    .countries-index__shortcuts a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: .5rem .7rem;
      border: 1px solid var(--whr-color-border);
      border-radius: .45rem;
      color: var(--whr-color-navy);
      font-size: .84rem;
      font-weight: 800;
      text-decoration: none;
    }

    .countries-index__shortcuts a:hover,
    .countries-index__shortcuts a:focus-visible,
    .countries-index__identity a:hover,
    .countries-index__identity a:focus-visible,
    .countries-index__actions a:hover,
    .countries-index__actions a:focus-visible {
      text-decoration: underline;
      text-underline-offset: .2em;
    }

    .countries-index__section {
      padding-top: 1.25rem;
    }

    .countries-index__section-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: .65rem;
    }

    .countries-index__section-heading h2,
    .countries-index__section-heading p {
      margin: 0;
    }

    .countries-index__section-heading h2 {
      color: var(--whr-color-navy);
      font-size: 1.2rem;
    }

    .countries-index__section-heading p {
      color: var(--whr-color-muted);
      font-size: .8rem;
    }

    .countries-index__list {
      border-top: 2px solid var(--whr-color-text);
    }

    .countries-index__row {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) minmax(260px, 1.25fr) auto;
      align-items: center;
      gap: 1rem;
      min-width: 0;
      padding: .9rem .15rem;
      border-bottom: 1px solid var(--whr-color-border);
    }

    .countries-index__identity,
    .countries-index__meta {
      min-width: 0;
    }

    .countries-index__identity h3 {
      margin: 0;
      font-size: 1rem;
    }

    .countries-index__identity h3 a {
      color: var(--whr-color-navy);
      font-weight: 800;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .countries-index__identity > span {
      display: block;
      margin-top: .18rem;
      color: var(--whr-color-muted);
      font-size: .75rem;
      overflow-wrap: anywhere;
    }

    .countries-index__meta {
      display: flex;
      flex-wrap: wrap;
      gap: .25rem .7rem;
      color: var(--whr-color-muted);
      font-size: .8rem;
      line-height: 1.4;
    }

    .countries-index__meta span + span::before {
      content: '·';
      margin-right: .7rem;
    }

    .countries-index__actions {
      display: flex;
      gap: .35rem;
      justify-content: flex-end;
    }

    .countries-index__actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 36px;
      padding: .4rem .55rem;
      border: 1px solid var(--whr-color-border);
      border-radius: .4rem;
      color: var(--whr-color-navy);
      font-size: .75rem;
      font-weight: 800;
      text-decoration: none;
      white-space: nowrap;
    }

    @media (max-width: 760px) {
      .countries-index {
        padding-block: .1rem 4.5rem;
      }

      .countries-index__title-row {
        display: block;
      }

      .countries-index__title-row h1 {
        font-size: clamp(1.8rem, 8vw, 2.4rem);
      }

      .countries-index__title-row p {
        margin-top: .4rem;
        font-size: .88rem;
      }

      .countries-index__title-row > strong {
        display: block;
        margin-top: .45rem;
        padding: 0;
        font-size: .78rem;
      }

      .countries-index__section-heading {
        display: block;
      }

      .countries-index__section-heading p {
        margin-top: .3rem;
      }

      .countries-index__row {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: .55rem .8rem;
        padding: .8rem .05rem;
      }

      .countries-index__identity {
        grid-column: 1;
      }

      .countries-index__meta {
        grid-column: 1 / -1;
        grid-row: 2;
        font-size: .76rem;
      }

      .countries-index__actions {
        grid-column: 2;
        grid-row: 1;
      }
    }

    @media (max-width: 460px) {
      .countries-index__shortcuts {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .countries-index__shortcuts a {
        justify-content: center;
        text-align: center;
      }

      .countries-index__row {
        grid-template-columns: 1fr;
      }

      .countries-index__identity,
      .countries-index__actions,
      .countries-index__meta {
        grid-column: 1;
      }

      .countries-index__identity {
        grid-row: 1;
      }

      .countries-index__meta {
        grid-row: 2;
      }

      .countries-index__actions {
        grid-row: 3;
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>