---
type Props = {
  sourceDate: string;
  sourceTimeZone: string;
  lang?: 'en' | 'ja';
};

const { sourceDate, sourceTimeZone, lang = 'en' } = Astro.props as Props;
const isJa = lang === 'ja';
const label = isJa ? '表示タイムゾーン' : 'Display timezone';
---

<div
  class="meeting-timezone-control"
  data-meeting-timezone-root
  data-source-date={sourceDate}
  data-source-timezone={sourceTimeZone}
  data-lang={lang}
>
  <label>
    <span>{label}</span>
    <select data-meeting-timezone-select aria-label={label}>
      <option value="Asia/Tokyo">Asia/Tokyo</option>
      <option value="UTC">UTC</option>
    </select>
  </label>
  <output data-meeting-timezone-status>Asia/Tokyo</output>
</div>

<script>
  const isTimeZoneSupported = (timeZone) => {
    if (!timeZone) return false;
    try { new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0)); return true; } catch { return false; }
  };
  const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
    timeZone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
  }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
  const localDateTimeToInstant = (dateText, timeText, timeZone) => {
    const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
    const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
    if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
    const targetUtc = Date.UTC(Number(dateMatch[1]), Number(dateMatch[2]) - 1, Number(dateMatch[3]), Number(timeMatch[1]), Number(timeMatch[2]), Number(timeMatch[3] ?? '0'));
    let guess = targetUtc;
    for (let pass = 0; pass < 4; pass += 1) {
      const parts = dateParts(new Date(guess), timeZone);
      const representedUtc = Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second));
      const correction = targetUtc - representedUtc;
      guess += correction;
      if (correction === 0) break;
    }
    return new Date(guess);
  };
  const formatDate = (instant, timeZone) => {
    const parts = dateParts(instant, timeZone);
    return `${parts.year}-${parts.month}-${parts.day}`;
  };
  const formatTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', {
    timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
  }).format(instant);
  const populateTimeZones = (select) => {
    const zones = typeof Intl.supportedValuesOf === 'function'
      ? Intl.supportedValuesOf('timeZone')
      : ['UTC', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Dubai', 'Europe/Istanbul', 'Europe/London', 'America/New_York', 'Australia/Sydney'];
    const values = Array.from(new Set(['UTC', ...zones]));
    select.replaceChildren(...values.map((zone) => {
      const option = document.createElement('option');
      option.value = zone;
      option.textContent = zone;
      return option;
    }));
  };
  const projectMeeting = (root, timeZone) => {
    if (!(root instanceof HTMLElement)) return;
    const sourceDate = root.dataset.sourceDate || '';
    const sourceTimeZone = root.dataset.sourceTimezone || '';
    const timeCells = Array.from(document.querySelectorAll('[data-meeting-source-time]'));
    let previousInstant = null;
    let firstProjectedDate = sourceDate;
    timeCells.forEach((cell, index) => {
      if (!(cell instanceof HTMLElement)) return;
      const sourceTime = cell.dataset.meetingSourceTime || '';
      let instant = localDateTimeToInstant(sourceDate, sourceTime, sourceTimeZone);
      if (!instant) return;
      if (previousInstant && instant.getTime() < previousInstant.getTime()) {
        instant = new Date(instant.getTime() + 86_400_000);
      }
      previousInstant = instant;
      const projectedDate = formatDate(instant, timeZone);
      const projectedTime = formatTime(instant, timeZone);
      if (index === 0) firstProjectedDate = projectedDate;
      cell.textContent = `${projectedDate} ${projectedTime}`;
      cell.setAttribute('datetime', instant.toISOString());
      cell.setAttribute('title', `${sourceDate} ${sourceTime} ${sourceTimeZone}`);
    });
    document.querySelectorAll('[data-meeting-projected-date]').forEach((node) => {
      node.textContent = firstProjectedDate;
    });
    document.querySelectorAll('[data-timezone-label]').forEach((node) => {
      node.textContent = timeZone;
    });
    const status = root.querySelector('[data-meeting-timezone-status]');
    if (status) status.textContent = timeZone;
    window.dispatchEvent(new CustomEvent('whr:timezonechange', { detail: {
      timeZone,
      targetDate: firstProjectedDate,
      scope: 'meeting-detail',
    } }));
  };
  document.querySelectorAll('[data-meeting-timezone-root]').forEach((root) => {
    const select = root.querySelector('[data-meeting-timezone-select]');
    if (!(select instanceof HTMLSelectElement)) return;
    populateTimeZones(select);
    const requested = new URL(window.location.href).searchParams.get('tz');
    const browser = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const initial = isTimeZoneSupported(requested) ? requested : isTimeZoneSupported(browser) ? browser : 'Asia/Tokyo';
    select.value = initial;
    const initialUrl = new URL(window.location.href);
    if (initialUrl.searchParams.get('tz') !== initial) {
      initialUrl.searchParams.set('tz', initial);
      window.history.replaceState({}, '', `${initialUrl.pathname}${initialUrl.search}${initialUrl.hash}`);
    }
    projectMeeting(root, initial);
    select.addEventListener('change', () => {
      const selected = isTimeZoneSupported(select.value) ? select.value : 'Asia/Tokyo';
      const url = new URL(window.location.href);
      url.searchParams.set('tz', selected);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      projectMeeting(root, selected);
    });
  });
</script>

<style>
  .meeting-timezone-control {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    margin-block: 1rem;
  }

  .meeting-timezone-control label {
    display: grid;
    font-size: 0.82rem;
    gap: 0.2rem;
  }

  .meeting-timezone-control select {
    max-width: min(24rem, 80vw);
    padding: 0.38rem 0.5rem;
  }

  .meeting-timezone-control output {
    font-size: 0.82rem;
    opacity: 0.72;
  }
</style>
