---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const isJa = locale === 'ja';

const content = isJa
  ? {
      title: '情報の扱い | 競馬どこ？',
      description: '競馬どこ？が公式情報をどのように確認し、日付・時刻・訂正・掲載範囲を扱うかを説明します。',
      eyebrow: '情報の扱い',
      heading: '情報の扱い',
      summary: '掲載情報の確認方法、時刻の扱い、訂正方針、掲載しない情報を説明します。',
      sections: [
        {
          heading: '公式情報を優先します',
          paragraphs: [
            '開催日、競馬場、発走時刻、主催者、ライブ配信など現在性が重要な情報は、主催者・規制機関・競馬場などの公式情報を優先します。',
            'このサイトの表示と公式情報が異なる場合は、公式情報を最新の確認先として使用してください。',
          ],
        },
        {
          heading: '掲載できる範囲だけを表示します',
          paragraphs: [
            '国・地域や開催によって、公式に確認できる情報の詳しさは異なります。開催日だけを掲載する場合もあれば、発走時刻やレース概要まで確認できる場合もあります。',
            '確認できない項目を推測で補いません。必要な情報がない場合は、公式情報源へのリンクから確認してください。',
          ],
        },
        {
          heading: '日付・時刻・タイムゾーン',
          paragraphs: [
            '開催日と発走時刻は、公式情報が示す開催地の日時をもとに扱います。ページで表示タイムゾーンを選べる場合は、その選択に合わせて表示します。',
            '夏時間、時刻変更、延期、中止などで情報が変わる場合があります。観戦や移動の前には公式情報を再確認してください。',
          ],
        },
        {
          heading: '更新と訂正',
          paragraphs: [
            '公式情報の更新や変更を確認した場合は、掲載内容を更新します。誤りや根拠不足が判明した場合は、訂正、簡略化、または削除します。',
            '異なる情報が食い違う場合は、現在の事実に最も近い公式情報を優先し、解消できない内容を推測で統合しません。',
          ],
        },
        {
          heading: '掲載しない情報',
          paragraphs: [
            '出走表、馬名、騎手名、調教師名、枠順、斤量、オッズ、結果、払戻、予想、買い目などは原則として掲載しません。必要な場合は公式サービスを利用してください。',
            '非公式ミラー、転載映像、アクセス制限を回避するための導線は扱いません。公式ライブやリプレイへの導線を案内する場合は、提供元の利用条件に従ってください。',
          ],
        },
      ],
      relatedHeading: '関連ページ',
      relatedText: 'サイトの概要、よくある質問、免責事項、公式情報源も確認できます。',
      relatedLinks: [
        { href: '/ja/about/', label: 'このサイトについて' },
        { href: '/ja/faq/', label: 'よくある質問' },
        { href: '/ja/disclaimer/', label: '免責事項' },
        { href: '/ja/sources/', label: '公式情報源' },
      ],
    }
  : {
      title: 'Information Policy | Where Horses Run',
      description: 'How Where Horses Run handles official information, dates, times, corrections, and the information it does not publish.',
      eyebrow: 'Information policy',
      heading: 'Information Policy',
      summary: 'How information is checked, how times are presented, how corrections are handled, and what the site leaves to official services.',
      sections: [
        {
          heading: 'Official information comes first',
          paragraphs: [
            'For current facts such as meeting dates, racecourses, post times, organizers, and live viewing, the site prioritizes information from organizers, regulators, racecourses, and other official providers.',
            'If this site differs from an official source, use the official source as the latest reference.',
          ],
        },
        {
          heading: 'Only available detail is shown',
          paragraphs: [
            'The amount of detail available differs by country, racecourse, and meeting. Some listings may contain only a date and racecourse, while others can include post times or lightweight race details.',
            'Missing information is not filled by guesswork. Use the linked official source when more detail is needed.',
          ],
        },
        {
          heading: 'Dates, times, and timezones',
          paragraphs: [
            'Meeting dates and post times are based on the date and time published for the venue. When the page supports a display-timezone selection, the presentation follows that selection.',
            'Daylight-saving changes, time changes, postponements, and cancellations can change the information. Confirm the official source before travel or viewing.',
          ],
        },
        {
          heading: 'Updates and corrections',
          paragraphs: [
            'Displayed information is updated when official information changes. If an error or insufficient support is found, the affected information may be corrected, simplified, or removed.',
            'When sources conflict, the official source closest to the current fact takes priority. Unresolved conflicts are not combined through speculation.',
          ],
        },
        {
          heading: 'Information left to official services',
          paragraphs: [
            'Entries, horse names, jockey and trainer names, draws, weights, odds, results, payouts, predictions, and betting picks are generally not published here. Use official services when you need them.',
            'The site does not provide unofficial mirrors, copied recordings, or routes intended to bypass access restrictions. When official live or replay access is listed, follow the provider’s access conditions.',
          ],
        },
      ],
      relatedHeading: 'Related pages',
      relatedText: 'You can also read the site overview, FAQ, disclaimer, and official-source directory.',
      relatedLinks: [
        { href: '/about/', label: 'About' },
        { href: '/faq/', label: 'FAQ' },
        { href: '/disclaimer/', label: 'Disclaimer' },
        { href: '/sources/', label: 'Official Sources' },
      ],
    };

const canonicalPath = isJa ? '/ja/methods/' : '/methods/';
const alternatePath = isJa ? '/methods/' : '/ja/methods/';
---

<BaseLayout
  title={content.title}
  description={content.description}
  lang={locale}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
>
  <section class="hero" aria-labelledby="page-title">
    <p class="hero__eyebrow">{content.eyebrow}</p>
    <h1 id="page-title">{content.heading}</h1>
    <p class="hero__summary">{content.summary}</p>
  </section>

  <section class="section-grid" aria-label={content.heading}>
    {content.sections.map((section) => (
      <article class="card">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    ))}
  </section>

  <section class="card" aria-labelledby="related-method-pages">
    <h2 id="related-method-pages">{content.relatedHeading}</h2>
    <p>{content.relatedText}</p>
    <p>
      {content.relatedLinks.map((link, index) => (
        <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>
      ))}
    </p>
  </section>
</BaseLayout>
