---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import StructuredDataBaseline from '../components/StructuredDataBaseline.astro';
import { siteData } from '../lib/data';
import { getPublicTimetableMeetingRowsByCountry } from '../lib/timetable/publicTimetableViewModel';
import { addCalendarDays, createCalendarDateContext } from '../lib/timetable/calendarDateContext.mjs';
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/mobile-navigation.css';
import '../styles/desktop-layout.css';
import '../styles/ux-polish.css';
import '../styles/v1-mobile-qa.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja';
  canonicalPath?: string;
  alternatePath?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath,
  alternatePath
} = Astro.props;

const isJapanese = lang === 'ja';
const homeHref = isJapanese ? '/ja/' : '/';
const canonicalPathname = canonicalPath ?? Astro.url.pathname;
const bilingualPathPatterns = [
  /^\/$/,
  /^\/ja\/$/,
  /^\/(?:ja\/)?(?:about|archive|calendar|countries|disclaimer|glossary|search|sources|today|tomorrow|tracks|types)(?:\/.*)?$/,
  /^\/(?:ja\/)?timetable\/meetings\/[^/]+\/$/,
  /^\/(?:ja\/)?major-countries\/current-timetable\/$/,
];
const hasBilingualCounterpart = bilingualPathPatterns.some((pattern) => pattern.test(canonicalPathname));
const inferredAlternateHref = isJapanese
  ? canonicalPathname.replace(/^\/ja(?=\/)/, '') || '/'
  : `/ja${canonicalPathname}`;
const explicitAlternateHref = alternatePath ?? null;
const metadataAlternateHref = explicitAlternateHref ?? (hasBilingualCounterpart ? inferredAlternateHref : null);
const defaultLanguageSwitchHref = hasBilingualCounterpart
  ? inferredAlternateHref
  : isJapanese ? '/' : '/ja/';
const languageSwitchHref = explicitAlternateHref ?? defaultLanguageSwitchHref;
const alternateLabel = isJapanese ? 'English' : '日本語';

const navigationItems = [
  { href: isJapanese ? '/ja/today/' : '/today/', label: isJapanese ? '今日' : 'Today' },
  { href: isJapanese ? '/ja/calendar/' : '/calendar/', label: isJapanese ? 'カレンダー' : 'Calendar' },
  { href: isJapanese ? '/ja/search/' : '/search/', label: isJapanese ? '検索' : 'Search' },
  { href: isJapanese ? '/ja/countries/' : '/countries/', label: isJapanese ? '国・地域' : 'Countries' },
  { href: isJapanese ? '/ja/tracks/' : '/tracks/', label: isJapanese ? '競馬場' : 'Racecourses' },
  { href: isJapanese ? '/ja/types/' : '/types/', label: isJapanese ? '競馬種別' : 'Racing Types' },
  { href: isJapanese ? '/ja/glossary/' : '/glossary/', label: isJapanese ? '用語集' : 'Glossary' },
  { href: isJapanese ? '/ja/sources/' : '/sources/', label: isJapanese ? '公式情報源' : 'Sources' },
];
const isCurrentNavigationItem = (href: string) =>
  canonicalPathname === href || canonicalPathname.startsWith(href);

const countryPathMatch = /^\/(?:ja\/)?countries\/([^/]+)\/$/.exec(canonicalPathname);
const countrySlug = countryPathMatch?.[1] ?? null;
const countryId = countrySlug
  ? siteData.countries.find((country) => country.slug === countrySlug)?.id ?? null
  : null;
const countryDateContext = createCalendarDateContext();
const countryCandidateStart = addCalendarDays(countryDateContext.windowStart, -2);
const countryCandidateEndExclusive = addCalendarDays(countryDateContext.windowEndExclusive, 2);
const countryTimezoneCandidates = countryId
  ? getPublicTimetableMeetingRowsByCountry(countryId).filter(
      (meeting) => meeting.date >= countryCandidateStart && meeting.date < countryCandidateEndExclusive,
    )
  : [];
const countryTimezoneCandidatesJson = JSON.stringify(countryTimezoneCandidates).replace(/</g, '\\u003c');

const siteUrl = 'https://whr.badjoke-lab.com';
const canonicalUrl = `${siteUrl}${canonicalPathname}`;
const alternateUrl = metadataAlternateHref ? `${siteUrl}${metadataAlternateHref}` : null;
const xDefaultUrl = metadataAlternateHref
  ? `${siteUrl}${isJapanese ? metadataAlternateHref : canonicalPathname}`
  : null;
const ogLocale = isJapanese ? 'ja_JP' : 'en_US';
const alternateOgLocale = isJapanese ? 'en_US' : 'ja_JP';
const socialImageUrl = `${siteUrl}/social/whr-social-card-v1.png`;
const socialImageAlt = isJapanese
  ? '競馬どこ？ のソーシャルカード。競馬場の楕円コースを図案化した画像。'
  : 'Where Horses Run social card with a stylized racecourse oval.';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <GoogleAnalytics />

    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && xDefaultUrl && (
      <>
        <link rel="alternate" hreflang={isJapanese ? 'en' : 'ja'} href={alternateUrl} />
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Where Horses Run" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternateUrl && <meta property="og:locale:alternate" content={alternateOgLocale} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <StructuredDataBaseline
      title={title}
      description={description}
      lang={lang}
      canonicalUrl={canonicalUrl}
      siteUrl={siteUrl}
    />

    <noscript>
      <style data-no-js-fallback-style>
        [data-search-form],
        [data-country-filter-form],
        [data-racecourse-filter-form],
        [data-source-filter-form],
        [data-glossary-filter-form],
        [data-search-count],
        [data-country-filter-count],
        [data-racecourse-filter-count],
        [data-source-filter-count],
        [data-glossary-filter-count],
        [data-region-filter-navigation],
        [data-glossary-category-navigation] {
          display: none !important;
        }
      </style>
    </noscript>

    <title>{title}</title>
  </head>
  <body
    data-no-js-fallback="complete-list-v1"
    data-ux-polish-release="WHR-UX-DISCOVERY-V1"
    data-ux-polish-phase="10"
  >
    <a class="skip-link" href="#main-content">
      {isJapanese ? '本文へ移動' : 'Skip to content'}
    </a>

    <div class="site-shell">
      <header
        class="site-header"
        aria-label={isJapanese ? 'サイトヘッダー' : 'Site header'}
        data-mobile-navigation="details-summary-v1"
        data-mobile-navigation-links="9"
        data-desktop-layout="responsive-shell-v1"
      >
        <div class="site-header__inner">
          <a class="site-brand" href={homeHref}>{isJapanese ? '競馬どこ？' : 'Where Horses Run'}</a>

          <details class="site-navigation">
            <summary class="site-navigation__summary">
              <span>{isJapanese ? 'メニュー' : 'Menu'}</span>
            </summary>
            <nav class="site-nav" aria-label={isJapanese ? 'モバイル主要ナビゲーション' : 'Mobile main navigation'}>
              <ul class="site-nav__list">
                {navigationItems.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))}
                <li class="site-nav__language">
                  <a href={languageSwitchHref} hreflang={isJapanese ? 'en' : 'ja'}>{alternateLabel}</a>
                </li>
              </ul>
            </nav>
          </details>

          <nav class="desktop-site-nav" aria-label={isJapanese ? '主要ナビゲーション' : 'Main navigation'}>
            <ul class="site-nav__list">
              {navigationItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
              <li class="site-nav__language">
                <a href={languageSwitchHref} hreflang={isJapanese ? 'en' : 'ja'}>{alternateLabel}</a>
              </li>
            </ul>
          </nav>
        </div>
      </header>

      <main id="main-content" class="main-content" data-desktop-content="responsive-grid-v1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>{isJapanese ? '競馬の開催情報、競馬場、競馬種別、公式情報を探せます。' : 'Find racing calendars, meetings, racecourses, racing types, and official sources.'}</p>
        </div>
      </footer>
    </div>

    {countryId && (
      <script
        type="application/json"
        data-country-timezone-candidates
        data-country-id={countryId}
        set:html={countryTimezoneCandidatesJson}
      ></script>
    )}

    <script is:inline>
      (() => {
        const isTimeZoneSupported = (timeZone) => {
          if (!timeZone) return false;
          try {
            new Intl.DateTimeFormat('en', { timeZone }).format(new Date(0));
            return true;
          } catch {
            return false;
          }
        };
        const dateParts = (instant, timeZone) => Object.fromEntries(new Intl.DateTimeFormat('en-US', {
          timeZone,
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hourCycle: 'h23',
        }).formatToParts(instant).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
        const localDateTimeToInstant = (dateText, timeText, timeZone) => {
          const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateText || '');
          const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(timeText || '');
          if (!dateMatch || !timeMatch || !isTimeZoneSupported(timeZone)) return null;
          const targetUtc = Date.UTC(
            Number(dateMatch[1]),
            Number(dateMatch[2]) - 1,
            Number(dateMatch[3]),
            Number(timeMatch[1]),
            Number(timeMatch[2]),
            Number(timeMatch[3] ?? '0'),
          );
          let guess = targetUtc;
          for (let pass = 0; pass < 4; pass += 1) {
            const parts = dateParts(new Date(guess), timeZone);
            const representedUtc = Date.UTC(
              Number(parts.year),
              Number(parts.month) - 1,
              Number(parts.day),
              Number(parts.hour),
              Number(parts.minute),
              Number(parts.second),
            );
            const correction = targetUtc - representedUtc;
            guess += correction;
            if (correction === 0) break;
          }
          return new Date(guess);
        };
        const formatProjectedDate = (instant, timeZone) => {
          const parts = dateParts(instant, timeZone);
          return `${parts.year}-${parts.month}-${parts.day}`;
        };
        const formatProjectedTime = (instant, timeZone) => new Intl.DateTimeFormat('en-GB', {
          timeZone,
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
        }).format(instant);
        const addDateDays = (dateText, days) => {
          const date = new Date(`${dateText}T00:00:00.000Z`);
          date.setUTCDate(date.getUTCDate() + days);
          return date.toISOString().slice(0, 10);
        };
        const propagateTimeZone = (timeZone) => {
          if (!isTimeZoneSupported(timeZone)) return;
          document.querySelectorAll('a[href]').forEach((anchor) => {
            if (!(anchor instanceof HTMLAnchorElement)) return;
            const rawHref = anchor.getAttribute('href');
            if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:') || rawHref.startsWith('tel:')) return;
            const url = new URL(rawHref, window.location.href);
            if (url.origin !== window.location.origin) return;
            url.searchParams.set('tz', timeZone);
            anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
          });
          document.querySelectorAll('[data-timezone-label]').forEach((node) => {
            node.textContent = timeZone;
          });
        };
        const applyProjectionMetadata = (detail) => {
          if (!detail || typeof detail !== 'object') return;
          if (typeof detail.timeZone === 'string') propagateTimeZone(detail.timeZone);
          if (typeof detail.targetDate === 'string') {
            document.querySelectorAll('[data-timezone-target-date]').forEach((node) => { node.textContent = detail.targetDate; });
          }
          if (typeof detail.windowStart === 'string') {
            document.querySelectorAll('[data-timezone-window-start]').forEach((node) => { node.textContent = detail.windowStart; });
          }
          if (typeof detail.windowEndInclusive === 'string') {
            document.querySelectorAll('[data-timezone-window-end]').forEach((node) => { node.textContent = detail.windowEndInclusive; });
          }
        };
        const populateTimeZones = (select) => {
          const zones = typeof Intl.supportedValuesOf === 'function'
            ? Intl.supportedValuesOf('timeZone')
            : ['UTC', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Seoul', 'Asia/Dubai', 'Europe/Istanbul', 'Europe/London', 'America/New_York', 'Australia/Sydney'];
          const values = Array.from(new Set(['UTC', ...zones]));
          select.replaceChildren(...values.map((zone) => {
            const option = document.createElement('option');
            option.value = zone;
            option.textContent = zone;
            return option;
          }));
        };
        const localizedRacecourseMap = () => {
          const names = new Map();
          document.querySelectorAll('.country-table--racecourses a[href]').forEach((anchor) => {
            if (!(anchor instanceof HTMLAnchorElement)) return;
            const match = /\/tracks\/([^/]+)\/?$/.exec(new URL(anchor.href).pathname);
            if (match) names.set(match[1], anchor.textContent?.trim() || match[1]);
          });
          return names;
        };
        const authorityLabel = (record, isJa) => {
          if (record.authority_id === 'jra') return 'JRA';
          if (record.authority_id === 'nar-local-government-racing') return isJa ? '地方競馬' : 'Local racing';
          if (record.authority_id === 'banei-tokachi') return isJa ? 'ばんえい' : 'Banei';
          if (record.authority_id === 'hkjc') return 'HKJC';
          if (record.authority_id === 'korea-racing-authority') return 'KRA';
          if (record.authority_id === 'emirates-racing-authority') return 'ERA';
          if (record.authority_id === 'turkiye-jokey-kulubu') return 'TJK';
          return record.authority_label || record.authority_id || (isJa ? '未掲載' : 'Not listed');
        };
        const projectCountryRecord = (record, timeZone) => {
          const instant = record.first_race_time_local
            ? localDateTimeToInstant(record.date, record.first_race_time_local, record.timezone)
            : null;
          return {
            record,
            instant,
            projectedDate: instant ? formatProjectedDate(instant, timeZone) : record.date,
            projectedTime: instant ? formatProjectedTime(instant, timeZone) : null,
          };
        };
        const createCountryTable = (records, timeZone, isJa, showDetails, racecourseNames) => {
          const wrap = document.createElement('div');
          wrap.className = 'country-table-wrap';
          wrap.dataset.countryTimezoneGenerated = 'true';
          const table = document.createElement('table');
          table.className = 'country-table';
          const thead = document.createElement('thead');
          const headRow = document.createElement('tr');
          const headers = showDetails
            ? (isJa ? ['日付', '競馬場', '体系', '開始時刻', 'タイムゾーン', '公式'] : ['Date', 'Racecourse', 'System', 'Start time', 'Timezone', 'Official'])
            : (isJa ? ['日付', '競馬場'] : ['Date', 'Racecourse']);
          headers.forEach((label) => {
            const th = document.createElement('th');
            th.scope = 'col';
            th.textContent = label;
            headRow.append(th);
          });
          thead.append(headRow);
          table.append(thead);
          const tbody = document.createElement('tbody');
          records.forEach(({ record, projectedDate, projectedTime }) => {
            const row = document.createElement('tr');
            row.dataset.countryTimezoneMeetingRow = 'true';
            row.dataset.meetingId = record.meeting_id || '';
            const values = [
              projectedDate,
              racecourseNames.get(record.racecourse_id) || record.racecourse_name || record.racecourse_id || (isJa ? '競馬場未確定' : 'Racecourse pending'),
            ];
            if (showDetails) {
              values.push(
                authorityLabel(record, isJa),
                projectedTime || (isJa ? '未確認' : 'Not verified'),
                projectedTime ? timeZone : (record.timezone || (isJa ? '現地時刻を確認' : 'Check local time')),
              );
            }
            values.forEach((value, index) => {
              const td = document.createElement('td');
              td.dataset.label = headers[index] || '';
              td.textContent = value;
              if (projectedTime && index === 3) {
                td.title = `${record.date} ${record.first_race_time_local} ${record.timezone}`;
              }
              row.append(td);
            });
            if (showDetails) {
              const td = document.createElement('td');
              td.dataset.label = headers[5];
              if (record.official_source_url) {
                const link = document.createElement('a');
                link.href = record.official_source_url;
                link.textContent = isJa ? '開く' : 'Open';
                td.append(link);
              } else {
                td.textContent = isJa ? '未掲載' : 'Not listed';
              }
              row.append(td);
            }
            tbody.append(row);
          });
          table.append(tbody);
          wrap.append(table);
          return wrap;
        };
        const initializeCountryTimezoneProjection = () => {
          const dataNode = document.querySelector('[data-country-timezone-candidates]');
          const section = document.querySelector('#upcoming-meetings');
          if (!(dataNode instanceof HTMLScriptElement) || !(section instanceof HTMLElement)) return;
          let candidates = [];
          try {
            candidates = JSON.parse(dataNode.textContent || '[]');
          } catch {
            return;
          }
          const isJa = document.documentElement.lang === 'ja';
          const racecourseNames = localizedRacecourseMap();
          const control = document.createElement('div');
          control.className = 'timezone-control';
          control.dataset.countryTimezoneControl = 'true';
          const label = document.createElement('label');
          const labelText = document.createElement('span');
          labelText.textContent = isJa ? '表示タイムゾーン' : 'Display timezone';
          const select = document.createElement('select');
          select.dataset.countryTimezoneSelect = 'true';
          select.setAttribute('aria-label', labelText.textContent);
          populateTimeZones(select);
          label.append(labelText, select);
          const output = document.createElement('output');
          output.dataset.countryTimezoneStatus = 'true';
          control.append(label, output);
          const intro = section.querySelector('.country-section__intro');
          intro?.insertAdjacentElement('afterend', control);
          const requested = new URL(window.location.href).searchParams.get('tz');
          const browser = Intl.DateTimeFormat().resolvedOptions().timeZone;
          const initial = isTimeZoneSupported(requested)
            ? requested
            : isTimeZoneSupported(browser) ? browser : 'Asia/Tokyo';
          const apply = (timeZone, updateHistory) => {
            const today = formatProjectedDate(new Date(), timeZone);
            const endExclusive = addDateDays(today, 30);
            const projected = candidates
              .map((record) => projectCountryRecord(record, timeZone))
              .filter((item) => item.projectedDate >= today && item.projectedDate < endExclusive)
              .sort((left, right) =>
                left.projectedDate.localeCompare(right.projectedDate)
                || (left.projectedTime || '99:99').localeCompare(right.projectedTime || '99:99')
                || String(left.record.meeting_id || '').localeCompare(String(right.record.meeting_id || '')),
              );
            section.querySelectorAll('[data-country-timezone-generated], .country-table-wrap, details.country-more, .card.country-card').forEach((node) => {
              if (node === control || node.contains(control)) return;
              node.remove();
            });
            const showDetails = projected.some(({ record }) => ['A+', 'A', 'B+', 'B'].includes(record.effective_public_rank || record.capability_rank));
            if (!projected.length) {
              const empty = document.createElement('div');
              empty.className = 'card country-card';
              empty.dataset.countryTimezoneGenerated = 'true';
              const p = document.createElement('p');
              p.textContent = isJa
                ? '選択した表示タイムゾーンの30日間に、確認済み公開開催はありません。最新日程は公式ソースで確認してください。'
                : 'No reviewed public meeting is listed in the selected 30-day display window. Use official sources for the latest schedule.';
              empty.append(p);
              section.append(empty);
            } else {
              section.append(createCountryTable(projected.slice(0, 8), timeZone, isJa, showDetails, racecourseNames));
              if (projected.length > 8) {
                const details = document.createElement('details');
                details.className = 'country-more';
                details.dataset.countryTimezoneGenerated = 'true';
                const summary = document.createElement('summary');
                const count = projected.length - 8;
                summary.textContent = isJa ? `さらに${count}件を表示` : `Show ${count} more meetings`;
                details.append(summary, createCountryTable(projected.slice(8), timeZone, isJa, showDetails, racecourseNames));
                section.append(details);
              }
            }
            select.value = timeZone;
            output.textContent = timeZone;
            if (updateHistory) {
              const url = new URL(window.location.href);
              url.searchParams.set('tz', timeZone);
              window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
            }
            window.dispatchEvent(new CustomEvent('whr:timezonechange', {
              detail: {
                timeZone,
                windowStart: today,
                windowEndInclusive: addDateDays(endExclusive, -1),
                scope: 'country',
              },
            }));
          };
          apply(initial, new URL(window.location.href).searchParams.get('tz') !== initial);
          select.addEventListener('change', () => {
            const selected = isTimeZoneSupported(select.value) ? select.value : 'Asia/Tokyo';
            apply(selected, true);
          });
        };
        const requested = new URL(window.location.href).searchParams.get('tz');
        if (isTimeZoneSupported(requested)) propagateTimeZone(requested);
        window.addEventListener('whr:timezonechange', (event) => {
          applyProjectionMetadata(event.detail);
        });
        initializeCountryTimezoneProjection();
      })();
    </script>
  </body>
</html>